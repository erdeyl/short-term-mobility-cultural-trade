*==============================================================================
* A1.3 (a) basis shares of directional observations
*==============================================================================
tempname BS
postfile `BS' str30 scope str5 measure str12 basis double(n share) using "${OUT}/tables/A1_A1.3_basis_shares.dta", replace
foreach m in vis tour {
    foreach scope in panel_stored s_base_pooled s_base_rev s_base_same {
        if "`scope'" == "panel_stored" local vars "basis_rev_`m'"
        if "`scope'" == "s_base_pooled" local vars "basis_rev_`m' basis_same_`m'"
        if "`scope'" == "s_base_rev" local vars "basis_rev_`m'"
        if "`scope'" == "s_base_same" local vars "basis_same_`m'"
        local cond = cond("`scope'" == "panel_stored", "has_rev_`m'", "s_base_`m'")
        local tot 0
        foreach b in residence nationality PRY_unknown {
            local n_`b' 0
            foreach v of local vars {
                quietly count if `cond' & `v' == "`b'"
                local n_`b' = `n_`b'' + r(N)
            }
            local tot = `tot' + `n_`b''
        }
        local n_other 0
        foreach v of local vars {
            quietly count if `cond' & !inlist(`v', "residence", "nationality", "PRY_unknown")
            local n_other = `n_other' + r(N)
        }
        assert `n_other' == 0
        foreach b in residence nationality PRY_unknown {
            post `BS' ("`scope'") ("`m'") ("`b'") (`n_`b'') (`n_`b'' / `tot')
        }
    }
}
postclose `BS'

*==============================================================================
* A1.3 (b)-(d) basis switches within series, mixed-basis pair-years, one-basis pairs
*==============================================================================
tempname SW
postfile `SW' str5 measure str90 statistic double(value denominator share) str90 note ///
    using "${OUT}/tables/A1_A1.3_switches.dta", replace
foreach m in vis tour {
    * directed series = (reporter iso3_o, origin iso3_d) with a stored value; flag = COPY source-table flag
    egen byte __tser = tag(iso3_o iso3_d) if has_rev_`m'
    quietly count if __tser == 1
    local nser = r(N)
    quietly count if __tser == 1 & basis_switch_rev_`m' == 1
    local nsw = r(N)
    quietly count if __tser == 1 & missing(basis_switch_rev_`m')
    local nmis = r(N)
    post `SW' ("`m'") ("directed series switching basis (COPY flag basis_switch_rev)") (`nsw') (`nser') (`nsw' / `nser') ("series flag missing (unknown): `nmis'")
    quietly count if has_rev_`m'
    local nobs = r(N)
    quietly count if has_rev_`m' & basis_switch_rev_`m' == 1
    post `SW' ("`m'") ("stored observations in a switching series (COPY flag)") (r(N)) (`nobs') (r(N) / `nobs') ("")
    * own recomputation on panel rows 2007-2021 (both bases appear among the series' stored rows)
    egen byte __hr = max(has_rev_`m' & basis_rev_`m' == "residence"), by(iso3_o iso3_d)
    egen byte __hn = max(has_rev_`m' & basis_rev_`m' == "nationality"), by(iso3_o iso3_d)
    quietly count if __tser == 1 & __hr == 1 & __hn == 1
    post `SW' ("`m'") ("directed series switching basis (recomputed on panel rows)") (r(N)) (`nser') (r(N) / `nser') ("residence and nationality both among the series' 2007-2021 panel rows")
    quietly count if has_rev_`m' & __hr == 1 & __hn == 1
    post `SW' ("`m'") ("stored observations in a switching series (recomputed)") (r(N)) (`nobs') (r(N) / `nobs') ("")
    drop __tser __hr __hn
    * bilateral observations with different bases in the two directions
    foreach smp in has_both s_base {
        local cond = cond("`smp'" == "has_both", "has_both_`m' & c_trade", "s_base_`m'")
        quietly count if `cond'
        local d = r(N)
        quietly count if `cond' & basis_rev_`m' != basis_same_`m'
        post `SW' ("`m'") ("`smp': pair-years with different bases in the two directions") (r(N)) (`d') (r(N) / `d') ("`cond'")
        quietly count if `cond' & (basis_switch_rev_`m' == 1 | basis_switch_same_`m' == 1)
        post `SW' ("`m'") ("`smp': pair-years where either direction's series switches basis") (r(N)) (`d') (r(N) / `d') ("COPY flags")
        quietly count if `cond' & (missing(basis_switch_rev_`m') | missing(basis_switch_same_`m'))
        post `SW' ("`m'") ("`smp': pair-years with a missing (unknown) switch flag") (r(N)) (`d') (r(N) / `d') ("")
    }
    * one-basis pairs in the baseline sample
    egen byte __tp = tag(pair_id) if s_base_`m'
    quietly count if __tp == 1
    local npair = r(N)
    egen byte __anysw = max(s_base_`m' & (basis_switch_rev_`m' != 0 | basis_switch_same_`m' != 0)), by(pair_id)
    quietly count if __tp == 1 & __anysw == 0
    post `SW' ("`m'") ("s_base directed pairs: neither direction's series switches (flags = 0)") (r(N)) (`npair') (r(N) / `npair') ("missing flag counts as switching")
    egen byte __hr = max(s_base_`m' & (basis_rev_`m' == "residence" | basis_same_`m' == "residence")), by(pair_id)
    egen byte __hn = max(s_base_`m' & (basis_rev_`m' == "nationality" | basis_same_`m' == "nationality")), by(pair_id)
    egen byte __hu = max(s_base_`m' & (basis_rev_`m' == "PRY_unknown" | basis_same_`m' == "PRY_unknown")), by(pair_id)
    quietly count if __tp == 1 & __hr + __hn + __hu == 1 & __hu == 0
    post `SW' ("`m'") ("s_base directed pairs: one basis in both directions in every sample year") (r(N)) (`npair') (r(N) / `npair') ("residence-only or nationality-only on all s_base rows of the pair")
    quietly count if __tp == 1 & __hr == 1 & __hn == 0 & __hu == 0
    post `SW' ("`m'") ("   of which residence only") (r(N)) (`npair') (r(N) / `npair') ("")
    quietly count if __tp == 1 & __hr == 0 & __hn == 1 & __hu == 0
    post `SW' ("`m'") ("   of which nationality only") (r(N)) (`npair') (r(N) / `npair') ("")
    quietly count if s_base_`m' & __hr + __hn + __hu == 1 & __hu == 0
    quietly count if s_base_`m'
    local nb = r(N)
    quietly count if s_base_`m' & __hr + __hn + __hu == 1 & __hu == 0
    post `SW' ("`m'") ("s_base observations in one-basis pairs") (r(N)) (`nb') (r(N) / `nb') ("")
    egen byte __tu = tag(unordered_pair_id) if s_base_`m' & __hr + __hn + __hu == 1 & __hu == 0
    quietly count if __tu == 1
    post `SW' ("`m'") ("s_base unordered pairs with at least one one-basis directed pair") (r(N)) (.) (.) ("")
    * all observed years 2007-2021 (audit check): basis history over every row of the pair
    egen byte __ar = max(basis_rev_`m' == "residence" | basis_same_`m' == "residence"), by(pair_id)
    egen byte __an = max(basis_rev_`m' == "nationality" | basis_same_`m' == "nationality"), by(pair_id)
    egen byte __au = max(basis_rev_`m' == "PRY_unknown" | basis_same_`m' == "PRY_unknown"), by(pair_id)
    quietly count if __tp == 1 & __ar + __an + __au == 1 & __au == 0
    post `SW' ("`m'") ("s_base directed pairs: one basis in both directions in all observed years 2007-2021") (r(N)) (`npair') (r(N) / `npair') ("all rows of the pair with a directional value (audit R1-01)")
    quietly count if s_base_`m' & __ar + __an + __au == 1 & __au == 0
    post `SW' ("`m'") ("s_base observations in all-year one-basis pairs") (r(N)) (`nb') (r(N) / `nb') ("")
    egen byte __tu2 = tag(unordered_pair_id) if s_base_`m' & __ar + __an + __au == 1 & __au == 0
    quietly count if __tu2 == 1
    post `SW' ("`m'") ("s_base unordered pairs with at least one all-year one-basis directed pair") (r(N)) (.) (.) ("")
    drop __tp __anysw __hr __hn __hu __tu __ar __an __au __tu2
}
postclose `SW'

*==============================================================================
* A1.3 (e) visitors < tourists on the same basis (hierarchy_violation), stored rows
*==============================================================================
tempname HV
postfile `HV' str24 scope str16 basis_match double(rows_both_observed hier_viol share) using "${OUT}/tables/A1_A1.3_hierarchy.dta", replace
gen byte __bothm = has_rev_vis & has_rev_tour
foreach scope in panel_stored s_base_vis_dirs s_base_tour_dirs {
    foreach bm in same mixed unknown {
        local bmc = cond("`bm'" == "same", "== 0", cond("`bm'" == "mixed", "== 1", "missing"))
        if "`scope'" == "panel_stored" {
            if "`bm'" == "unknown" local c "__bothm & missing(basis_mismatch_rev)"
            else local c "__bothm & basis_mismatch_rev `bmc'"
            quietly count if `c'
            local d = r(N)
            quietly count if `c' & hier_rev == 1
            local h = r(N)
        }
        else {
            local smp = cond("`scope'" == "s_base_vis_dirs", "s_base_vis", "s_base_tour")
            local d 0
            local h 0
            foreach dir in rev same {
                if "`bm'" == "unknown" local c "`smp' & !missing(hier_`dir') & missing(basis_mismatch_`dir')"
                else local c "`smp' & !missing(hier_`dir') & basis_mismatch_`dir' `bmc'"
                quietly count if `c'
                local d = `d' + r(N)
                quietly count if `c' & hier_`dir' == 1
                local h = `h' + r(N)
            }
        }
        post `HV' ("`scope'") ("`bm'") (`d') (`h') (`h' / `d')
    }
}
drop __bothm
* the original analysis code's own count (STUDENT 02_prepare_data.do:89-90), stored rows, both values present
quietly count if !missing(visitors, tourists) & visitors < tourists
display as result "A1.3_ORIGINAL_CODE_COUNT VISITOR_TOURIST_HIERARCHY_VIOLATIONS=" r(N)
postclose `HV'

*==============================================================================
* A1.3 (f) border vs accommodation coverage: what the notes allow
*==============================================================================
tempname AC
postfile `AC' str24 scope str24 field str60 pattern double(rows) str120 reporters using "${OUT}/tables/A1_A1.3_accommodation.dta", replace
local pat_acc "accommodation|hotel|establishment|lodging"
local pat_pc "overnight visitors \(tourists\) only"
foreach f in tour_notes_rev vis_notes_rev tour_notes_same vis_notes_same {
    foreach pp in acc pc {
        gen byte __hit = regexm(lower(`f'), "`pat_`pp''")
        foreach scope in panel_rows s_base_vis s_base_tour {
            local c = cond("`scope'" == "panel_rows", "1", "`scope'")
            quietly count if `c' & __hit
            local nh = r(N)
            local rep ""
            if `nh' > 0 {
                local side = cond(strpos("`f'", "_rev") > 0, "iso3_o", "iso3_d")
                quietly levelsof `side' if `c' & __hit, local(rep) clean
            }
            local rep = substr("`rep'", 1, 120)
            post `AC' ("`scope'") ("`f'") ("`pat_`pp''") (`nh') ("`rep'")
        }
        drop __hit
    }
}
postclose `AC'
foreach f in basis_shares switches hierarchy accommodation {
    preserve
        use "${OUT}/tables/A1_A1.3_`f'.dta", clear
        gen str10 vintage = "${VINTAGE}"
        order vintage
        export delimited using "${OUT}/tables/A1_A1.3_`f'.csv", replace
    restore
    erase "${OUT}/tables/A1_A1.3_`f'.dta"
}
display as result "A1.3_DONE"

*==============================================================================
* A1.4 unit-break screen for all reporters (stored rows: reporter = iso3_o = destination)
*==============================================================================
preserve
    keep iso3_o year tourists visitors
    collapse (sum) tot_tour = tourists tot_vis = visitors (count) n_tour = tourists n_vis = visitors, by(iso3_o year)
    foreach m in vis tour {
        replace tot_`m' = . if n_`m' == 0
        gen double med_other_`m' = .
        gen int nother_`m' = .
        forvalues y = 2007/2021 {
            gen double __o = tot_`m' if year != `y'
            bysort iso3_o: egen double __med = median(__o)
            bysort iso3_o: egen int __no = count(__o)
            replace med_other_`m' = __med if year == `y'
            replace nother_`m' = __no if year == `y'
            drop __o __med __no
        }
        gen double ratio_`m' = tot_`m' / med_other_`m' if med_other_`m' > 0 & !missing(tot_`m', med_other_`m')
        gen byte f50_`m' = ratio_`m' > 50 & !missing(ratio_`m')
        gen byte f10_`m' = ratio_`m' > 10 & !missing(ratio_`m')
    }
    gen byte f50_any = f50_vis | f50_tour
    gen byte f10_any = f10_vis | f10_tour
    tempfile flags
    save `flags'
    * list of flagged reporter-years (ratio > 10, either measure)
    keep if f10_vis | f10_tour
    gen str10 vintage = "${VINTAGE}"
    order vintage iso3_o year tot_vis n_vis med_other_vis nother_vis ratio_vis f50_vis f10_vis ///
        tot_tour n_tour med_other_tour nother_tour ratio_tour f50_tour f10_tour
    format tot_* med_other_* %18.1f
    format ratio_* %12.2f
    export delimited using "${OUT}/tables/A1_A1.4_flagged_reporter_years.csv", replace
    list iso3_o year ratio_vis ratio_tour f50_vis f50_tour, noobs clean
    use `flags', clear
    gen str10 vintage = "${VINTAGE}"
    format tot_* med_other_* %18.1f
    export delimited using "${OUT}/tables/A1_A1.4_reporter_year_totals.csv", replace
restore
preserve
    use `flags', clear
    keep iso3_o year f50_vis f50_tour f10_vis f10_tour f50_any f10_any
    rename (f50_vis f50_tour f10_vis f10_tour f50_any f10_any) (o_f50_vis o_f50_tour o_f10_vis o_f10_tour o_f50_any o_f10_any)
    tempfile fo
    save `fo'
    rename iso3_o iso3_d
    rename o_* d_*
    tempfile fd
    save `fd'
restore
merge m:1 iso3_o year using `fo', keep(master match) nogen
nflow step "A1.4 merge reverse-direction reporter flags (m:1 keep master match; no row change)"
merge m:1 iso3_d year using `fd', keep(master match) nogen
nflow step "A1.4 merge same-direction reporter flags (m:1 keep master match; no row change)"
foreach v of varlist o_f* d_f* {
    replace `v' = 0 if missing(`v')
}
foreach thr in 50 10 {
    foreach m in vis tour {
        * measure-specific flags and union of both measures (File S1 run_T13.do:118-120)
        gen byte ub`thr'_own_`m' = o_f`thr'_`m' | d_f`thr'_`m'
        gen byte ub`thr'_union_`m' = o_f`thr'_any | d_f`thr'_any
        foreach rule in own union {
            quietly count if has_both_`m' & c_trade & ub`thr'_`rule'_`m'
            local ex = r(N)
            quietly count if s_base_`m' & ub`thr'_`rule'_`m'
            local exb = r(N)
            capture noisily ppmlhdfe v_ttl_k mob_bilat_`m' if has_both_`m' & !ub`thr'_`rule'_`m', absorb(${FE}) vce(cluster unordered_pair_id)
            A1_after, rc(`=_rc') item(A1.4) spec(excl_ratio`thr'_`rule') sample(has_both_`m' & !flagged) mobility(`m') terms(mob_bilat_`m') ///
                note("excluded eligible pair-years `ex'; of which in baseline e(sample) `exb'")
        }
    }
}
display as result "A1.4_DONE"

*==============================================================================
* A1.5 measurement vs composition
*==============================================================================
* --- restrictions R1-R4 (flags; candidate rows = has_both & trade observed)
foreach m in vis tour {
    gen byte __cand = has_both_`m' & c_trade
    gen byte r1_`m' = basis_rev_`m' == basis_same_`m' & inlist(basis_rev_`m', "residence", "nationality")
    egen byte __hr = max(__cand & (basis_rev_`m' == "residence" | basis_same_`m' == "residence")), by(pair_id)
    egen byte __hn = max(__cand & (basis_rev_`m' == "nationality" | basis_same_`m' == "nationality")), by(pair_id)
    egen byte __hu = max(__cand & (basis_rev_`m' == "PRY_unknown" | basis_same_`m' == "PRY_unknown")), by(pair_id)
    gen byte r2_`m' = (__hr + __hn + __hu == 1) & __hu == 0
    * r2all (audit check, replaces r2): the pair's basis history over EVERY year 2007-2021 in which
    * a directional value of either direction is observed (all rows of the directed pair, before any
    * trade or both-direction eligibility); one basis only, no PRY_unknown. r2 (candidate years only)
    * is kept as the superseded variant.
    egen byte __ar = max(basis_rev_`m' == "residence" | basis_same_`m' == "residence"), by(pair_id)
    egen byte __an = max(basis_rev_`m' == "nationality" | basis_same_`m' == "nationality"), by(pair_id)
    egen byte __au = max(basis_rev_`m' == "PRY_unknown" | basis_same_`m' == "PRY_unknown"), by(pair_id)
    gen byte r2all_`m' = (__ar + __an + __au == 1) & __au == 0
    assert r2all_`m' <= r2_`m' if __cand
    gen byte r4_`m' = basis_switch_rev_`m' == 0 & basis_switch_same_`m' == 0
    drop __cand __hr __hn __hu __ar __an __au
}
gen byte r3_vis = vis_defok == 1
local lab_r1 "same basis in both directions (pair-year)"
local lab_r2 "SUPERSEDED (audit R1-01; replaced by r2all): one basis for the pair, candidate years only"
local lab_r2all "one basis for the pair (both directions, all observed years 2007-2021)"
local lab_r3 "no confirmed tourists-only substitute in either visitor direction (vis_defok)"
local lab_r4 "no basis switch in either direction's series (COPY flags; missing = not clean)"
foreach m in vis tour {
    capture noisily ppmlhdfe v_ttl_k mob_bilat_`m' if has_both_`m', absorb(${FE}) vce(cluster unordered_pair_id)
    A1_after, rc(`=_rc') item(A1.5) spec(full) sample(has_both_`m') mobility(`m') terms(mob_bilat_`m') note("baseline, full sample")
    local rl "r1 r2 r2all r4"
    if "`m'" == "vis" local rl "r1 r2 r2all r3 r4"
    foreach r of local rl {
        gen byte __s1 = has_both_`m' & `r'_`m' == 1
        gen byte __s2 = has_both_`m' & `r'_`m' != 1
        A1_stack, cl(unordered_pair_id) y1(v_ttl_k) x1(mob_bilat_`m') s1(__s1) y2(v_ttl_k) x2(mob_bilat_`m') s2(__s2) ///
            item(A1.5) spec(`r') mobility(`m') lab1(restricted) lab2(complement) note("`lab_`r''")
        drop __s1 __s2
    }
}

* --- additional restrictions from the web data checks
* (i) SVK/SVN tourist arrivals in accommodation establishments (DC_tourism.md item 4)
gen byte x_svksvn = inlist(iso3_o, "SVK", "SVN") | inlist(iso3_d, "SVK", "SVN")
* (ii) Paraguay as mobility reporter (rev reported by iso3_o, same by iso3_d) and all pairs with PRY
gen byte x_pry_rep = iso3_o == "PRY" | iso3_d == "PRY"
egen byte x_pry_pair = max(iso3_o == "PRY" | iso3_d == "PRY"), by(pair_id)
* a directed pair either involves PRY in every year or never: the two definitions coincide
assert x_pry_pair == x_pry_rep
* (iv) 36 importer-years reporting an HS dataset with no basket rows (rescue C09 evidence list)
preserve
    import delimited using "${C09_FILE}", clear varnames(1) stringcols(3)
    keep year iso3_d zero_fill_no_rows
    assert zero_fill_no_rows == 1
    quietly count
    assert r(N) == 36
    isid year iso3_d
    drop zero_fill_no_rows
    gen byte x_c09 = 1
    tempfile c09
    save `c09'
restore
merge m:1 year iso3_d using `c09', keep(master match) nogen
nflow step "A1.5 merge C09 importer-year list (m:1 keep master match; no row change)"
replace x_c09 = 0 if missing(x_c09)
* (v) constructed zeros: SSD 2011-2012; CUW, BES, SXM 2007-2010 (DC_trade.md items 2b, 2c)
gen byte x_cz = ((iso3_o == "SSD" | iso3_d == "SSD") & inrange(year, 2011, 2012)) | ///
    ((inlist(iso3_o, "CUW", "BES", "SXM") | inlist(iso3_d, "CUW", "BES", "SXM")) & inrange(year, 2007, 2010))
* (vii) 15 importer-year datasets re-released after the August 2026 download (DC_trade.md item 5);
*       x_rev6 = the six with 4-5 times more records (AGO 2011-2012, GHA 2016-2018, OMN 2021)
gen byte x_rev15 = (iso3_d == "AGO" & inlist(year, 2011, 2012)) | (iso3_d == "GHA" & inlist(year, 2016, 2017, 2018, 2021)) | ///
    (iso3_d == "OMN" & year == 2021) | (iso3_d == "QAT" & inlist(year, 2012, 2013)) | ///
    (iso3_d == "GEO" & inlist(year, 2018, 2020, 2021)) | (inlist(iso3_d, "COD", "CRI", "CIV") & year == 2021)
gen byte x_rev6 = (iso3_d == "AGO" & inlist(year, 2011, 2012)) | (iso3_d == "GHA" & inlist(year, 2016, 2017, 2018)) | ///
    (iso3_d == "OMN" & year == 2021)
* (vi) joint "clean measurement" exclusion
gen byte x_clean = x_svksvn | x_pry_rep | x_c09 | x_cz | x_rev15
tempname XS
postfile `XS' str5 measure str12 exclusion double(cand_rows_excluded base_rows_excluded base_rows base_value_excluded base_value base_value_share) ///
    using "${OUT}/tables/A1_A1.5_exclusion_counts.dta", replace
foreach m in vis tour {
    quietly count if s_base_`m'
    local nb = r(N)
    quietly summarize v_ttl_k if s_base_`m', meanonly
    local vb = r(sum)
    foreach x in x_svksvn x_pry_rep x_c09 x_cz x_rev15 x_rev6 x_clean {
        quietly count if has_both_`m' & c_trade & `x'
        local ec = r(N)
        quietly count if s_base_`m' & `x'
        local eb = r(N)
        quietly summarize v_ttl_k if s_base_`m' & `x', meanonly
        local ev = cond(r(N) > 0, r(sum), 0)
        post `XS' ("`m'") ("`x'") (`ec') (`eb') (`nb') (`ev') (`vb') (`ev' / `vb')
        capture noisily ppmlhdfe v_ttl_k mob_bilat_`m' if has_both_`m' & !`x', absorb(${FE}) vce(cluster unordered_pair_id)
        A1_after, rc(`=_rc') item(A1.5) spec(`x') sample(has_both_`m' & !`x') mobility(`m') terms(mob_bilat_`m') ///
            note("exclusion; candidate rows excluded `ec'; baseline e(sample) rows excluded `eb'")
    }
    * clean + basis restrictions (same basis, no switch; visitors also vis_defok)
    local extra "r1_`m' == 1 & r4_`m' == 1"
    if "`m'" == "vis" local extra "`extra' & r3_vis == 1"
    capture noisily ppmlhdfe v_ttl_k mob_bilat_`m' if has_both_`m' & !x_clean & `extra', absorb(${FE}) vce(cluster unordered_pair_id)
    A1_after, rc(`=_rc') item(A1.5) spec(x_clean_basis) sample(has_both_`m' & !x_clean & r1 & r4 [& r3]) mobility(`m') terms(mob_bilat_`m') ///
        note("clean measurement sample plus same basis both directions and no series switch (visitors also no tourists-only substitute)")
}
postclose `XS'
preserve
    use "${OUT}/tables/A1_A1.5_exclusion_counts.dta", clear
    gen str10 vintage = "${VINTAGE}"
    order vintage
    export delimited using "${OUT}/tables/A1_A1.5_exclusion_counts.csv", replace
restore
erase "${OUT}/tables/A1_A1.5_exclusion_counts.dta"
* restriction counts on candidate and baseline rows
tempname RC
postfile `RC' str5 measure str6 restriction double(cand_restricted cand_complement base_restricted base_complement) ///
    using "${OUT}/tables/A1_A1.5_restriction_counts.dta", replace
foreach m in vis tour {
    local rl "r1 r2 r2all r4"
    if "`m'" == "vis" local rl "r1 r2 r2all r3 r4"
    foreach r of local rl {
        quietly count if has_both_`m' & c_trade & `r'_`m' == 1
        local a = r(N)
        quietly count if has_both_`m' & c_trade & `r'_`m' != 1
        local b = r(N)
        quietly count if s_base_`m' & `r'_`m' == 1
        local c = r(N)
        quietly count if s_base_`m' & `r'_`m' != 1
        local d = r(N)
        post `RC' ("`m'") ("`r'") (`a') (`b') (`c') (`d')
    }
}
postclose `RC'
preserve
    use "${OUT}/tables/A1_A1.5_restriction_counts.dta", clear
    gen str10 vintage = "${VINTAGE}"
    order vintage
    export delimited using "${OUT}/tables/A1_A1.5_restriction_counts.csv", replace
restore
erase "${OUT}/tables/A1_A1.5_restriction_counts.dta"
display as result "A1.5_DONE"

A1_close
nflow report
display as result "A1_02_COMPLETE vintage=${VINTAGE} " c(current_date) " " c(current_time)
log close
exit, clear
