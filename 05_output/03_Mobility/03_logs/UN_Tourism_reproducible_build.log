. capture program drop __to_string

. program define __to_string
  1.     version 18.0
  2.     syntax varname
  3.     capture confirm string variable `varlist'
  4.     if _rc {
  5.         tostring `varlist', replace force format(%24.15g)
  6.         replace `varlist' = "" if `varlist' == "."
  7.     }
  8.     replace `varlist' = strtrim(`varlist')
  9. end

. 
. capture program drop __build_family

. program define __build_family, rclass
  1.     version 18.0
  2.     * Do NOT use string asis here: with folder("...") Stata can retain the
.     * literal quote characters, which then makes : dir look for a path whose
.     * name includes quotes. string strips the option quotes while preserving 
> spaces.
.     syntax, FOLDER(string) OUTFILE(string) ///
>         FAMILY(string) BASIS(string) INDICATOR(string) FILECODE(string) ///
>         EXPECTFILES(integer) EXPECTROWS(integer)
  3. 
.     capture local files : dir "`folder'" files "*.xlsx"
  4.     if _rc {
  5.         noi di as error "SOURCE DIRECTORY NOT FOUND:"
  6.         noi di as error `"`folder'"'
  7.         noi di as error "Check global TOUR_RAW and the four source-folder 
> names."
  8.         exit 601
  9.     }
 10.     local nfiles : word count `files'
 11. 
.     noi di as text "---------------------------------------------------------
> ---"
 12.     noi di as result "IMPORT FAMILY: `family' / `basis'"
 13.     noi di as text "Folder: `folder'"
 14.     noi di as result "Excel files found = `nfiles'"
 15. 
.     if `nfiles' == 0 {
 16.         noi di as error "No Excel files found in `folder'"
 17.         exit 601
 18.     }
 19.     if ${STRICT_RELEASE} == 1 & `nfiles' != `expectfiles' {
 20.         noi di as error "Unexpected file count. Expected `expectfiles'; fo
> und `nfiles'."
 21.         exit 459
 22.     }
 23. 
.     * Use explicit scratch files inside the project intermediate folder rathe
> r than Stata tempfile.
.     * This avoids failures when Stata's c(tmpdir) points to a non-writable lo
> cation.
.     local assembled "${TOUR_INT}/__scratch_`family'_`basis'_assembled.dta"
 24.     local manifest  "${TOUR_INT}/__scratch_`family'_`basis'_manifest.dta"
 25.     capture erase "`assembled'"
 26.     capture erase "`manifest'"
 27.     local first = 1
 28.     local mfirst = 1
 29.     local fileno = 0
 30. 
.     foreach f of local files {
 31.         local ++fileno
 32.         noi di as text "  [`fileno'/`nfiles'] `f'"
 33. 
.         capture noisily import excel using `"`folder'/`f'"', ///
>             sheet("Data") firstrow case(lower) clear
 34.         if _rc {
 35.             noi di as error "IMPORT FAILED: `f'"
 36.             exit _rc
 37.         }
 38. 
.         * Required schema in the supplied UN Tourism workbooks.
.         foreach v in reporter_area_code reporter_area_label indicator_code in
> dicator_label ///
>                      indicator_previous_code partner_area_code partner_area_l
> abel year value ///
>                      flag flag_label unit notes {
 39.             capture confirm variable `v'
 40.             if _rc {
 41.                 noi di as error "Missing required variable `v' in `f'"
 42.                 exit 111
 43.             }
 44.         }
 45. 
.         keep reporter_area_code reporter_area_label indicator_code indicator_
> label ///
>              indicator_previous_code partner_area_code partner_area_label yea
> r value ///
>              flag flag_label unit notes
 46. 
.         * Normalize key/value types.
.         foreach v in reporter_area_code partner_area_code year value {
 47.             capture confirm numeric variable `v'
 48.             if _rc destring `v', replace ignore(",")
 49.         }
 50.         foreach v in reporter_area_label indicator_code indicator_label //
> /
>                      indicator_previous_code partner_area_label flag flag_lab
> el unit notes {
 51.             __to_string `v'
 52.         }
 53. 
.         * Structural source validation.
.         assert indicator_code == "`indicator'" if indicator_code != ""
 54.         assert lower(unit) == "thousand trips" if !missing(value)
 55.         assert !missing(reporter_area_code, partner_area_code, year) if !m
> issing(value)
 56. 
.         quietly summarize reporter_area_code, meanonly
 57.         assert r(min) == r(max)
 58. 
.         * File naming convention in the current archive:
.         * 1-4 reporter code; 5-8 indicator file code; 9-12 first year;
.         * 13-16 last year; 17-22 release YYYYMM.
.         local fn_reporter = real(substr("`f'",1,4))
 59.         if missing(`fn_reporter') {
 60.             noi di as error "Unexpected filename convention: `f'"
 61.             exit 459
 62.         }
 63.         assert reporter_area_code == `fn_reporter'
 64.         if substr("`f'",5,4) != "`filecode'" {
 65.             noi di as error "Indicator code in filename does not match fol
> der: `f'"
 66.             exit 459
 67.         }
 68. 
.         gen str100 source_file = "`f'"
 69.         gen str12 source_family = "`family'"
 70.         gen str12 source_basis  = "`basis'"
 71.         gen int source_file_startyear = real(substr(source_file,9,4))
 72.         gen int source_file_endyear   = real(substr(source_file,13,4))
 73.         gen str6 source_release_yyyymm = substr(source_file,17,6)
 74. 
.         assert inrange(year,source_file_startyear,source_file_endyear)
 75. 
.         * A source family must contain only one row for a reporter-partner-ye
> ar.
.         capture isid reporter_area_code partner_area_code year
 76.         if _rc {
 77.             capture frame drop __dupcheck
 78.             frame copy default __dupcheck, replace
 79.             frame __dupcheck: duplicates tag reporter_area_code partner_ar
> ea_code year, gen(__dup)
 80.             frame __dupcheck: keep if __dup > 0
 81.             frame __dupcheck: export delimited using ///
>                 "${TOUR_DIAG}/FAILED_duplicate_keys_`family'_`basis'.csv", re
> place
 82.             frame drop __dupcheck
 83.             noi di as error "Duplicate source keys detected in `f'. See di
> agnostics."
 84.             exit 459
 85.         }
 86. 
.         * Per-file manifest row before stacking.
.         quietly count
 87.         local __source_rows = r(N)
 88.         quietly summarize year, meanonly
 89.         local __observed_min_year = r(min)
 90.         local __observed_max_year = r(max)
 91. 
.         capture frame drop __filemanifest
 92.         frame copy default __filemanifest, replace
 93.         frame __filemanifest: keep in 1
 94.         frame __filemanifest: gen long source_rows = `__source_rows'
 95.         frame __filemanifest: gen int observed_min_year = `__observed_min_
> year'
 96.         frame __filemanifest: gen int observed_max_year = `__observed_max_
> year'
 97.         frame __filemanifest: keep source_file source_family source_basis 
> reporter_area_code reporter_area_label ///
>              source_file_startyear source_file_endyear source_release_yyyymm 
> ///
>              source_rows observed_min_year observed_max_year
 98. 
.         if `mfirst' {
 99.             frame __filemanifest: save "`manifest'", replace
100.             local mfirst = 0
101.         }
102.         else {
103.             frame __filemanifest: append using "`manifest'"
104.             frame __filemanifest: save "`manifest'", replace
105.         }
106.         frame drop __filemanifest
107. 
.         if `first' {
108.             save "`assembled'", replace
109.             local first = 0
110.         }
111.         else {
112.             append using "`assembled'"
113.             save "`assembled'", replace
114.         }
115.     }
116. 
.     use "`assembled'", clear
117.     sort reporter_area_code partner_area_code year
118.     isid reporter_area_code partner_area_code year
119.     quietly count
120.     local nrows = r(N)
121. 
.     if ${STRICT_RELEASE} == 1 & `nrows' != `expectrows' {
122.         noi di as error "Unexpected imported row count for `family'/`basis
> '."
123.         noi di as error "Expected `expectrows'; found `nrows'."
124.         exit 459
125.     }
126. 
.     * Do not compress numeric source values; preserve imported precision.
.     recast double value
127.     capture rescue_on C12 // RESCUE C12 I-M2
128.     local rescue_on_C12 = (_rc==0 & r(on)==1) // RESCUE C12 I-M2
129.     if `rescue_on_C12' { // RESCUE C12
130.         gen byte pry_res_quarantine = reporter_area_code==600 & source_bas
> is=="residence" & inlist(source_file,"0600011220202024202512.xlsx","060001222
> 0202024202512.xlsx") & inrange(year,2020,2022) // RESCUE C12
131.         gen double pry_res_raw_value = value if pry_res_quarantine // RESC
> UE C12
132.         label variable pry_res_raw_value "Original stored source value bef
> ore PRY residence quarantine" // RESCUE C12
133.         replace value = . if pry_res_quarantine // RESCUE C12
134.     } // RESCUE C12
135.     save `"`outfile'"', replace
136. 
.     use "`manifest'", clear
137.     sort reporter_area_code source_file
138.     save `"`outfile'_manifest.dta"', replace
139. 
.     * Scratch files are no longer needed after the family outputs are frozen.
.     capture erase "`assembled'"
140.     capture erase "`manifest'"
141. 
.     return scalar nfiles = `nfiles'
142.     return scalar nrows  = `nrows'
143. end

. 
