. * ----------------------------------------------------------------------
. * D. Publication-facing table.
. * ----------------------------------------------------------------------
. foreach format in csv rtf {
  2.     local extra ""
  3.     if "`format'" == "csv" local extra "csv"
  4. 
.     esttab STACKED using "${TABLES}/table_formal_equality_visitors_tourists.`format'", ///
