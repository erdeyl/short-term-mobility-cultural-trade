. 
. capture confirm file "${INDATA}"

. if _rc {
.     di as error "Exact common-support data not found:"
.     di as error "${INDATA}"
.     di as error "Run Step 1 successfully first."
.     exit 601
. }

. 
. capture which ppmlhdfe

. if _rc {
.     di as error "Required command missing: ppmlhdfe"
.     exit 199
. }

. capture which esttab

. if _rc {
.     di as error "Required command missing: esttab (estout package)"
.     exit 199
. }

. capture which estadd

. if _rc {
.     di as error "Required command missing: estadd (estout package)"
.     exit 199
. }

. capture which eststo

. if _rc {
.     di as error "Required command missing: eststo (estout package)"
.     exit 199
. }

. 
. use "${INDATA}", clear

. isid year iso3_o iso3_d

. 
. foreach v in ///
>     year iso3_o iso3_d pair_id exporter_year importer_year ///
>     v_ttl_k mob_bilat_vis mob_bilat_tour {
  2.     capture confirm variable `v'
  3.     if _rc {
  4.         di as error "Required exact-support variable missing: `v'"
  5.         exit 111
  6.     }
  7. }

. 
. assert !missing(v_ttl_k, mob_bilat_vis, mob_bilat_tour, ///
>                 pair_id, exporter_year, importer_year)

. 
. quietly count

. scalar N_common = r(N)

. 
. local FE "exporter_year importer_year pair_id"

. local CLUSTER "pair_id"

. 
. * ----------------------------------------------------------------------
. * A. Re-estimate the two separate exact-common-support models.
. * These provide the reference slopes that the stacked joint model must reproduce.
. * ----------------------------------------------------------------------
. eststo clear

. 
. quietly ppmlhdfe v_ttl_k mob_bilat_vis, ///
>     absorb(`FE') vce(cluster `CLUSTER')

. eststo SEP_VIS

. scalar sep_vis_b  = _b[mob_bilat_vis]

. scalar sep_vis_se = _se[mob_bilat_vis]

. scalar sep_vis_n  = e(N)

. 
. quietly ppmlhdfe v_ttl_k mob_bilat_tour, ///
>     absorb(`FE') vce(cluster `CLUSTER')

. eststo SEP_TOUR

. scalar sep_tour_b  = _b[mob_bilat_tour]

. scalar sep_tour_se = _se[mob_bilat_tour]

. scalar sep_tour_n  = e(N)

. 
. assert scalar(sep_vis_n) == scalar(N_common)

. assert scalar(sep_tour_n) == scalar(N_common)

. 
. * ----------------------------------------------------------------------
. * B. Stack the exact-common-support data.
. * Each original observation appears once for visitors and once for tourists.
. * ----------------------------------------------------------------------
. expand 2
(2,553 observations created)

. bysort year iso3_o iso3_d: gen byte measure = _n

. label define measure_lbl 1 "Visitors" 2 "Tourists"

. label values measure measure_lbl

. 
. gen double stacked_trade = v_ttl_k

. gen double mobility_value = cond(measure == 1, mob_bilat_vis, mob_bilat_tour)

. 
. * Explicit slope variables make the equality restriction transparent.
. gen double x_vis  = cond(measure == 1, mobility_value, 0)

. gen double x_tour = cond(measure == 2, mobility_value, 0)

. 
. label var x_vis  "Bilateral visitors"

. label var x_tour "Bilateral tourists"

. 
. * Allow every fixed effect to differ freely across the two mobility measures.
. egen long exporter_year_m = group(exporter_year measure)

. egen long importer_year_m = group(importer_year measure)

. egen long pair_m          = group(pair_id measure)

. 
. quietly count

. scalar N_stacked_raw = r(N)

. assert scalar(N_stacked_raw) == 2 * scalar(N_common)

. 
. * ----------------------------------------------------------------------
. * C. Joint stacked PPML and formal Wald equality test.
. * ----------------------------------------------------------------------
. quietly ppmlhdfe stacked_trade x_vis x_tour, ///
>     absorb(exporter_year_m importer_year_m pair_m) ///
>     vce(cluster pair_id)

. eststo STACKED

. 
. scalar joint_vis_b  = _b[x_vis]

. scalar joint_vis_se = _se[x_vis]

. scalar joint_tour_b  = _b[x_tour]

. scalar joint_tour_se = _se[x_tour]

. scalar N_stacked_est = e(N)

. 
. * The stacked model should retain both copies of every exact-support observation.
. assert scalar(N_stacked_est) == 2 * scalar(N_common)

. 
. * Coefficient reproduction checks: stacked slopes should equal the two separate
. * exact-support slopes up to numerical tolerance.
. scalar repro_vis_gap  = abs(scalar(joint_vis_b)  - scalar(sep_vis_b))

. scalar repro_tour_gap = abs(scalar(joint_tour_b) - scalar(sep_tour_b))

. 
. if scalar(repro_vis_gap) > 1e-6 | scalar(repro_tour_gap) > 1e-6 {
.     di as error "Stacked PPML did not reproduce separate exact-support slopes."
.     di as error "Visitor gap = " scalar(repro_vis_gap)
.     di as error "Tourist gap = " scalar(repro_tour_gap)
.     exit 459
. }

. 
. * H0: beta_visitors = beta_tourists
. test x_vis = x_tour

 ( 1)  x_vis - x_tour = 0

           chi2(  1) =    0.82
         Prob > chi2 =    0.3665

. scalar equality_chi2 = r(chi2)

. scalar equality_df   = r(df)

. scalar equality_p    = r(p)

. 
. lincom x_vis - x_tour

 ( 1)  x_vis - x_tour = 0

------------------------------------------------------------------------------
stacked_tr~e | Coefficient  Std. err.      z    P>|z|     [95% conf. interval]
-------------+----------------------------------------------------------------
         (1) |   .0157223   .0174086     0.90   0.366    -.0183979    .0498425
------------------------------------------------------------------------------

. scalar diff_b   = r(estimate)

. scalar diff_se  = r(se)

. scalar diff_z   = r(estimate) / r(se)

. scalar diff_p   = 2 * normal(-abs(scalar(diff_z)))

. scalar diff_ll  = r(lb)

. scalar diff_ul  = r(ub)

. 
. estadd scalar p_equal = scalar(equality_p)

