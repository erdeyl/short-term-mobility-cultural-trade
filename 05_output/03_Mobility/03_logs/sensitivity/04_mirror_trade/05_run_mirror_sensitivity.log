. * ----------------------------------------------------------------------
. gen byte common_trade_vis = ///
>     has_both_vis==1 & ///
>     !missing(v_ttl_k,v_ttl_exporter_lb_k,mob_bilat_vis)

. 
. local conv_vis=0

. local iter_vis=0

. forvalues iter=1/10 {
  2.     local iter_vis=`iter'
  3.     capture drop __imp_v __exp_v
  4. 
.     quietly ppmlhdfe v_ttl_k mob_bilat_vis if common_trade_vis, ///
>         absorb(`FE') vce(cluster `CLUSTER')
  5.     gen byte __imp_v=e(sample)
  6. 
.     quietly ppmlhdfe v_ttl_exporter_lb_k mob_bilat_vis if common_trade_vis, ///
>         absorb(`FE') vce(cluster `CLUSTER')
  7.     gen byte __exp_v=e(sample)
  8. 
.     quietly count if common_trade_vis & (!__imp_v | !__exp_v)
  9.     local rm=r(N)
 10.     if `rm'==0 {
 11.         local conv_vis=1
 12.         continue, break
 13.     }
 14.     replace common_trade_vis=common_trade_vis & __imp_v & __exp_v
 15. }
