
. /****************************************************************************
> ***
>  check_stata_packages.do -- verifies the Stata version and the exact package 
> versions of the tested setup.
>  Run by run_all.py (stage check). Stops with r(459) if a command is missing o
> r a version differs, unless the
>  environment variable PKG_ALLOW_VERSION_DIFF is 1 (then differences are liste
> d and the run continues).
>  Help consulted: require.sthlp 1.3.1 (require package == version), [R] which,
>  [P] file, [P] creturn (c(sysdir_plus)).
> *****************************************************************************
> **/
. version 18

. set more off

. local fail 0

. local allow : environment PKG_ALLOW_VERSION_DIFF

. display as result "STATA version " c(stata_version) " edition `c(edition_real
> )' born `c(born_date)' os `c(os)'"
STATA version 19.5 edition MP born 14 Oct 2026 os Unix

. if c(stata_version) < 18 {
.     display as error "PKG_CHECK Stata 18 or newer is required"
.     local fail 1
. }

. * 1. commands and Mata libraries
. foreach c in ftools reghdfe ppmlhdfe ppml_fe_bias gtools require esttab estou
> t eststo estadd estpost hdfe frmttable ///
>     did_multiplegt_dyn whichdidshouldiuse did_had lprobust distinct nflow res
> cue_on {
  2.     capture which `c'
  3.     if _rc {
  4.         display as error "PKG_MISSING command `c'"
  5.         local fail 1
  6.     }
  7. }

. foreach f in lftools.mlib ppmlhdfe.mata lrowmat_utils.mlib {
  2.     capture findfile `f'
  3.     if _rc {
  4.         display as error "PKG_MISSING file `f'"
  5.         local fail 1
  6.     }
  7. }

. * 2. exact versions from the star-bang lines (require)
. local vdiff 0

. foreach spec in "ftools 2.50.0" "reghdfe 6.14.1" "ppmlhdfe 2.3.4" "gtools 1.1
> 0.1" "require 1.3.1" "estout 3.33" "whichdidshouldiuse 1.0.0" "nflow 1.0.1" {
  2.     gettoken p v : spec
  3.     local v = strtrim("`v'")
  4.     capture noisily require `p' == `v'
  5.     if _rc {
  6.         display as error "PKG_VERSION `p': tested `v', installed version d
> iffers or cannot be read (rc " _rc ")"
  7.         local vdiff 1
  8.     }
  9.     else display as result "PKG_OK `p' == `v'"
 10. }
PKG_OK ftools == 2.50.0
PKG_OK reghdfe == 6.14.1
PKG_OK ppmlhdfe == 2.3.4
PKG_OK gtools == 1.10.1
PKG_OK require == 1.3.1
PKG_OK estout == 3.33
PKG_OK whichdidshouldiuse == 1.0.0
PKG_OK nflow == 1.0.1

. * 3. packages without a version line: Distribution-Date in stata.trk (PLUS)
. local trk "`c(sysdir_plus)'stata.trk"

. capture confirm file "`trk'"

. if _rc {
.     display as error "PKG_CHECK stata.trk not found in `c(sysdir_plus)'"
.     local vdiff 1
. }

. else {
.     foreach spec in "ppml_fe_bias 20210306" "hdfe 20160806" "outreg 20150918"
>  "rowmat_utils 20140815" "moremata 20260111" ///
>         "did_multiplegt_dyn 20260629" "did_had 20240824" "distinct 20120321" 
> "nprobust 20260517" {
  2.         gettoken p d : spec
  3.         local d = strtrim("`d'")
  4.         local found ""
  5.         local in 0
  6.         tempname fh
  7.         file open `fh' using "`trk'", read text
  8.         file read `fh' line
  9.         while r(eof) == 0 {
 10.             if substr(`"`macval(line)'"', 1, 2) == "N " local in = (`"`mac
> val(line)'"' == "N `p'.pkg")
 11.             if `in' & strpos(`"`macval(line)'"', "Distribution-Date:") {
 12.                 local found = strtrim(substr(`"`macval(line)'"', strpos(`"
> `macval(line)'"', ":") + 1, .))
 13.             }
 14.             file read `fh' line
 15.         }
 16.         file close `fh'
 17.         if "`found'" == "`d'" display as result "PKG_OK `p' Distribution-D
> ate `d'"
 18.         else {
 19.             display as error "PKG_VERSION `p': tested Distribution-Date `d
> ', installed [`found']"
 20.             local vdiff 1
 21.         }
 22.     }
PKG_OK ppml_fe_bias Distribution-Date 20210306
PKG_OK hdfe Distribution-Date 20160806
PKG_OK outreg Distribution-Date 20150918
PKG_OK rowmat_utils Distribution-Date 20140815
PKG_OK moremata Distribution-Date 20260111
PKG_OK did_multiplegt_dyn Distribution-Date 20260629
PKG_OK did_had Distribution-Date 20240824
PKG_OK distinct Distribution-Date 20120321
PKG_OK nprobust Distribution-Date 20260517
. }

. if `vdiff' & "`allow'" != "1" local fail 1

. if `vdiff' & "`allow'" == "1" display as text "PKG_CHECK version differences 
> accepted (PKG_ALLOW_VERSION_DIFF=1)"

. if `fail' {
.     display as error "PKG_CHECK=FAIL (install: python3 run_all.py --install-s
> tata-packages; README.md, Software)"
.     exit 459
. }

. display as result "PKG_CHECK=PASS"
PKG_CHECK=PASS

. 
end of do-file
