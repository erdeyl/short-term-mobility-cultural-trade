. foreach m in vis tour {
  2.     local s = cond("`m'" == "vis", "v", "t")
  3.     gen byte hb_nf_`m' = !missing(`s'_nf, s_`s'_nf)
  4.     assert hb_nf_`m' == has_both_`m'
  5.     gen double mob_nf_`m' = asinh(`s'_nf + s_`s'_nf) if hb_nf_`m'
  6.     label variable mob_nf_`m' "IHS bilateral `m', nationality-first construction"
  7.     * check: the baseline bilateral measure is the residence-first construction
.     gen double __d = abs(mob_bilat_`m' - asinh(`s'_rf + s_`s'_rf)) if has_both_`m'
  8.     quietly summarize __d
  9.     assert r(max) < 1e-12
 10.     drop __d
 11.     * changes on the baseline sample
.     quietly count if s_base_`m'
 12.     local nb = r(N)
 13.     quietly count if s_base_`m' & `s'_chg
 14.     local c1 = r(N)
 15.     quietly count if s_base_`m' & s_`s'_chg
 16.     local c2 = r(N)
 17.     quietly count if s_base_`m' & (`s'_chg | s_`s'_chg)
 18.     local cp = r(N)
 19.     post `NF' ("`m'") ("baseline_pair_years") (`nb') ("s_base_`m'")
 20.     post `NF' ("`m'") ("baseline_direction_years") (2 * `nb') ("reverse and same-direction cells of the baseline pair-years")
 21.     post `NF' ("`m'") ("direction_years_changed") (`c1' + `c2') ("cells with both bases and residence != nationality (rev `c1', same `c2')")
 22.     post `NF' ("`m'") ("pair_years_changed") (`cp') ("baseline pair-years with a changed cell in either direction")
 23.     post `NF' ("`m'") ("share_pair_years_changed") (`cp' / `nb') ("")
 24.     * ratio nationality / residence, direction cells (rev and same pooled) and bilateral
.     preserve
 25.         quietly keep if s_base_`m'
 26.         keep `s'res `s'nat s_`s'res s_`s'nat `s'_chg s_`s'_chg mob_bilat_`m' mob_nf_`m' `s'_rf s_`s'_rf `s'_nf s_`s'_nf
 27.         gen double r1 = `s'nat / `s'res if `s'_chg
 28.         gen double r2 = s_`s'nat / s_`s'res if s_`s'_chg
 29.         gen double rb = (`s'_nf + s_`s'_nf) / (`s'_rf + s_`s'_rf) if (`s'_chg | s_`s'_chg)
 30.         stack r1 r2, into(rc) clear
 31.         quietly summarize rc, detail
 32.         local q50 = r(p50)
 33.         local q25 = r(p25)
 34.         local q75 = r(p75)
 35.         local nr = r(N)
 36.     restore
 37.     post `NF' ("`m'") ("ratio_nat_over_res_cells_median") (`q50') ("changed direction-years (N `nr'); nationality value / residence value")
 38.     post `NF' ("`m'") ("ratio_nat_over_res_cells_p25") (`q25') ("")
 39.     post `NF' ("`m'") ("ratio_nat_over_res_cells_p75") (`q75') ("")
 40.     gen double __rb = (`s'_nf + s_`s'_nf) / (`s'_rf + s_`s'_rf) if s_base_`m' & (`s'_chg | s_`s'_chg)
 41.     quietly summarize __rb, detail
 42.     post `NF' ("`m'") ("ratio_bilateral_natfirst_over_baseline_median") (r(p50)) ("changed pair-years (N `r(N)')")
 43.     post `NF' ("`m'") ("ratio_bilateral_natfirst_over_baseline_p25") (r(p25)) ("")
 44.     post `NF' ("`m'") ("ratio_bilateral_natfirst_over_baseline_p75") (r(p75)) ("")
 45.     gen double __dm = mob_nf_`m' - mob_bilat_`m' if s_base_`m' & (`s'_chg | s_`s'_chg)
 46.     quietly summarize __dm, detail
 47.     post `NF' ("`m'") ("ihs_difference_median") (r(p50)) ("IHS(nationality-first) - IHS(baseline), changed pair-years")
 48.     post `NF' ("`m'") ("ihs_difference_p25") (r(p25)) ("")
 49.     post `NF' ("`m'") ("ihs_difference_p75") (r(p75)) ("")
 50.     drop __rb __dm
 51.     display as result "C2_A1_09 `m': baseline pair-years `nb'; changed direction-years `=`c1'+`c2''; changed pair-years `cp'; cell ratio median " %8.4f `q50' " IQR [" %8.4f `q25' ", " %8.4f `q75'
>  "]"
 52.     * nationality-first model on the baseline candidate rows; e(sample) vs s_base (key-by-key)
.     capture noisily ppmlhdfe v_ttl_k mob_nf_`m' if hb_nf_`m', absorb(${FE}) vce(cluster unordered_pair_id)
 53.     A1_after, rc(`=_rc') item(A1.5) spec(m_natfirst_full) sample(has_both_`m' (identical under both rules)) mobility(`m') ///
>         terms(mob_nf_`m') gen(es_nf_`m') note("nationality-first construction on the baseline candidate rows")
 54.     quietly count if es_nf_`m' != s_base_`m'
 55.     local mis = r(N)
 56.     post `NF' ("`m'") ("esample_mismatches_vs_s_base") (`mis') ("nationality-first e(sample) vs baseline e(sample), key-by-key")
 57.     display as result "C2_A1_09 `m': nationality-first e(sample) vs s_base_`m' mismatches = `mis'"
 58.     gen byte io_`m' = es_nf_`m' & s_base_`m'
 59.     if `mis' > 0 {
 60.         local it 0
 61.         local done 0
 62.         while !`done' {
 63.             local ++it
 64.             if `it' > 20 error 430
 65.             quietly count if io_`m'
 66.             local n0 = r(N)
 67.             foreach x in mob_bilat_`m' mob_nf_`m' {
 68.                 quietly ppmlhdfe v_ttl_k `x' if io_`m', absorb(${FE}) vce(cluster unordered_pair_id)
 69.                 assert e(converged) == 1
 70.                 nflow est "C2_A1_09 `m' identical-observation fixed point `it' `x'"
 71.                 quietly replace io_`m' = io_`m' & e(sample)
 72.             }
 73.             quietly count if io_`m'
 74.             if r(N) == `n0' local done 1
 75.         }
 76.     }
 77.     quietly count if io_`m'
 78.     post `NF' ("`m'") ("identical_observations_N") (r(N)) ("")
 79.     gen byte __s1 = io_`m'
 80.     gen byte __s2 = io_`m'
 81.     A1_stack, cl(unordered_pair_id) y1(v_ttl_k) x1(mob_bilat_`m') s1(__s1) y2(v_ttl_k) x2(mob_nf_`m') s2(__s2) item(A1.5) spec(m_natfirst) ///
>         mobility(`m') lab1(baseline) lab2(natfirst) sample(baseline e(sample), identical observations) ///
>         note("R1-2.12 (C) priority reversal: residence first (baseline) vs nationality first, identical observations")
 82.     drop __s1 __s2
 83.     * same-basis subsample defined under both rules
.     gen byte r1b_`m' = basis_rev_`m' == basis_same_`m' & inlist(basis_rev_`m', "residence", "nationality")
 84.     gen byte r1n_`m' = `s'_bnf == s_`s'_bnf & inlist(`s'_bnf, "residence", "nationality")
 85.     gen byte sb_`m' = has_both_`m' & r1b_`m' & r1n_`m'
 86.     quietly count if s_base_`m' & r1b_`m'
 87.     post `NF' ("`m'") ("baseline_rows_same_basis_baseline_rule") (r(N)) ("")
 88.     quietly count if s_base_`m' & r1n_`m'
 89.     post `NF' ("`m'") ("baseline_rows_same_basis_natfirst_rule") (r(N)) ("")
 90.     quietly count if s_base_`m' & r1b_`m' & r1n_`m'
 91.     post `NF' ("`m'") ("baseline_rows_same_basis_both_rules") (r(N)) ("")
 92.     quietly count if s_base_`m' & r1b_`m' & r1n_`m' & (`s'_chg | s_`s'_chg)
 93.     post `NF' ("`m'") ("same_basis_both_rules_pair_years_changed") (r(N)) ("")
 94.     * identical observations within the subsample: fixed point of the two models
.     gen byte iosb_`m' = sb_`m'
 95.     local it 0
 96.     local done 0
 97.     while !`done' {
 98.         local ++it
 99.         if `it' > 20 error 430
100.         quietly count if iosb_`m'
101.         local n0 = r(N)
102.         foreach x in mob_bilat_`m' mob_nf_`m' {
103.             quietly ppmlhdfe v_ttl_k `x' if iosb_`m', absorb(${FE}) vce(cluster unordered_pair_id)
104.             assert e(converged) == 1
105.             nflow est "C2_A1_09 `m' same-basis fixed point `it' `x'"
106.             quietly replace iosb_`m' = iosb_`m' & e(sample)
107.         }
108.         quietly count if iosb_`m'
109.         if r(N) == `n0' local done 1
110.     }
111.     quietly count if iosb_`m'
112.     post `NF' ("`m'") ("same_basis_identical_observations_N") (r(N)) ("fixed point after `it' iteration(s)")
113.     gen byte __s1 = iosb_`m'
114.     gen byte __s2 = iosb_`m'
115.     A1_stack, cl(unordered_pair_id) y1(v_ttl_k) x1(mob_bilat_`m') s1(__s1) y2(v_ttl_k) x2(mob_nf_`m') s2(__s2) item(A1.5) spec(m_natfirst_r1) ///
>         mobility(`m') lab1(baseline) lab2(natfirst) sample(same basis in both directions under both rules, identical obs) ///
>         note("R1-2.12 (C) priority reversal within the same-basis subsample defined under both rules")
116.     drop __s1 __s2
117. }
