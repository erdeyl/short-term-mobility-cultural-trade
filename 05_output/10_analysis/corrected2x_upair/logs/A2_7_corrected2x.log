(file <PACKAGE_ROOT>/05_output/10_analysis/corrected2x_upair/tables/A2_A2.7.dta not found)

. local FE "exporter_year importer_year pair_id"

. 
. gen double v_noncult_k = tradeflow_comtrade_d - v_ttl_k if !missing(tradeflow_comtrade_d, v_ttl_k) & tradeflow_comtrade_d - v_ttl_k >= 0
(12,720 missing values generated)

. label variable v_noncult_k "Non-cultural imports: CEPII tradeflow_comtrade_d - v_ttl_k where >= 0 (1000 USD)"

. 
. foreach m in vis tour {
  2.     local mlab = cond("`m'" == "vis", "visitors", "tourists")
  3.     local smp "s_base_`m'"
  4.     quietly count if `smp' & year <= 2020
  5.     local n20 = r(N)
  6.     quietly count if `smp' & year <= 2020 & missing(tradeflow_comtrade_d)
  7.     a2_tpost, item(A2.7) table(coverage) sample(`smp' & year<=2020) mobility(`mlab') stat(rows_benchmark_missing) value(`r(N)') n(`n20')
  8.     quietly count if `smp' & year == 2021
  9.     a2_tpost, item(A2.7) table(coverage) sample(`smp') mobility(`mlab') stat(rows_2021_excluded) value(`r(N)')
 10.     quietly count if `smp' & year <= 2020 & !missing(tradeflow_comtrade_d) & tradeflow_comtrade_d < v_ttl_k
 11.     a2_tpost, item(A2.7) table(coverage) sample(`smp' & year<=2020) mobility(`mlab') stat(rows_noncultural_negative) value(`r(N)') n(`n20') note("CEPII total imports below our cultural imports; n
> ot used for the non-cultural outcome")
 12.     quietly count if `smp' & year <= 2020 & tradeflow_comtrade_d == 0
 13.     a2_tpost, item(A2.7) table(coverage) sample(`smp' & year<=2020) mobility(`mlab') stat(rows_benchmark_zero) value(`r(N)') n(`n20')
 14.     * reference: cultural trade on baseline rows with year <= 2020 (no benchmark restriction)
.     quietly ppmlhdfe v_ttl_k mob_bilat_`m' if `smp' & year <= 2020, absorb(`FE') vce(cluster unordered_pair_id)
 15.     a2_chk "A2.7 cultural `mlab' baseline rows year<=2020"
 16.     a2_post, item(A2.7) spec(cultural_year_le_2020) sample(`smp' & year<=2020) mobility(`mlab') term(mob_bilat_`m') label(cultural goods)
 17.     foreach bm in tradeflow_comtrade_d v_noncult_k {
 18.         local bl = cond("`bm'" == "tradeflow_comtrade_d", "total imports (CEPII Comtrade)", "non-cultural imports")
 19.         gen byte bm_`bm'_`m' = `smp' & year <= 2020 & !missing(`bm', v_ttl_k)
 20.         quietly count if bm_`bm'_`m'
 21.         local nc = r(N)
 22.         a2_fix, touse(bm_`bm'_`m') models("v_ttl_k mob_bilat_`m' ; `bm' mob_bilat_`m'")
 23.         local it = ${A2_FIX_IT}
 24.         quietly summarize v_ttl_k if bm_`bm'_`m', meanonly
 25.         local sc = r(sum)
 26.         quietly summarize tradeflow_comtrade_d if bm_`bm'_`m', meanonly
 27.         local st = r(sum)
 28.         a2_tpost, item(A2.7) table(cultural_share) sample(identical rows `bm') mobility(`mlab') stat(cultural_share_of_total_pct) value(`=100*`sc'/`st'') n(`r(N)') note("100 * sum(v_ttl_k) / sum(
> tradeflow_comtrade_d)")
 29.         tempvar r
 30.         gen double `r' = v_ttl_k / tradeflow_comtrade_d if bm_`bm'_`m'
 31.         quietly summarize `r', detail
 32.         a2_tpost, item(A2.7) table(cultural_share) sample(identical rows `bm') mobility(`mlab') stat(median_rowwise_cultural_share) value(`r(p50)') n(`r(N)')
 33.         a2_tpost, item(A2.7) table(cultural_share) sample(identical rows `bm') mobility(`mlab') stat(p99_rowwise_cultural_share) value(`r(p99)') n(`r(N)')
 34.         drop `r'
 35.         preserve
 36.         a2_stack, touse(bm_`bm'_`m') ys(v_ttl_k `bm') xs("mob_bilat_`m' ; mob_bilat_`m'") cluster(unordered_pair_id)
 37.         local nu = ${A2_NUNIQ}
 38.         a2_post, item(A2.7) spec(`bm'_identical_rows) sample(`smp' & year<=2020 & `bm' observed) mobility(`mlab') term(s1_1) label(cultural goods) nuniq(`nu') note("candidate rows `nc'; fixed-poi
> nt iterations `it'")
 39.         a2_post, item(A2.7) spec(`bm'_identical_rows) sample(`smp' & year<=2020 & `bm' observed) mobility(`mlab') term(s2_1) label(`bl') nuniq(`nu')
 40.         a2_post, item(A2.7) spec(`bm'_identical_rows) sample(`smp' & year<=2020 & `bm' observed) mobility(`mlab') term(s1_1 - s2_1) label(cultural - benchmark) nuniq(`nu')
 41.         quietly test s1_1 = s2_1
 42.         a2_posttest, item(A2.7) spec(`bm'_identical_rows) sample(`smp' & year<=2020 & `bm' observed) mobility(`mlab') label(test cultural = benchmark) chi2(`r(chi2)') df(`r(df)') p(`r(p)') nuniq(
> `nu')
 43.         display as result "A2_7 `m' `bm' N=`nu' cultural=" %9.6f _b[s1_1] " benchmark=" %9.6f _b[s2_1] " gap=${A2_STACK_GAP}"
 44.         restore
 45.         nflow step "restore: after A2.7 `bm' `mlab' stacked test"
 46.     }
 47. }
