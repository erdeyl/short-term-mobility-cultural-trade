. foreach m in vis tour {
  2.     quietly count if s_base_`m'
  3.     local nb = r(N)
  4.     quietly count if s_base_`m' & ov_`m'
  5.     local n0 = r(N)
  6.     quietly count if has_both_`m' & ov_`m'
  7.     local nhb = r(N)
  8.     display as result "C2_A1_08_STEP0 `m': baseline rows `nb'; with residence AND nationality in both directions `n0' (has_both rows with both: `nhb')"
  9.     post `OV' ("`m'") ("baseline_rows") (`nb') ("s_base_`m'")
 10.     post `OV' ("`m'") ("step0_baseline_rows_both_bases_both_directions") (`n0') ("residence and nationality values exist in both directions")
 11.     post `OV' ("`m'") ("step0_has_both_rows_both_bases_both_directions") (`nhb') ("")
 12.     * baseline construction = residence on the overlap (residence first in each direction)
.     gen double __d = abs(mob_bilat_`m' - mob_res_`m') if s_base_`m' & ov_`m'
 13.     quietly summarize __d
 14.     display as result "C2_A1_08 `m' max |baseline - residence-built| on the overlap = " r(max)
 15.     assert r(max) == 0 | r(N) == 0
 16.     drop __d
 17.     * identical observations: fixed point of the residence-built and nationality-built models
.     gen byte io_`m' = s_base_`m' & ov_`m'
 18.     local it 0
 19.     local done 0
 20.     while !`done' {
 21.         local ++it
 22.         if `it' > 20 error 430
 23.         quietly count if io_`m'
 24.         local n_start = r(N)
 25.         quietly ppmlhdfe v_ttl_k mob_res_`m' if io_`m', absorb(${FE}) vce(cluster unordered_pair_id)
 26.         assert e(converged) == 1
 27.         nflow est "C2_A1_08 `m' overlap fixed point iteration `it' residence"
 28.         quietly replace io_`m' = io_`m' & e(sample)
 29.         quietly ppmlhdfe v_ttl_k mob_nat_`m' if io_`m', absorb(${FE}) vce(cluster unordered_pair_id)
 30.         assert e(converged) == 1
 31.         nflow est "C2_A1_08 `m' overlap fixed point iteration `it' nationality"
 32.         quietly replace io_`m' = io_`m' & e(sample)
 33.         quietly count if io_`m'
 34.         if r(N) == `n_start' local done 1
 35.     }
 36.     quietly count if io_`m'
 37.     local nio = r(N)
 38.     post `OV' ("`m'") ("identical_observations_N") (`nio') ("fixed point after `it' iteration(s)")
 39.     post `OV' ("`m'") ("share_of_baseline_N") (`nio' / `nb') ("")
 40.     tempvar te
 41.     quietly egen byte `te' = tag(pair_id) if io_`m'
 42.     quietly count if `te' == 1
 43.     post `OV' ("`m'") ("directed_pairs") (r(N)) ("")
 44.     quietly levelsof iso3_o if io_`m', local(lo) clean
 45.     quietly levelsof iso3_d if io_`m', local(ld) clean
 46.     local le : list lo | ld
 47.     post `OV' ("`m'") ("economies") (`: word count `le'') ("`: word count `lo'' as exporter, `: word count `ld'' as importer: `le'")
 48.     quietly levelsof year if io_`m', local(ly) clean
 49.     post `OV' ("`m'") ("years") (`: word count `ly'') ("`ly'")
 50.     forvalues y = 2007/2021 {
 51.         quietly count if io_`m' & year == `y'
 52.         post `OV' ("`m'") ("rows_`y'") (r(N)) ("")
 53.     }
 54.     display as result "C2_A1_08 `m' identical observations N=`nio' share=" %6.4f `nio' / `nb' " economies=`: word count `le'' years: `ly'"
 55.     * baseline construction on the identical observations (= residence by construction; reported)
.     capture noisily ppmlhdfe v_ttl_k mob_bilat_`m' if io_`m', absorb(${FE}) vce(cluster unordered_pair_id)
 56.     A1_after, rc(`=_rc') item(A1.5) spec(m_overlap_base) sample(baseline rows with both bases in both directions, identical obs) mobility(`m') ///
>         terms(mob_bilat_`m') note("baseline construction (residence first) on the overlap; equals the residence-built measure there")
 57.     * residence vs nationality, separate fits and stacked test (identical observations). A1_stack does not
.     * handle an omitted (collinear) slope (it would post the omitted 0 as a stacked slope), so the
.     * identification of both slopes is checked first; if either is omitted, the separate fits are posted
.     * (TERM OMITTED) and the test is posted as not identified.
.     local sn "baseline rows with both bases in both directions, identical obs"
 58.     local nt "R1-2.12 fixed-observation measurement comparison; residence and nationality series of the snapshot master, corrected2x quarantines applied"
 59.     local idok 1
 60.     foreach x in res nat {
 61.         quietly ppmlhdfe v_ttl_k mob_`x'_`m' if io_`m', absorb(${FE}) vce(cluster unordered_pair_id)
 62.         assert e(converged) == 1
 63.         nflow est "C2_A1_08 `m' identification check `x'"
 64.         if _se[mob_`x'_`m'] == 0 | missing(_se[mob_`x'_`m']) local idok 0
 65.     }
 66.     if `idok' {
 67.         gen byte __s1 = io_`m'
 68.         gen byte __s2 = io_`m'
 69.         A1_stack, cl(unordered_pair_id) y1(v_ttl_k) x1(mob_res_`m') s1(__s1) y2(v_ttl_k) x2(mob_nat_`m') s2(__s2) ///
>             item(A1.5) spec(m_overlap) mobility(`m') lab1(residence) lab2(nationality) sample(`sn') note("`nt'")
 70.         drop __s1 __s2
 71.     }
 72.     else {
 73.         foreach x in res nat {
 74.             local lb = cond("`x'" == "res", "residence", "nationality")
 75.             capture noisily ppmlhdfe v_ttl_k mob_`x'_`m' if io_`m', absorb(${FE}) vce(cluster unordered_pair_id)
 76.             A1_after, rc(`=_rc') item(A1.5) spec(m_overlap_sep_`lb') sample(`lb') mobility(`m') terms(mob_`x'_`m') note("`nt'")
 77.         }
 78.         A1_posttest, item(A1.5) spec(m_overlap_test) sample(`sn') mobility(`m') term(residence_eq_nationality) ///
>             stat(.) df(.) p(.) nobs(`nio') note("NOT IDENTIFIED: the mobility slope is omitted (collinear with the fixed effects) in the separate fit(s) on the `nio' identical observations; no stack
> ed test")
 79.     }
 80. }
