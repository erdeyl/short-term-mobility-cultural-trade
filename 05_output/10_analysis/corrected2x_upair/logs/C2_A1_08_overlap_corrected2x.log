. * estimates excluding violation rows (any basis), baseline and same-basis (r1) restricted model
. foreach m in vis tour {
  2.     foreach x in xn_any xn_same {
  3.         quietly count if s_base_`m' & `x'
  4.         local eb = r(N)
  5.         capture noisily ppmlhdfe v_ttl_k mob_bilat_`m' if has_both_`m' & !`x', absorb(${FE}) vce(cluster unordered_pair_id)
  6.         A1_after, rc(`=_rc') item(A1.3) spec(nest_`x'_base) sample(has_both_`m' & !`x') mobility(`m') terms(mob_bilat_`m') ///
>             note("baseline excluding pair-years with visitors < tourists in either direction (`x'); baseline rows excluded `eb'")
  7.         capture noisily ppmlhdfe v_ttl_k mob_bilat_`m' if has_both_`m' & r1b_`m' & !`x', absorb(${FE}) vce(cluster unordered_pair_id)
  8.         A1_after, rc(`=_rc') item(A1.3) spec(nest_`x'_r1) sample(has_both_`m' & r1 & !`x') mobility(`m') terms(mob_bilat_`m') ///
>             note("same basis in both directions (A1.5 r1 restricted) excluding pair-years with visitors < tourists (`x')")
  9.     }
 10. }
