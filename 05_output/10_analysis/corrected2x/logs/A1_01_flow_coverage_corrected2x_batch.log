. foreach s in s_base_vis s_base_tour s_cs_exact s_dyn_vis s_dyn_tour {
  2.     preserve
  3.         keep if `s' == 1
  4.         keep iso3_o iso3_d year
  5.         gen long __k = _n
  6.         rename (iso3_o iso3_d) (iso1 iso2)
  7.         reshape long iso, i(__k) j(side)
  8.         gen byte as_exporter = side == 1
  9.         gen byte as_importer = side == 2
 10.         collapse (sum) obs_as_exporter = as_exporter obs_as_importer = as_importer (min) first_year = year (max) last_year = year, by(iso)
 11.         gen str24 role = cond(obs_as_exporter > 0 & obs_as_importer > 0, "exporter and importer", ///
>             cond(obs_as_exporter > 0, "exporter only", "importer only"))
 12.         gen str12 sample = "`s'"
 13.         merge 1:1 iso using `names', keep(master match) gen(_mname)
 14.         replace name_un = "(no UN Comtrade reference name)" if _mname == 1
 15.         drop _mname
 16.         if `first' == 0 append using `econ'
 17.         save `econ', replace
 18.         local first 0
 19.     restore
 20. }
