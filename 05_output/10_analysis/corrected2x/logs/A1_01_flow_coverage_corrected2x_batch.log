  9.             quietly summarize obs, meanonly
 10.             gen double share_obs = obs / r(sum)
 11.             quietly summarize value_k, meanonly
 12.             gen double share_value = value_k / r(sum)
 13.             gen str12 sample = "`s'"
 14.             gen str20 dimension = "`dim'"
 15.             if `first' == 0 append using `comp'
 16.             save `comp', replace
 17.             local first 0
 18.         restore
 19.     }
 20. }
