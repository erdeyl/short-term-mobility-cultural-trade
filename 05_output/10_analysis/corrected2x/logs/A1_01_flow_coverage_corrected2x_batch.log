. *==============================================================================
. * A1.1 (d) cultural-distance interaction samples (07_table5_moderators.do:11-43, as 01_prep F)
. *==============================================================================
. gen byte c_cd = !missing(cul_dist)

. foreach m in vis tour {
  2.     quietly summarize cul_dist if !missing(v_ttl_k, mob_bilat_`m', cul_dist)
  3.     gen double __cdc = cul_dist - r(mean)
  4.     gen double __x = mob_bilat_`m' * __cdc
  5.     quietly count
  6.     local n0 = r(N)
  7.     post `FL' ("cd") ("`m'") ("trade_first") (0) ("master panel") (`n0') (.) ("")
  8.     quietly count if c_trade
  9.     local n1 = r(N)
 10.     post `FL' ("cd") ("`m'") ("trade_first") (1) ("trade observed") (`n1') (`n0' - `n1') ("")
 11.     quietly count if c_trade & has_both_`m'
 12.     local n2 = r(N)
 13.     post `FL' ("cd") ("`m'") ("trade_first") (2) ("+ bilateral mobility (has_both)") (`n2') (`n1' - `n2') ("")
 14.     quietly count if c_trade & has_both_`m' & c_cd
 15.     local n3 = r(N)
 16.     post `FL' ("cd") ("`m'") ("trade_first") (3) ("+ Hofstede cultural distance observed (cul_dist, cd6_ge4)") (`n3') (`n2' - `n3') ("")
 17.     capture noisily ppmlhdfe v_ttl_k mob_bilat_`m' __x if !missing(__cdc), absorb(${FE}) vce(cluster pair_id)
 18.     A1_after, rc(`=_rc') item(A1.1) spec(cd_T5) sample(cul_dist_observed) mobility(`m') terms(mob_bilat_`m' __x) gen(__es) note("__x = mobility x centred cul_dist")
 19.     assert e(N_full) == `n3'
 20.     assert __es == s_cd_`m'
 21.     local nsing = e(num_singletons)
 22.     local nsep = e(num_separated)
 23.     local nn = e(N)
 24.     drop __es __cdc __x
 25.     post `FL' ("cd") ("`m'") ("trade_first") (4) ("PPML: singleton observations dropped") (`n3' - `nsing') (`nsing') ("")
 26.     post `FL' ("cd") ("`m'") ("trade_first") (5) ("PPML: separated observations dropped") (`nn') (`nsep') ("final e(N)")
 27.     foreach c in c_trade has_both_`m' c_cd {
 28.         local others = subinstr("c_trade has_both_`m' c_cd", "`c'", "", 1)
 29.         local oc "1"
 30.         foreach o of local others {
 31.             local oc "`oc' & `o'"
 32.         }
 33.         quietly count if !`c'
 34.         local fa = r(N)
 35.         quietly count if !`c' & `oc'
 36.         local fo = r(N)
 37.         post `OC' ("cd") ("`m'") ("`c'") (`fa') (`fo') (`n0')
 38.     }
 39. }
