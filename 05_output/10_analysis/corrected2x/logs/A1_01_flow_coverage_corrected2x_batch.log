. assert __cs == s_cs_exact

. drop __cs __ev __et

. foreach c in c_trade has_both_vis has_both_tour {
  2.     local others = subinstr("c_trade has_both_vis has_both_tour", "`c'", "", 1)
  3.     local oc "1"
  4.     foreach o of local others {
  5.         local oc "`oc' & `o'"
  6.     }
  7.     quietly count if !`c'
  8.     local fa = r(N)
  9.     quietly count if !`c' & `oc'
 10.     local fo = r(N)
 11.     post `OC' ("cs_exact") ("both") ("`c'") (`fa') (`fo') (`n0')
 12. }

. 
. *==============================================================================
. * A1.1 (c) dynamic samples (Table 3; 05_table3_dynamic.do:14,20)
. *==============================================================================
. foreach m in vis tour {
  2.     gen byte c_lag = !missing(lag_bilat_`m')
  3.     gen byte c_lead = !missing(lead_bilat_`m')
  4.     quietly count
  5.     local n0 = r(N)
  6.     post `FL' ("dyn") ("`m'") ("trade_first") (0) ("master panel") (`n0') (.) ("")
  7.     quietly count if c_trade
  8.     local n1 = r(N)
  9.     post `FL' ("dyn") ("`m'") ("trade_first") (1) ("trade observed") (`n1') (`n0' - `n1') ("")
 10.     quietly count if c_trade & has_both_`m'
 11.     local n2 = r(N)
 12.     post `FL' ("dyn") ("`m'") ("trade_first") (2) ("+ current bilateral mobility (has_both)") (`n2') (`n1' - `n2') ("")
 13.     quietly count if c_trade & has_both_`m' & c_lag
 14.     local n3 = r(N)
 15.     quietly count if c_trade & has_both_`m' & !c_lag & year == 2007
 16.     local y07 = r(N)
 17.     post `FL' ("dyn") ("`m'") ("trade_first") (3) ("+ lagged bilateral mobility observed (t-1 both directions)") (`n3') (`n2' - `n3') ("of which year 2007 (no t-1 in window): `y07'")
 18.     quietly count if c_trade & has_both_`m' & c_lag & c_lead
 19.     local n4 = r(N)
 20.     quietly count if c_trade & has_both_`m' & c_lag & !c_lead & year == 2021
 21.     local y21 = r(N)
 22.     post `FL' ("dyn") ("`m'") ("trade_first") (4) ("+ lead bilateral mobility observed (t+1 both directions)") (`n4') (`n3' - `n4') ("of which year 2021 (no t+1 in window): `y21'")
 23.     capture noisily ppmlhdfe v_ttl_k lag_bilat_`m' mob_bilat_`m' lead_bilat_`m', absorb(${FE}) vce(cluster pair_id)
 24.     A1_after, rc(`=_rc') item(A1.1) spec(dynamic_T3) sample(all_rows) mobility(`m') terms(lag_bilat_`m' mob_bilat_`m' lead_bilat_`m') gen(__es)
 25.     assert e(N_full) == `n4'
 26.     assert __es == s_dyn_`m'
 27.     local nsing = e(num_singletons)
 28.     local nsep = e(num_separated)
 29.     local nn = e(N)
 30.     drop __es
 31.     post `FL' ("dyn") ("`m'") ("trade_first") (5) ("PPML: singleton observations dropped") (`n4' - `nsing') (`nsing') ("")
 32.     post `FL' ("dyn") ("`m'") ("trade_first") (6) ("PPML: separated observations dropped") (`nn') (`nsep') ("final e(N)")
 33.     foreach c in c_trade has_both_`m' c_lag c_lead {
 34.         local others = subinstr("c_trade has_both_`m' c_lag c_lead", "`c'", "", 1)
 35.         local oc "1"
 36.         foreach o of local others {
 37.             local oc "`oc' & `o'"
 38.         }
 39.         quietly count if !`c'
 40.         local fa = r(N)
 41.         quietly count if !`c' & `oc'
 42.         local fo = r(N)
 43.         local cl = cond("`c'" == "c_lag", "lag_bilat_`m' observed", cond("`c'" == "c_lead", "lead_bilat_`m' observed", "`c'"))
 44.         post `OC' ("dyn") ("`m'") ("`cl'") (`fa') (`fo') (`n0')
 45.     }
 46.     drop c_lag c_lead
 47. }
