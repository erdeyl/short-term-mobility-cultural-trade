. tempname H1

. postfile `H1' str90 id double value str4 kind using "${PC}/rep_full_cs.dta", replace
(file <PACKAGE_ROOT>/05_output/10_analysis/corrected2x/pc/rep_full_cs.dta not found)

. local j 0

. foreach est in ORIG_VIS ORIG_TOUR CS_VIS CS_TOUR {
  2.     local ++j
  3.     quietly estimates restore `est'
  4.     local var = cond(inlist("`est'", "ORIG_VIS", "CS_VIS"), "mob_bilat_vis", "mob_bilat_tour")
  5.     local lab = cond(inlist("`est'", "ORIG_VIS", "CS_VIS"), "Bilateral visitors", "Bilateral tourists")
  6.     post `H1' ("CS.c`j'.`lab'.b") (_b[`var']) ("b")
  7.     post `H1' ("CS.c`j'.`lab'.se") (_se[`var']) ("se")
  8.     post `H1' ("CS.c`j'.N.N") (e(N)) ("N")
  9.     post `H1' ("CSK.`=cond(strpos("`est'","VIS"),"visitors","tourists")'.`=cond(strpos("`est'","ORIG"),"own","exact")'.b") (_b[`var']) ("b")
 10.     post `H1' ("CSK.`=cond(strpos("`est'","VIS"),"visitors","tourists")'.`=cond(strpos("`est'","ORIG"),"own","exact")'.se") (_se[`var']) ("se")
 11. }

. postclose `H1'

. do "02b_pc_programs.do"

. /*******************************************************************************
>  02b_pc_programs.do -- harvesting programs for 02_positive_controls.do.
>  Re-run after every original do-file that executes "clear all" (which drops programs).
>  Reporting per the authors' ppmlhdfe reporting notes (checklist items 2-3) and the installed
>  help: ppmlhdfe.sthlp / reghdfe.sthlp stored results e(N), e(N_full), e(num_singletons),
>  e(num_separated), e(N_clustervars), e(N_clust), e(N_clust#), e(converged), e(ic),
>  e(separation). Every fit must have e(converged)==1 (asserted); for ppmlhdfe the installed
>  accounting N_full = N + num_singletons + num_separated is asserted.
> *******************************************************************************/
. capture program drop _hc

. program define _hc
  1.     * counts of the CURRENT e() into postfile handle `chandle'
.     args chandle item est
  2.     assert e(converged) == 1
  3.     if "`e(cmd)'" == "ppmlhdfe" assert e(N_full) == e(N) + e(num_singletons) + e(num_separated)
  4.     post `chandle' ("`item'") ("`est'") ("`e(cmd)'") (e(N)) (e(N_full)) (e(num_singletons)) (e(num_separated)) ///
>         (e(N_clustervars)) (e(N_clust)) (e(N_clust1)) (e(N_clust2)) (e(converged)) (e(ic)) ("`e(separation)'")
  5. end

. capture program drop _hb

. program define _hb
  1.     * post b and se of one coefficient of a stored estimate under the esttab row label
.     args handle tab col est var label
  2.     quietly estimates restore `est'
  3.     post `handle' ("`tab'.c`col'.`label'.b") (_b[`var']) ("b")
  4.     post `handle' ("`tab'.c`col'.`label'.se") (_se[`var']) ("se")
  5. end

. capture program drop _hn

. program define _hn
  1.     * post N of a stored estimate and its estimator counts (asserting convergence)
.     args handle chandle tab col est
  2.     quietly estimates restore `est'
  3.     post `handle' ("`tab'.c`col'.N.N") (e(N)) ("N")
  4.     _hc `chandle' "`tab'.c`col'" "`est'"
  5. end

. global PC_COUNTS_SPEC "str40 item str16 est str12 cmd double N N_full num_singletons num_separated N_clustervars N_clust N_clust1 N_clust2 converged ic str24 separation"

. 
end of do-file

. tempname C1

. postfile `C1' ${PC_COUNTS_SPEC} using "${PC}/estimation_counts_cs.dta", replace
(file <PACKAGE_ROOT>/05_output/10_analysis/corrected2x/pc/estimation_counts_cs.dta not found)

. local j 0

. foreach est in ORIG_VIS ORIG_TOUR CS_VIS CS_TOUR {
  2.     local ++j
  3.     quietly estimates restore `est'
  4.     _hc `C1' "CS.c`j'" "`est'"
  5. }

. postclose `C1'

. 
. *==============================================================================
. * 2. Formal equality (original 02_formal_equality_visitors_tourists.do, unmodified)
. *==============================================================================
. log close pc
