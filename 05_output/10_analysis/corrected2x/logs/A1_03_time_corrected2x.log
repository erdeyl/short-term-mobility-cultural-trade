. *==============================================================================
. * A1.8 Table 7 Panel F: File S1 T7 reproduced (no if-condition; run_tests.do:213-217)
. *      + A1.7 lead power with pair trends (same-sample static contemporaneous coefficient)
. *==============================================================================
. foreach m in vis tour {
  2.     capture noisily ppmlhdfe v_ttl_k lag_bilat_`m' mob_bilat_`m' lead_bilat_`m', absorb(${FE}) vce(cluster pair_id)
  3.     A1_after, rc(`=_rc') item(A1.8) spec(T7_none) sample(all_rows) mobility(`m') terms(lag_bilat_`m' mob_bilat_`m' lead_bilat_`m') gen(__s0)
  4.     display as result "A1.8_T7_NONE `m' N=" e(N) " N_full=" e(N_full) " singletons=" e(num_singletons) " separated=" e(num_separated) " absvars=`e(extended_absvars)'"
  5.     capture noisily ppmlhdfe v_ttl_k lag_bilat_`m' mob_bilat_`m' lead_bilat_`m', absorb(`FET') vce(cluster pair_id)
  6.     A1_after, rc(`=_rc') item(A1.8) spec(T7_pair) sample(all_rows) mobility(`m') terms(lag_bilat_`m' mob_bilat_`m' lead_bilat_`m') gen(__s1) ///
>         note("absorb(exporter_year importer_year pair_id##c.time_c), File S1 run_tests.do:216")
  7.     display as result "A1.8_T7_PAIR `m' N=" e(N) " N_full=" e(N_full) " singletons=" e(num_singletons) " separated=" e(num_separated) ///
>         " N_hdfe=" e(N_hdfe) " N_hdfe_extended=" e(N_hdfe_extended) " absvars=`e(extended_absvars)'"
  8.     local blead = _b[lead_bilat_`m']
  9.     local slead = _se[lead_bilat_`m']
 10.     local bcur = _b[mob_bilat_`m']
 11.     local nt = e(N)
 12.     if "${VINTAGE}" == "submitted" {
 13.         * positive control: File S1 estimates.csv rows T7 lead_pair_* / current_pair_* (8 significant digits)
.         local pl = cond("`m'" == "vis", -0.01661386, 0.10155301)
 14.         local pc = cond("`m'" == "vis", 0.33408231, 0.11122672)
 15.         local pn = cond("`m'" == "vis", 13320, 19122)
 16.         assert abs(`blead' - `pl') < 1e-7 & abs(`bcur' - `pc') < 1e-7 & `nt' == `pn'
 17.         display as result "A1.8_PC_FILE_S1_T7_PAIR_`m' PASS"
 18.     }
 19.     A1_trenddiag `DD' A1.8 T7_pair `m' __s0 __s1 `=e(num_singletons)' `=e(num_separated)'
 20.     A1_trendsep `SPX' A1.8 T7_pair `m' 1 "lag_bilat_`m' mob_bilat_`m' lead_bilat_`m'"
 21.     * same-sample static contemporaneous coefficient with pair trends
.     capture noisily ppmlhdfe v_ttl_k mob_bilat_`m' if __s1, absorb(`FET') vce(cluster pair_id)
 22.     A1_after, rc(`=_rc') item(A1.7) spec(static_on_dyn_pairtrend) sample(T7_pair e(sample)) mobility(`m') terms(mob_bilat_`m')
 23.     local bstat = _b[mob_bilat_`m']
 24.     local nst = e(N)
 25.     foreach ref in static_same_sample current_in_T3 {
 26.         local br = cond("`ref'" == "static_same_sample", `bstat', `bcur')
 27.         foreach sh in 0.5 1 {
 28.             foreach a in 0.05 0.10 {
 29.                 local z = invnormal(1 - `a' / 2)
 30.                 local d = abs(`sh' * `br')
 31.                 local pw = normal(`d' / `slead' - `z') + normal(-`d' / `slead' - `z')
 32.                 local lo = `blead' - invnormal(0.95) * `slead'
 33.                 local hi = `blead' + invnormal(0.95) * `slead'
 34.                 post `LP' ("`m'") ("pair") ("`ref'") (`blead') (`slead') (`br') (`sh') (`d') (`a') (`z') (`pw') (`lo') (`hi') (`lo' / `br') (`hi' / `br') (`nt')
 35.             }
 36.         }
 37.     }
 38.     drop __s0 __s1
 39. }
