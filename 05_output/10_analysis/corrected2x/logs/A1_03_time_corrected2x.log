. * --- directed-pair linear trends: bilateral and joint directional baselines
. foreach m in vis tour {
  2.     foreach mod in bilat dir {
  3.         local X = cond("`mod'" == "bilat", "mob_bilat_`m'", "mob_rev_`m' mob_same_`m'")
  4.         capture noisily ppmlhdfe v_ttl_k `X' if has_both_`m', absorb(${FE}) vce(cluster pair_id)
  5.         A1_after, rc(`=_rc') item(A1.6) spec(`mod'_notrend) sample(has_both_`m') mobility(`m') terms(`X') gen(__s0)
  6.         capture noisily ppmlhdfe v_ttl_k `X' if has_both_`m', absorb(`FET') vce(cluster pair_id)
  7.         A1_after, rc(`=_rc') item(A1.6) spec(`mod'_pairtrend) sample(has_both_`m') mobility(`m') terms(`X') gen(__s1) ///
>             note("absorb(exporter_year importer_year pair_id##c.time_c)")
  8.         display as result "A1.6_TREND_ABSVARS `m' `mod': `e(extended_absvars)' N_hdfe_extended=" e(N_hdfe_extended)
  9.         A1_trenddiag `DD' A1.6 `mod'_pairtrend `m' __s0 __s1 `=e(num_singletons)' `=e(num_separated)'
 10.         if "`mod'" == "dir" {
 11.             quietly test mob_rev_`m' = mob_same_`m'
 12.             A1_posttest, item(A1.6) spec(dir_pairtrend_test) sample(has_both_`m') mobility(`m') term(rev_eq_same) ///
>                 stat(`r(chi2)') df(`r(df)') p(`r(p)') nobs(`=e(N)') nfull(`=e(N_full)') ncl(`=e(N_clust)') clv(pair_id) ///
>                 note("Wald chi2 H0 b_rev=b_same within the pair-trend model")
 13.         }
 14.         A1_trendsep `SPX' A1.6 `mod'_pairtrend `m' has_both_`m' "`X'"
 15.         drop __s0 __s1
 16.     }
 17.     * syntax-equivalence check against the alternative form pair_id pair_id#c.year (bilateral only)
.     capture noisily ppmlhdfe v_ttl_k mob_bilat_`m' if has_both_`m', absorb(exporter_year importer_year pair_id pair_id#c.year) vce(cluster pair_id)
 18.     A1_after, rc(`=_rc') item(A1.6) spec(bilat_pairtrend_altsyntax) sample(has_both_`m') mobility(`m') terms(mob_bilat_`m') ///
>         note("absorb(exporter_year importer_year pair_id pair_id#c.year): alternative form; equivalence check only")
 19. }
