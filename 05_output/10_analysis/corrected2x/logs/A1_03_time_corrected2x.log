. gen double time_c = year - 2007

. local FET "exporter_year importer_year pair_id##c.time_c"

. 
. * --- diagnostics of rows dropped when trends are added: pair classification on the
. *     no-trend sample (pairs with one positive observation at the first or last sample year,
. *     with zeros elsewhere, are separated by a pair-specific linear trend in the log mean)
. tempname DD

. postfile `DD' str6 item str40 model str5 mobility double(n_notrend n_trend rows_dropped pairs_dropped ///
>     dp_2obs dp_endpt_1pos dp_other nt_pairs_endpt_1pos ///
>     nt_pairs_2obs_1zero sing_trend sep_trend) using "${OUT}/tables/A1_A1.6_8_trend_drop_diag.dta", replace
(file <PACKAGE_ROOT>/05_output/10_analysis/corrected2x/tables/A1_A1.6_8_trend_drop_diag.dta not found)

. capture program drop A1_trenddiag

. program define A1_trenddiag
  1.     args handle item model mob s0 s1 nsing nsep
  2.     tempvar n np tmin tmax tpos one drop dp tg ep
  3.     quietly {
  4.         bysort pair_id: egen `n' = total(`s0')
  5.         bysort pair_id: egen `np' = total(`s0' & v_ttl_k > 0)
  6.         bysort pair_id: egen `tmin' = min(cond(`s0', year, .))
  7.         bysort pair_id: egen `tmax' = max(cond(`s0', year, .))
  8.         bysort pair_id: egen `tpos' = max(cond(`s0' & v_ttl_k > 0, year, .))
  9.         gen byte `ep' = `np' == 1 & (`tpos' == `tmin' | `tpos' == `tmax')
 10.         gen byte `drop' = `s0' & !`s1'
 11.         bysort pair_id: egen byte `dp' = max(`drop')
 12.         egen byte `tg' = tag(pair_id) if `s0'
 13.         count if `s0'
 14.         local a = r(N)
 15.         count if `s1'
 16.         local b = r(N)
 17.         count if `drop'
 18.         local c = r(N)
 19.         count if `tg' == 1 & `dp' == 1
 20.         local d = r(N)
 21.         count if `tg' == 1 & `dp' == 1 & `n' == 2
 22.         local e = r(N)
 23.         count if `tg' == 1 & `dp' == 1 & `ep' & `n' != 2
 24.         local f = r(N)
 25.         count if `tg' == 1 & `dp' == 1 & !`ep' & `n' != 2
 26.         local g = r(N)
 27.         count if `tg' == 1 & `ep'
 28.         local h = r(N)
 29.         count if `tg' == 1 & `n' == 2 & `np' == 1
 30.         local i = r(N)
 31.     }
 32.     post `handle' ("`item'") ("`model'") ("`mob'") (`a') (`b') (`c') (`d') (`e') (`f') (`g') (`h') (`i') (`nsing') (`nsep')
 33.     display as result "A1_TRENDDIAG `item' `model' `mob': notrend=`a' trend=`b' rows_dropped=`c' pairs_dropped=`d' (2obs `e', endpoint-single-positive `f', other `g'); notrend pairs endpoint-sing
> le-positive `h'; 2obs-one-zero `i'"
 34. end

. 
. * --- separation check for trend fits: ppmlhdfe's default separation(fe simplex ir) may leave
. *     separated rows in a model with absorbed slopes; such rows show as zero-trade rows whose fitted
. *     eta keeps falling (mu -> 0). Untrended fits here converge with min(eta) about -22 to -26, so
. *     eta < -30 (mu < 1e-13 thousand USD) marks numerically separated rows. Two refits:
. *     (a) excluding those rows; (b) adding ppmlhdfe's "mu" separation method (help ppmlhdfe:
. *     separation(string) "Valid options are fe, ir, simplex, and mu (or any combination of those)").
. tempname SPX

. postfile `SPX' str6 item str40 model str5 mobility double(N_default zero_rows eta_lt20 eta_lt30 eta_lt50 min_eta) ///
>     using "${OUT}/tables/A1_A1.6_8_trend_separation.dta", replace
(file <PACKAGE_ROOT>/05_output/10_analysis/corrected2x/tables/A1_A1.6_8_trend_separation.dta not found)

. capture program drop A1_trendsep

. program define A1_trendsep
  1.     args handle item spec m cond X
  2.     tempvar dsum eta nsep
  3.     capture noisily ppmlhdfe v_ttl_k `X' if `cond', absorb(exporter_year importer_year pair_id##c.time_c) vce(cluster pair_id) d(`dsum')
  4.     if _rc != 0 | e(converged) != 1 {
  5.         display as error "A1_TRENDSEP refit with d() failed `item' `spec' `m'"
  6.         exit
  7.     }
  8.     local N0 = e(N)
  9.     quietly predict double `eta' if e(sample), eta
 10.     quietly count if e(sample) & v_ttl_k == 0
 11.     local z0 = r(N)
 12.     foreach t in 20 30 50 {
 13.         quietly count if e(sample) & v_ttl_k == 0 & `eta' < -`t'
 14.         local c`t' = r(N)
 15.     }
 16.     quietly summarize `eta' if e(sample), meanonly
 17.     local mn = r(min)
 18.     post `handle' ("`item'") ("`spec'") ("`m'") (`N0') (`z0') (`c20') (`c30') (`c50') (`mn')
 19.     gen byte `nsep' = e(sample) & v_ttl_k == 0 & `eta' < -30
 20.     capture noisily ppmlhdfe v_ttl_k `X' if `cond' & !`nsep', absorb(exporter_year importer_year pair_id##c.time_c) vce(cluster pair_id)
 21.     A1_after, rc(`=_rc') item(`item') spec(`spec'_exnumsep) sample(`cond' & eta>=-30) mobility(`m') terms(`X') ///
>         note("pair trends; excluding `c30' zero-trade rows with fitted eta < -30 in the default fit")
 22.     capture noisily ppmlhdfe v_ttl_k `X' if `cond', absorb(exporter_year importer_year pair_id##c.time_c) vce(cluster pair_id) separation(fe simplex ir mu)
 23.     A1_after, rc(`=_rc') item(`item') spec(`spec'_sepmu) sample(`cond') mobility(`m') terms(`X') ///
>         note("pair trends; separation(fe simplex ir mu)")
 24.     display as result "A1_TRENDSEP `item' `spec' `m': N_default=`N0' zero_rows=`z0' eta<-20:`c20' eta<-30:`c30' eta<-50:`c50' min_eta=`mn'"
 25. end

. 
. *==============================================================================
. * A1.6 time windows
. *==============================================================================
. tempname TW

. postfile `TW' str5 mobility str24 window double(base_rows base_rows_excluded share_excluded) using "${OUT}/tables/A1_A1.6_window_shares.dta", replace
(file <PACKAGE_ROOT>/05_output/10_analysis/corrected2x/tables/A1_A1.6_window_shares.dta not found)

. local w_2007_2019  "year <= 2019"

. local w_ex2009     "year != 2009"

. local w_ex2020_21  "!inrange(year, 2020, 2021)"

. local w_ex0809_2021 "!inlist(year, 2008, 2009, 2020, 2021)"

. local w_ex2008_2020 "!inlist(year, 2008, 2020)"

. foreach m in vis tour {
  2.     quietly count if s_base_`m'
  3.     local nb = r(N)
  4.     foreach w in 2007_2019 ex2009 ex2020_21 ex0809_2021 ex2008_2020 {
  5.         quietly count if s_base_`m' & !(`w_`w'')
  6.         post `TW' ("`m'") ("`w'") (`nb') (r(N)) (r(N) / `nb')
  7.         capture noisily ppmlhdfe v_ttl_k mob_bilat_`m' if has_both_`m' & `w_`w'', absorb(${FE}) vce(cluster pair_id)
  8.         A1_after, rc(`=_rc') item(A1.6) spec(win_`w') sample(has_both_`m' & `w_`w'') mobility(`m') terms(mob_bilat_`m')
  9.         if "`w'" == "ex2008_2020" {
 10.             * positive control: submitted/corrected Table 6 cols 5-6 (08_table6_robustness.do:33-36)
.             local c = cond("`m'" == "vis", 5, 6)
 11.             assert abs(_b[mob_bilat_`m'] - ${PC_T6c`c'b}) < 1e-6
 12.             assert e(N) == ${PC_T6c`c'N}
 13.             display as result "A1.6_PC_TABLE6_COL`c' PASS b=" _b[mob_bilat_`m'] " N=" e(N)
 14.         }
 15.     }
 16. }
