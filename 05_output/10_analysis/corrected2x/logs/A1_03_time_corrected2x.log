. 
. *==============================================================================
. * A1.7 static baseline on the dynamic (Table 3) sample, nested dynamic models
. *==============================================================================
. tempname LP

. postfile `LP' str5 mobility str10 trend str20 reference double(b_lead se_lead b_ref d_share d alpha z power ci90_lo ci90_hi ///
>     ci90_lo_share ci90_hi_share N) using "${OUT}/tables/A1_A1.7_lead_power.dta", replace
(file <PACKAGE_ROOT>/05_output/10_analysis/corrected2x/tables/A1_A1.7_lead_power.dta not found)

. foreach m in vis tour {
  2.     quietly count if s_dyn_`m'
  3.     local nd = r(N)
  4.     capture noisily ppmlhdfe v_ttl_k mob_bilat_`m' if s_dyn_`m', absorb(${FE}) vce(cluster pair_id)
  5.     A1_after, rc(`=_rc') item(A1.7) spec(static_on_dyn) sample(s_dyn_`m') mobility(`m') terms(mob_bilat_`m')
  6.     assert e(N) == `nd'
  7.     local bstat = _b[mob_bilat_`m']
  8.     capture noisily ppmlhdfe v_ttl_k lag_bilat_`m' mob_bilat_`m' lead_bilat_`m' if s_dyn_`m', absorb(${FE}) vce(cluster pair_id)
  9.     A1_after, rc(`=_rc') item(A1.7) spec(T3_lag_cur_lead) sample(s_dyn_`m') mobility(`m') terms(lag_bilat_`m' mob_bilat_`m' lead_bilat_`m')
 10.     assert e(N) == `nd'
 11.     local c = cond("`m'" == "vis", 1, 2)
 12.     assert abs(_b[mob_bilat_`m'] - ${PC_T3c`c'b}) < 1e-6
 13.     assert abs(_b[lead_bilat_`m'] - ${PC_T3c`c'lead}) < 1e-6
 14.     assert e(N) == ${PC_T3c`c'N}
 15.     display as result "A1.7_PC_TABLE3_COL`c' PASS"
 16.     local blead = _b[lead_bilat_`m']
 17.     local slead = _se[lead_bilat_`m']
 18.     local bcur = _b[mob_bilat_`m']
 19.     capture noisily ppmlhdfe v_ttl_k lag_bilat_`m' mob_bilat_`m' if s_dyn_`m', absorb(${FE}) vce(cluster pair_id)
 20.     A1_after, rc(`=_rc') item(A1.7) spec(lag_cur) sample(s_dyn_`m') mobility(`m') terms(lag_bilat_`m' mob_bilat_`m')
 21.     assert e(N) == `nd'
 22.     capture noisily ppmlhdfe v_ttl_k mob_bilat_`m' lead_bilat_`m' if s_dyn_`m', absorb(${FE}) vce(cluster pair_id)
 23.     A1_after, rc(`=_rc') item(A1.7) spec(cur_lead) sample(s_dyn_`m') mobility(`m') terms(mob_bilat_`m' lead_bilat_`m')
 24.     assert e(N) == `nd'
 25.     * lead-test power, no trends
.     foreach ref in static_same_sample current_in_T3 {
 26.         local br = cond("`ref'" == "static_same_sample", `bstat', `bcur')
 27.         foreach sh in 0.5 1 {
 28.             foreach a in 0.05 0.10 {
 29.                 local z = invnormal(1 - `a' / 2)
 30.                 local d = abs(`sh' * `br')
 31.                 local pw = normal(`d' / `slead' - `z') + normal(-`d' / `slead' - `z')
 32.                 local lo = `blead' - invnormal(0.95) * `slead'
 33.                 local hi = `blead' + invnormal(0.95) * `slead'
 34.                 post `LP' ("`m'") ("none") ("`ref'") (`blead') (`slead') (`br') (`sh') (`d') (`a') (`z') (`pw') (`lo') (`hi') (`lo' / `br') (`hi' / `br') (`nd')
 35.             }
 36.         }
 37.     }
 38. }
