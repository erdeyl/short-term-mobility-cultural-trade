. global DIAG     "${ROOT}/05_output/03_Mobility/01_diagnostics/sensitivity/03_ppml_bias_correction"

. global LOGS     "${ROOT}/05_output/03_Mobility/03_logs/sensitivity/03_ppml_bias_correction"

