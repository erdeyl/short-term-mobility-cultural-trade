. capture program drop _grid

. program define _grid
  1.     * slope b + (v - c) g on NG points between min and max of the moderator over touse; e(V) block
.     args G panel mob ix c touse ng mlab
  2.     tempname V
  3.     matrix `V' = e(V)
  4.     local bb = _b[`mob']
  5.     local gg = _b[`ix']
  6.     local vbb = `V'[rownumb(`V', "`mob'"), colnumb(`V', "`mob'")]
  7.     local vgg = `V'[rownumb(`V', "`ix'"), colnumb(`V', "`ix'")]
  8.     local vbg = `V'[rownumb(`V', "`mob'"), colnumb(`V', "`ix'")]
  9.     quietly summarize cul_dist if `touse'
 10.     local lo = r(min)
 11.     local hi = r(max)
 12.     local nn = e(N)
 13.     local z = invnormal(0.975)
 14.     forvalues k = 1/`ng' {
 15.         local v = `lo' + (`k' - 1) * (`hi' - `lo') / (`ng' - 1)
 16.         local s = `bb' + (`v' - `c') * `gg'
 17.         local se = sqrt(`vbb' + 2 * (`v' - `c') * `vbg' + (`v' - `c')^2 * `vgg')
 18.         post `G' ("`panel'") ("`mlab'") (`k') (`v') (`s') (`se') (`s' - `z' * `se') (`s' + `z' * `se') (`c') (`nn')
 19.         if mod(`k' - 1, 20) == 0 {
 20.             quietly lincom `mob' + (`v' - `c') * `ix'
 21.             assert abs(r(estimate) - `s') < 1e-10 & abs(r(se) - `se') < 1e-10
 22.         }
 23.     }
 24. end

. 
. capture program drop _bins

. program define _bins
  1.     * 20 equal-width bins between min and max over touse; full-precision endpoints; clamped to [1, 20]
.     args B panel touse nexp
  2.     tempname slo sw
  3.     quietly summarize cul_dist if `touse'
  4.     scalar `slo' = r(min)
  5.     scalar `sw' = (r(max) - r(min)) / 20
  6.     local ntot = r(N)
  7.     tempvar bin
  8.     quietly gen int `bin' = max(1, min(20, 1 + floor((cul_dist - scalar(`slo')) / scalar(`sw')))) if `touse'
  9.     local nsum 0
 10.     forvalues b = 1/20 {
 11.         quietly count if `touse' & `bin' == `b'
 12.         local nsum = `nsum' + r(N)
 13.         post `B' ("`panel'") (`b') (scalar(`slo') + (`b' - 1) * scalar(`sw')) (scalar(`slo') + `b' * scalar(`sw')) (r(N)) (`ntot')
 14.     }
 15.     assert `nsum' == `ntot'
 16.     assert `ntot' == `nexp'
 17.     drop `bin'
 18. end

. 
. capture program drop _pcheck

. program define _pcheck
  1.     * lincom at the 7 percentiles (same _pctile call as A2_5.do a2_slopes) vs the A2.csv rows
.     args K refs panel spec mobility mob ix c touse
  2.     preserve
  3.         use `refs', clear
  4.         foreach q in 5 10 25 50 75 90 95 {
  5.             quietly count if spec == "`spec'" & mobility == "`mobility'" & q == `q'
  6.             assert r(N) == 1
  7.             quietly summarize b if spec == "`spec'" & mobility == "`mobility'" & q == `q', meanonly
  8.             local rb_`q' = r(mean)
  9.             quietly summarize se if spec == "`spec'" & mobility == "`mobility'" & q == `q', meanonly
 10.             local rs_`q' = r(mean)
 11.         }
 12.     restore
 13.     quietly _pctile cul_dist if `touse', percentiles(5 10 25 50 75 90 95)
 14.     local k 0
 15.     foreach q in 5 10 25 50 75 90 95 {
 16.         local ++k
 17.         local v_`q' = r(r`k')
 18.     }
 19.     foreach q in 5 10 25 50 75 90 95 {
 20.         quietly lincom `mob' + (`v_`q'' - `c') * `ix'
 21.         local est = r(estimate)
 22.         local se = r(se)
 23.         local rb = `rb_`q''
 24.         local rs = `rs_`q''
 25.         local d1 = abs(`est' - `rb')
 26.         local d2 = abs(`se' - `rs')
 27.         post `K' ("`panel'") ("`mobility'") ("slope p`q'") (`est') (`rb') (`d1') (cond(`d1' < 1e-6, "PASS", "FAIL"))
 28.         post `K' ("`panel'") ("`mobility'") ("SE p`q'") (`se') (`rs') (`d2') (cond(`d2' < 1e-6, "PASS", "FAIL"))
 29.         assert `d1' < 1e-6 & `d2' < 1e-6
 30.         display as result "FIG_03_PC `panel' `mobility' p`q' slope=" %10.6f `est' " ref=" %10.6f `rb' " se=" %10.6f `se' " ref=" %10.6f `rs'
 31.     }
 32. end

