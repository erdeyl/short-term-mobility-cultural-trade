. foreach m in vis tour {
  2.     local mlab = cond("`m'" == "vis", "visitors", "tourists")
  3.     local panel = cond("`m'" == "vis", "a_own_vis", "b_own_tour")
  4.     gen byte cand_`m' = has_both_`m' & !missing(v_ttl_k, mob_bilat_`m', cul_dist)
  5.     quietly summarize cul_dist if cand_`m'
  6.     local c0 = r(mean)
  7.     gen double ix0_`m' = mob_bilat_`m' * (cul_dist - `c0') if cand_`m'
  8.     quietly ppmlhdfe v_ttl_k mob_bilat_`m' ix0_`m' if cand_`m', absorb(`FE') vce(cluster pair_id)
  9.     a2_chk "FIG_03 own `mlab' eligible centring"
 10.     gen byte own_`m' = e(sample)
 11.     assert own_`m' == s_cd_`m'
 12.     * realized-sample centring (A2_5.do: re-centre until e(sample) is unchanged)
.     quietly summarize cul_dist if own_`m'
 13.     local c1 = r(mean)
 14.     gen byte es_`m' = own_`m'
 15.     local stable 0
 16.     local it 0
 17.     while `stable' == 0 {
 18.         local ++it
 19.         if `it' > 10 error 430
 20.         capture drop ix1_`m'
 21.         gen double ix1_`m' = mob_bilat_`m' * (cul_dist - `c1') if cand_`m'
 22.         quietly ppmlhdfe v_ttl_k mob_bilat_`m' ix1_`m' if cand_`m', absorb(`FE') vce(cluster pair_id)
 23.         a2_chk "FIG_03 own `mlab' realized centring iteration `it'"
 24.         tempvar e1
 25.         gen byte `e1' = e(sample)
 26.         quietly count if `e1' != es_`m'
 27.         if r(N) == 0 local stable 1
 28.         else {
 29.             quietly replace es_`m' = `e1'
 30.             quietly summarize cul_dist if es_`m'
 31.             local c1 = r(mean)
 32.         }
 33.         drop `e1'
 34.     }
 35.     quietly count if es_`m'
 36.     local nreal = r(N)
 37.     display as result "FIG_03 `panel' c=" %12.9f `c1' " N=`nreal' b=" %12.9f _b[mob_bilat_`m'] " g=" %12.9f _b[ix1_`m']
 38.     _grid `G' `panel' mob_bilat_`m' ix1_`m' `c1' es_`m' `NG' `mlab'
 39.     _pcheck `K' `refs' `panel' cd_own_slopes `mlab' mob_bilat_`m' ix1_`m' `c1' es_`m'
 40.     _bins `B' `panel' es_`m' `nreal'
 41. }
