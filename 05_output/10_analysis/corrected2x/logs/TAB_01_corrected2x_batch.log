. * ---------------------------------------------------------------- T5 (strict part): cultural distance with all six dimensions
. foreach m in vis tour {
  2.     quietly summarize cd6_strict if has_both_`m' & !missing(v_ttl_k, cd6_strict), meanonly
  3.     gen double strict_center = cd6_strict - r(mean)
  4.     gen double strict_x = mob_bilat_`m' * strict_center
  5.     quietly ppmlhdfe v_ttl_k mob_bilat_`m' strict_x if has_both_`m' & !missing(cd6_strict), absorb(`FE') vce(cluster pair_id)
  6.     nflow est "TAB T5 strict6 first fit `m'"
  7.     gen byte strict_sample = e(sample)
  8.     quietly summarize cd6_strict if strict_sample, meanonly
  9.     local cmean = r(mean)
 10.     quietly replace strict_center = cd6_strict - r(mean)
 11.     quietly replace strict_x = mob_bilat_`m' * strict_center
 12.     quietly ppmlhdfe v_ttl_k mob_bilat_`m' strict_x if strict_sample, absorb(`FE') vce(cluster pair_id)
 13.     nflow est "TAB T5 strict6 refit `m'"
 14.     tab_post, item(T5) spec(strict6_mobility) sample(strict_sample) term(mob_bilat_`m') note("mobility slope at the retained-sample mean of cd6_strict (`cmean')")
 15.     tab_post, item(T5) spec(strict6_interaction) sample(strict_sample) term(strict_x) note("interaction with centred cd6_strict; all six Hofstede dimensions observed")
 16.     drop strict_center strict_x strict_sample
 17. }
