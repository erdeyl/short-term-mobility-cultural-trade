. * ---------------------------------------------------------------- T11: Table 7 Panel B, top 0.1% of directional flows
. foreach m in vis tour {
  2.     foreach mode in directional bilateral {
  3.         local raw "rev_`m'_raw"
  4.         if "`mode'" == "bilateral" local raw "bilat_`m'_raw"
  5.         quietly _pctile `raw' if has_both_`m' & !missing(v_ttl_k), p(99.9)
  6.         local cutoff = r(r1)
  7.         gen byte __trim = has_both_`m' & !missing(v_ttl_k) & `raw' > `cutoff'
  8.         local cnote "cutoff=`cutoff'"
  9.         if "`mode'" == "directional" {
 10.             quietly _pctile same_`m'_raw if has_both_`m' & !missing(v_ttl_k), p(99.9)
 11.             local scut = r(r1)
 12.             quietly replace __trim = 1 if has_both_`m' & !missing(v_ttl_k) & same_`m'_raw > `scut'
 13.             local cnote "reverse cutoff=`cutoff'; same cutoff=`scut'"
 14.         }
 15.         quietly count if __trim
 16.         local dn = r(N)
 17.         quietly ppmlhdfe v_ttl_k mob_bilat_`m' if has_both_`m' & !__trim, absorb(`FE') vce(cluster pair_id)
 18.         nflow est "TAB T11 trim_`mode'_`m'"
 19.         tab_post, item(T11) spec(trim_`mode') sample(has_both_`m' & !trim) term(mob_bilat_`m') note("Above 99.9th percentile of `mode' flow; `cnote'; candidate exclusions=`dn'")
