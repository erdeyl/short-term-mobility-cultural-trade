. capture program drop tab_post

. program define tab_post
  1.     * tab_post, item() spec() sample() term() [note()]  -- records the current ppmlhdfe/lincom of `term'
.     syntax, item(string) spec(string) sample(string) term(string) [note(string)]
  2.     assert "`e(cmd)'" == "ppmlhdfe"
  3.     assert e(converged) == 1
  4.     assert e(N_full) == e(N) + e(num_singletons) + e(num_separated)
  5.     local N = e(N)
  6.     local nf = e(N_full)
  7.     local ns = e(num_singletons)
  8.     local nsep = e(num_separated)
  9.     local ncl = e(N_clust)
 10.     local cv "`e(clustvar)'"
 11.     quietly lincom `term', level(95)
 12.     local b = r(estimate)
 13.     local se = r(se)
 14.     local p = r(p)
 15.     local lo95 = r(lb)
 16.     local hi95 = r(ub)
 17.     quietly lincom `term', level(90)
 18.     local lo90 = r(lb)
 19.     local hi90 = r(ub)
 20.     post TABH ("${VINTAGE}") ("`item'") ("`spec'") ("`sample'") ("`term'") (`b') (`se') (`p') (`lo95') (`hi95') (`lo90') (`hi90') ///
>         (`N') (`nf') (`ns') (`nsep') (`ncl') ("`cv'") (`"`note'"')
 21.     display as result "TAB_FIT `item' `spec' `term' b=" %12.9f `b' " se=" %12.9f `se' " p=" %9.6f `p' " N=" `N' " N_full=" `nf' " singletons=" `ns' " separated=" `nsep'
 22. end

. 
. capture program drop tab_close

. program define tab_close
  1.     args dtafile csvfile
  2.     postclose TABH
  3.     preserve
  4.         use "`dtafile'", clear
  5.         format b se p ci95_lo ci95_hi ci90_lo ci90_hi N N_full n_singletons n_separated n_clusters %24.17g
  6.         export delimited using "`csvfile'", datafmt replace
  7.     restore
  8. end

