. *==============================================================================
. tempname SW

. postfile `SW' str5 measure str90 statistic double(value denominator share) str90 note ///
>     using "${OUT}/tables/A1_A1.3_switches.dta", replace
(file <PACKAGE_ROOT>/05_output/10_analysis/corrected2x_upair/tables/A1_A1.3_switches.dta not found)

. foreach m in vis tour {
  2.     * directed series = (reporter iso3_o, origin iso3_d) with a stored value; flag = COPY source-table flag
.     egen byte __tser = tag(iso3_o iso3_d) if has_rev_`m'
  3.     quietly count if __tser == 1
  4.     local nser = r(N)
  5.     quietly count if __tser == 1 & basis_switch_rev_`m' == 1
  6.     local nsw = r(N)
  7.     quietly count if __tser == 1 & missing(basis_switch_rev_`m')
  8.     local nmis = r(N)
  9.     post `SW' ("`m'") ("directed series switching basis (COPY flag basis_switch_rev)") (`nsw') (`nser') (`nsw' / `nser') ("series flag missing (unknown): `nmis'")
 10.     quietly count if has_rev_`m'
 11.     local nobs = r(N)
 12.     quietly count if has_rev_`m' & basis_switch_rev_`m' == 1
 13.     post `SW' ("`m'") ("stored observations in a switching series (COPY flag)") (r(N)) (`nobs') (r(N) / `nobs') ("")
 14.     * own recomputation on panel rows 2007-2021 (both bases appear among the series' stored rows)
.     egen byte __hr = max(has_rev_`m' & basis_rev_`m' == "residence"), by(iso3_o iso3_d)
 15.     egen byte __hn = max(has_rev_`m' & basis_rev_`m' == "nationality"), by(iso3_o iso3_d)
 16.     quietly count if __tser == 1 & __hr == 1 & __hn == 1
 17.     post `SW' ("`m'") ("directed series switching basis (recomputed on panel rows)") (r(N)) (`nser') (r(N) / `nser') ("residence and nationality both among the series' 2007-2021 panel rows")
 18.     quietly count if has_rev_`m' & __hr == 1 & __hn == 1
 19.     post `SW' ("`m'") ("stored observations in a switching series (recomputed)") (r(N)) (`nobs') (r(N) / `nobs') ("")
 20.     drop __tser __hr __hn
 21.     * bilateral observations with different bases in the two directions
.     foreach smp in has_both s_base {
 22.         local cond = cond("`smp'" == "has_both", "has_both_`m' & c_trade", "s_base_`m'")
 23.         quietly count if `cond'
 24.         local d = r(N)
 25.         quietly count if `cond' & basis_rev_`m' != basis_same_`m'
 26.         post `SW' ("`m'") ("`smp': pair-years with different bases in the two directions") (r(N)) (`d') (r(N) / `d') ("`cond'")
 27.         quietly count if `cond' & (basis_switch_rev_`m' == 1 | basis_switch_same_`m' == 1)
 28.         post `SW' ("`m'") ("`smp': pair-years where either direction's series switches basis") (r(N)) (`d') (r(N) / `d') ("COPY flags")
 29.         quietly count if `cond' & (missing(basis_switch_rev_`m') | missing(basis_switch_same_`m'))
 30.         post `SW' ("`m'") ("`smp': pair-years with a missing (unknown) switch flag") (r(N)) (`d') (r(N) / `d') ("")
 31.     }
 32.     * one-basis pairs in the baseline sample
.     egen byte __tp = tag(pair_id) if s_base_`m'
 33.     quietly count if __tp == 1
 34.     local npair = r(N)
 35.     egen byte __anysw = max(s_base_`m' & (basis_switch_rev_`m' != 0 | basis_switch_same_`m' != 0)), by(pair_id)
 36.     quietly count if __tp == 1 & __anysw == 0
 37.     post `SW' ("`m'") ("s_base directed pairs: neither direction's series switches (flags = 0)") (r(N)) (`npair') (r(N) / `npair') ("missing flag counts as switching")
 38.     egen byte __hr = max(s_base_`m' & (basis_rev_`m' == "residence" | basis_same_`m' == "residence")), by(pair_id)
 39.     egen byte __hn = max(s_base_`m' & (basis_rev_`m' == "nationality" | basis_same_`m' == "nationality")), by(pair_id)
 40.     egen byte __hu = max(s_base_`m' & (basis_rev_`m' == "PRY_unknown" | basis_same_`m' == "PRY_unknown")), by(pair_id)
 41.     quietly count if __tp == 1 & __hr + __hn + __hu == 1 & __hu == 0
 42.     post `SW' ("`m'") ("s_base directed pairs: one basis in both directions in every sample year") (r(N)) (`npair') (r(N) / `npair') ("residence-only or nationality-only on all s_base rows of the
>  pair")
 43.     quietly count if __tp == 1 & __hr == 1 & __hn == 0 & __hu == 0
 44.     post `SW' ("`m'") ("   of which residence only") (r(N)) (`npair') (r(N) / `npair') ("")
 45.     quietly count if __tp == 1 & __hr == 0 & __hn == 1 & __hu == 0
 46.     post `SW' ("`m'") ("   of which nationality only") (r(N)) (`npair') (r(N) / `npair') ("")
 47.     quietly count if s_base_`m' & __hr + __hn + __hu == 1 & __hu == 0
 48.     quietly count if s_base_`m'
 49.     local nb = r(N)
 50.     quietly count if s_base_`m' & __hr + __hn + __hu == 1 & __hu == 0
 51.     post `SW' ("`m'") ("s_base observations in one-basis pairs") (r(N)) (`nb') (r(N) / `nb') ("")
 52.     egen byte __tu = tag(unordered_pair_id) if s_base_`m' & __hr + __hn + __hu == 1 & __hu == 0
 53.     quietly count if __tu == 1
 54.     post `SW' ("`m'") ("s_base unordered pairs with at least one one-basis directed pair") (r(N)) (.) (.) ("")
 55.     * all observed years 2007-2021 (audit check): basis history over every row of the pair
.     egen byte __ar = max(basis_rev_`m' == "residence" | basis_same_`m' == "residence"), by(pair_id)
 56.     egen byte __an = max(basis_rev_`m' == "nationality" | basis_same_`m' == "nationality"), by(pair_id)
 57.     egen byte __au = max(basis_rev_`m' == "PRY_unknown" | basis_same_`m' == "PRY_unknown"), by(pair_id)
 58.     quietly count if __tp == 1 & __ar + __an + __au == 1 & __au == 0
 59.     post `SW' ("`m'") ("s_base directed pairs: one basis in both directions in all observed years 2007-2021") (r(N)) (`npair') (r(N) / `npair') ("all rows of the pair with a directional value (au
> dit R1-01)")
 60.     quietly count if s_base_`m' & __ar + __an + __au == 1 & __au == 0
 61.     post `SW' ("`m'") ("s_base observations in all-year one-basis pairs") (r(N)) (`nb') (r(N) / `nb') ("")
 62.     egen byte __tu2 = tag(unordered_pair_id) if s_base_`m' & __ar + __an + __au == 1 & __au == 0
 63.     quietly count if __tu2 == 1
 64.     post `SW' ("`m'") ("s_base unordered pairs with at least one all-year one-basis directed pair") (r(N)) (.) (.) ("")
 65.     drop __tp __anysw __hr __hn __hu __tu __ar __an __au __tu2
 66. }

