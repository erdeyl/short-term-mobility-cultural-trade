(file <PACKAGE_ROOT>/05_output/10_analysis/corrected2x_upair/tables/A1_A1.3_basis_shares.dta not found)

. foreach m in vis tour {
  2.     foreach scope in panel_stored s_base_pooled s_base_rev s_base_same {
  3.         if "`scope'" == "panel_stored" local vars "basis_rev_`m'"
  4.         if "`scope'" == "s_base_pooled" local vars "basis_rev_`m' basis_same_`m'"
  5.         if "`scope'" == "s_base_rev" local vars "basis_rev_`m'"
  6.         if "`scope'" == "s_base_same" local vars "basis_same_`m'"
  7.         local cond = cond("`scope'" == "panel_stored", "has_rev_`m'", "s_base_`m'")
  8.         local tot 0
  9.         foreach b in residence nationality PRY_unknown {
 10.             local n_`b' 0
 11.             foreach v of local vars {
 12.                 quietly count if `cond' & `v' == "`b'"
 13.                 local n_`b' = `n_`b'' + r(N)
 14.             }
 15.             local tot = `tot' + `n_`b''
 16.         }
 17.         local n_other 0
 18.         foreach v of local vars {
 19.             quietly count if `cond' & !inlist(`v', "residence", "nationality", "PRY_unknown")
 20.             local n_other = `n_other' + r(N)
 21.         }
 22.         assert `n_other' == 0
 23.         foreach b in residence nationality PRY_unknown {
 24.             post `BS' ("`scope'") ("`m'") ("`b'") (`n_`b'') (`n_`b'' / `tot')
 25.         }
 26.     }
 27. }

. postclose `BS'

