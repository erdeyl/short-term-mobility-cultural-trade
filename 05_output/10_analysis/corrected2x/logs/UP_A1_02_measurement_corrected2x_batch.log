. 
. *==============================================================================
. * A1.5 measurement vs composition
. *==============================================================================
. * --- restrictions R1-R4 (flags; candidate rows = has_both & trade observed)
. foreach m in vis tour {
  2.     gen byte __cand = has_both_`m' & c_trade
  3.     gen byte r1_`m' = basis_rev_`m' == basis_same_`m' & inlist(basis_rev_`m', "residence", "nationality")
  4.     egen byte __hr = max(__cand & (basis_rev_`m' == "residence" | basis_same_`m' == "residence")), by(pair_id)
  5.     egen byte __hn = max(__cand & (basis_rev_`m' == "nationality" | basis_same_`m' == "nationality")), by(pair_id)
  6.     egen byte __hu = max(__cand & (basis_rev_`m' == "PRY_unknown" | basis_same_`m' == "PRY_unknown")), by(pair_id)
  7.     gen byte r2_`m' = (__hr + __hn + __hu == 1) & __hu == 0
  8.     * r2all (audit check, replaces r2): the pair's basis history over EVERY year 2007-2021 in which
.     * a directional value of either direction is observed (all rows of the directed pair, before any
.     * trade or both-direction eligibility); one basis only, no PRY_unknown. r2 (candidate years only)
.     * is kept as the superseded variant.
.     egen byte __ar = max(basis_rev_`m' == "residence" | basis_same_`m' == "residence"), by(pair_id)
  9.     egen byte __an = max(basis_rev_`m' == "nationality" | basis_same_`m' == "nationality"), by(pair_id)
 10.     egen byte __au = max(basis_rev_`m' == "PRY_unknown" | basis_same_`m' == "PRY_unknown"), by(pair_id)
 11.     gen byte r2all_`m' = (__ar + __an + __au == 1) & __au == 0
 12.     assert r2all_`m' <= r2_`m' if __cand
 13.     gen byte r4_`m' = basis_switch_rev_`m' == 0 & basis_switch_same_`m' == 0
 14.     drop __cand __hr __hn __hu __ar __an __au
 15. }

. gen byte r3_vis = vis_defok == 1

. local lab_r1 "same basis in both directions (pair-year)"

. local lab_r2 "SUPERSEDED (audit R1-01; replaced by r2all): one basis for the pair, candidate years only"

. local lab_r2all "one basis for the pair (both directions, all observed years 2007-2021)"

. local lab_r3 "no confirmed tourists-only substitute in either visitor direction (vis_defok)"

. local lab_r4 "no basis switch in either direction's series (COPY flags; missing = not clean)"

. foreach m in vis tour {
  2.     capture noisily ppmlhdfe v_ttl_k mob_bilat_`m' if has_both_`m', absorb(${FE}) vce(cluster unordered_pair_id)
  3.     A1_after, rc(`=_rc') item(A1.5) spec(full) sample(has_both_`m') mobility(`m') terms(mob_bilat_`m') note("baseline, full sample")
  4.     local rl "r1 r2 r2all r4"
  5.     if "`m'" == "vis" local rl "r1 r2 r2all r3 r4"
  6.     foreach r of local rl {
  7.         gen byte __s1 = has_both_`m' & `r'_`m' == 1
  8.         gen byte __s2 = has_both_`m' & `r'_`m' != 1
  9.         A1_stack, cl(unordered_pair_id) y1(v_ttl_k) x1(mob_bilat_`m') s1(__s1) y2(v_ttl_k) x2(mob_bilat_`m') s2(__s2) ///
>             item(A1.5) spec(`r') mobility(`m') lab1(restricted) lab2(complement) note("`lab_`r''")
 10.         drop __s1 __s2
 11.     }
 12. }
