. 
. * ---------------------------------------------------------------- corrected2 / corrected2x only
. * Exporter-reported mirror file read by A1_04 / A2_01_build. corrected2: the chapter build's file (trade is
. * identical to corrected). corrected2x: the same file with both trade sides on the 30-code basket
. * (built by C2_01_mirror_ex4907.py; v_ttl_k = importer-reported 30-code value, v_ttl_exporter_lb_k
. * = exporter-reported 31-code LB minus exporter-reported HS 490700).
. if "`vintage'" == "corrected2x" global MIRROR "${OUT}/mirror_analysis_ready_ex4907.dta"

. if "`vintage'" == "corrected2"  global C2_OUTCOME "v_ttl_k = 31-code LB basket (as corrected)"

. if "`vintage'" == "corrected2x" global C2_OUTCOME "v_ttl_k = 30-code LB basket (31 codes minus HS 490700) = v_ttl_ex4907"

. 
. * ---------------------------------------------------------------- platform-neutral helpers
. * pkg_py runs the package's Python with the given arguments (quoted as on the command line). On Windows
. * the whole line is wrapped in one more pair of double quotes, because cmd /c strips the outermost pair.
. do "${CODE}/pkg_programs.do"

. * pkg_programs.do -- helper programs of the replication package (loaded by 00_config.do).
. * pkg_py <arguments>: runs the package's Python interpreter (${PYTHON}, set from PKG_PYTHON by run_all.py)
. * with the rest of the line passed verbatim to the operating system shell ([D] shell).
. * POSIX: the line is  "<python>" <arguments> . Windows: cmd /c removes the outermost pair of double quotes
. * when a line starts with a quote, so the whole line is wrapped in one extra pair (char(34)).
. capture program drop pkg_py

. program define pkg_py
  1.     version 18.0
  2.     local q ""
  3.     if c(os) == "Windows" local q = char(34)
  4.     shell `q'"${PYTHON}" `0'`q'
  5. end

. 
end of do-file

. 
end of do-file

. * UPAIR (C2_A1_12_make_upair.py): same estimates with clusters on the unordered pair; outputs go to the
. * sandbox ${OUTROOT}/${VINTAGE}_upair, inputs stay in the core folder.
. global OUT_CORE "${OUT}"

. global OUT "${OUTROOT}/${VINTAGE}_upair"

. global LOGS "${OUT}/logs"

. foreach d in "" "/logs" "/results" "/results/A1_parts" "/tables" "/pc" {
  2.     capture mkdir "${OUT}`d'"
  3. }

. version 18.0

. do "A1_00_programs.do"

. /*******************************************************************************
>  A1_00_programs.do  --  shared programs for analysis block block A1 (2026-11-03)
>  Called by the A1_* do-files after 00_config.do. Defines programs only.
> 
>  Help files consulted (installed versions): ppmlhdfe.sthlp 2.3.4 (absorb(),
>  vce(cluster), e(N_full), e(num_singletons), e(num_separated), e(converged),
>  e(sample)); [P] postfile; [R] test; [R] lincom; nflow.sthlp 1.0.1.
>  Reporting checklist: the authors' ppmlhdfe reporting notes ("Report N_full and N,
>  singleton/FE-drop and separated counts ... e(converged)").
>  Stacked equality design: PKG/02_code/02_empirical_run/02_sensitivity/
>  02_formal_equality_visitors_tourists.do lines 112-199 (expand, block-specific
>  copies of all three FE, cluster by the original pair id, reproduce separate
>  slopes to 1e-6 before testing).
> *******************************************************************************/
. 
. global FE "exporter_year importer_year pair_id"

. 
. * ---------------------------------------------------------------- results file
. capture program drop A1_open

. program define A1_open
  1.     args fname
  2.     capture mkdir "${OUT}/results"
  3.     capture mkdir "${OUT}/results/A1_parts"
  4.     capture mkdir "${OUT}/tables"
  5.     global A1PART "${OUT}/results/A1_parts/`fname'"
  6.     capture postclose A1post
  7.     postfile A1post str90 row_id str10 vintage str4 block str6 item str60 spec str60 sample ///
>         str6 mobility str40 term double(b se p ci_lo ci_hi N N_full n_singletons n_separated n_clusters) ///
>         str24 cluster_var str244 note using "${A1PART}.dta", replace
  8. end

. 
. capture program drop A1_close

. program define A1_close
  1.     postclose A1post
  2.     preserve
  3.         use "${A1PART}.dta", clear
  4.         format b se p ci_lo ci_hi %24.17g
  5.         format N N_full n_singletons n_separated n_clusters %12.0f
  6.         export delimited using "${A1PART}.csv", replace datafmt
  7.     restore
  8. end

. 
. * ---------------------------------------------------------------- one coefficient row
. capture program drop A1_post1

. program define A1_post1
  1.     syntax , item(string) spec(string) sample(string) mobility(string) term(string) [note(string)]
  2.     local rid "`item'.`spec'.`mobility'.`term'"
  3.     capture local b = _b[`term']
  4.     if _rc {
  5.         post A1post ("`rid'") ("${VINTAGE}") ("A1") ("`item'") ("`spec'") ("`sample'") ("`mobility'") ("`term'") ///
>             (.) (.) (.) (.) (.) (e(N)) (e(N_full)) (e(num_singletons)) (e(num_separated)) (e(N_clust)) ("`e(clustvar)'") ///
>             ("TERM NOT IN e(b); `note'")
  6.         exit
  7.     }
  8.     local se = _se[`term']
  9.     if `se' == 0 | missing(`se') {
 10.         post A1post ("`rid'") ("${VINTAGE}") ("A1") ("`item'") ("`spec'") ("`sample'") ("`mobility'") ("`term'") ///
>             (.) (.) (.) (.) (.) (e(N)) (e(N_full)) (e(num_singletons)) (e(num_separated)) (e(N_clust)) ("`e(clustvar)'") ///
>             ("TERM OMITTED (se=0, collinear); `note'")
 11.         exit
 12.     }
 13.     local z = `b' / `se'
 14.     local p = 2 * normal(-abs(`z'))
 15.     local lo = `b' - invnormal(0.975) * `se'
 16.     local hi = `b' + invnormal(0.975) * `se'
 17.     post A1post ("`rid'") ("${VINTAGE}") ("A1") ("`item'") ("`spec'") ("`sample'") ("`mobility'") ("`term'") ///
>         (`b') (`se') (`p') (`lo') (`hi') (e(N)) (e(N_full)) (e(num_singletons)) (e(num_separated)) (e(N_clust)) ///
>         ("`e(clustvar)'") ("`note'")
 18. end

. 
. * ---------------------------------------------------------------- after a ppmlhdfe fit
. * usage:  capture noisily ppmlhdfe ...
. *         A1_after, rc(`=_rc') item() spec() sample() mobility() terms() [gen(newvar) note()]
. capture program drop A1_after

. program define A1_after, rclass
  1.     syntax , item(string) spec(string) sample(string) mobility(string) terms(string) ///
>         [rc(integer 0) gen(name) note(string)]
  2.     return scalar ok = 0
  3.     if `rc' != 0 | e(converged) != 1 {
  4.         local why = cond(`rc' != 0, "FAILED rc=`rc'", "FAILED e(converged)!=1")
  5.         foreach t of local terms {
  6.             post A1post ("`item'.`spec'.`mobility'.`t'") ("${VINTAGE}") ("A1") ("`item'") ("`spec'") ("`sample'") ///
>                 ("`mobility'") ("`t'") (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) ("") ("`why'; `note'")
  7.         }
  8.         display as error "A1_FAIL item=`item' spec=`spec' mobility=`mobility' `why'"
  9.         if "`gen'" != "" gen byte `gen' = 0
 10.         exit
 11.     }
 12.     assert e(N_full) == e(N) + e(num_singletons) + e(num_separated)
 13.     foreach t of local terms {
 14.         A1_post1, item(`item') spec(`spec') sample(`sample') mobility(`mobility') term(`t') note(`note')
 15.     }
 16.     display as result "A1_FIT item=`item' spec=`spec' mob=`mobility' N=" e(N) " N_full=" e(N_full) ///
>         " sing=" e(num_singletons) " sep=" e(num_separated) " clusters=" e(N_clust) " conv=" e(converged)
 17.     if "`gen'" != "" gen byte `gen' = e(sample)
 18.     nflow est "A1 `item' `spec' `mobility'"
 19.     return scalar ok = 1
 20. end

. 
. * ---------------------------------------------------------------- a test row (statistic in b, df in se, p in p)
. capture program drop A1_posttest

. program define A1_posttest
  1.     syntax , item(string) spec(string) sample(string) mobility(string) term(string) stat(string) df(string) p(string) ///
>         [nobs(string) nfull(string) ncl(string) clv(string) note(string)]
  2.     foreach v in stat df p nobs nfull ncl {
  3.         local `v'_n = real("``v''")
  4.     }
  5.     post A1post ("`item'.`spec'.`mobility'.`term'") ("${VINTAGE}") ("A1") ("`item'") ("`spec'") ("`sample'") ///
>         ("`mobility'") ("`term'") (`stat_n') (`df_n') (`p_n') (.) (.) (`nobs_n') (`nfull_n') (.) (.) (`ncl_n') ("`clv'") ("`note'")
  6. end

. 
. * ---------------------------------------------------------------- a difference row from lincom
. capture program drop A1_postlincom

. program define A1_postlincom
  1.     syntax , item(string) spec(string) sample(string) mobility(string) term(string) [note(string)]
  2.     * uses r() of the lincom just run and e() of the model
.     local d = r(estimate)
  3.     local s = r(se)
  4.     local p = 2 * normal(-abs(`d' / `s'))
  5.     post A1post ("`item'.`spec'.`mobility'.`term'") ("${VINTAGE}") ("A1") ("`item'") ("`spec'") ("`sample'") ///
>         ("`mobility'") ("`term'") (`d') (`s') (`p') (`d' - invnormal(.975) * `s') (`d' + invnormal(.975) * `s') ///
>         (e(N)) (e(N_full)) (e(num_singletons)) (e(num_separated)) (e(N_clust)) ("`e(clustvar)'") ("lincom; `note'")
  6. end

. 
. * ---------------------------------------------------------------- stacked equality test of one slope across two blocks
. * Authors' design (02_formal_equality_visitors_tourists.do:112-199). Blocks may be disjoint
. * (restricted vs complement) or identical observations (two measures on the same rows).
. * Each block: separate fit of y on x with the three FE on its candidate rows; the stacked
. * model uses the separate fits' e(sample), block-specific copies of the three FE, and
. * clusters by the original id in cl() (default pair_id). The stacked slopes must reproduce
. * the separate slopes to 1e-6 (authors' line 183) before the Wald test is run. Pass 1 uses
. * the ppmlhdfe default convergence tolerance; if the 1e-6 check fails only for numerical
. * reasons, pass 2 refits all three models with tolerance(1e-11) itol(1e-12) (ppmlhdfe help,
. * Optimization: tolerance(#); itol(#) via reghdfe options). Same specification and sample.
. capture program drop A1_stack

. program define A1_stack
  1.     syntax , y1(varname) x1(varname) s1(varname) y2(varname) x2(varname) s2(varname) ///
>         item(string) spec(string) mobility(string) [cl(name) lab1(string) lab2(string) note(string) sample(string)]
  2.     if "`cl'" == "" local cl pair_id
  3.     if "`lab1'" == "" local lab1 "block1"
  4.     if "`lab2'" == "" local lab2 "block2"
  5.     if "`sample'" == "" local sample "stacked"
  6.     tempvar e1 e2
  7.     tempname E1 E2
  8.     local passed 0
  9.     local usedpass 0
 10.     forvalues pass = 1/2 {
 11.         local usedpass `pass'
 12.         local tolopt ""
 13.         if `pass' == 2 local tolopt "tolerance(1e-11) itol(1e-12)"
 14.         capture drop `e1' `e2'
 15.         capture noisily ppmlhdfe `y1' `x1' if `s1', absorb(${FE}) vce(cluster `cl') `tolopt'
 16.         local rc1 = _rc
 17.         if `rc1' == 0 & e(converged) != 1 local rc1 430
 18.         if `rc1' != 0 {
 19.             A1_after, rc(`rc1') item(`item') spec(`spec'_sep_`lab1') sample(`lab1') mobility(`mobility') terms(`x1') note("pass `pass'; rc 430 = not converged; `note'")
 20.             A1_posttest, item(`item') spec(`spec'_test) sample(`sample') mobility(`mobility') term(`lab1'_eq_`lab2') ///
>                 stat(.) df(.) p(.) note("NOT RUN: separate fit `lab1' failed (pass `pass')")
 21.             exit
 22.         }
 23.         assert e(N_full) == e(N) + e(num_singletons) + e(num_separated)
 24.         estimates store `E1'
 25.         gen byte `e1' = e(sample)
 26.         local b1 = _b[`x1']
 27.         local n1 = e(N)
 28.         nflow est "A1 `item' `spec' separate `lab1' pass `pass' (immediate record, audit R1-10)"
 29.         capture noisily ppmlhdfe `y2' `x2' if `s2', absorb(${FE}) vce(cluster `cl') `tolopt'
 30.         local rc2 = _rc
 31.         if `rc2' == 0 & e(converged) != 1 local rc2 430
 32.         if `rc2' != 0 {
 33.             estimates restore `E1'
 34.             A1_after, item(`item') spec(`spec'_sep_`lab1') sample(`lab1') mobility(`mobility') terms(`x1') note("pass `pass'; `note'")
 35.             A1_after, rc(`rc2') item(`item') spec(`spec'_sep_`lab2') sample(`lab2') mobility(`mobility') terms(`x2') note("pass `pass'; rc 430 = not converged; `note'")
 36.             A1_posttest, item(`item') spec(`spec'_test) sample(`sample') mobility(`mobility') term(`lab1'_eq_`lab2') ///
>                 stat(.) df(.) p(.) note("NOT RUN: separate fit `lab2' failed (pass `pass')")
 37.             exit
 38.         }
 39.         assert e(N_full) == e(N) + e(num_singletons) + e(num_separated)
 40.         estimates store `E2'
 41.         gen byte `e2' = e(sample)
 42.         local b2 = _b[`x2']
 43.         local n2 = e(N)
 44.         nflow est "A1 `item' `spec' separate `lab2' pass `pass' (immediate record, audit R1-10)"
 45.         local stok 0
 46.         preserve
 47.             keep if `e1' | `e2'
 48.             nflow step "A1_stack `item' `spec' pass `pass': keep rows in either separate e(sample)"
 49.             keep year iso3_o iso3_d exporter_year importer_year pair_id unordered_pair_id `y1' `x1' `y2' `x2' `e1' `e2'
 50.             gen long __rid = _n
 51.             expand 2
 52.             nflow step "A1_stack `item' `spec' pass `pass': expand 2 (one copy per block)"
 53.             bysort __rid: gen byte __block = _n
 54.             drop if (__block == 1 & !`e1') | (__block == 2 & !`e2')
 55.             nflow step "A1_stack `item' `spec' pass `pass': keep block copies inside their own e(sample)"
 56.             quietly count
 57.             assert r(N) == `n1' + `n2'
 58.             gen double __y = cond(__block == 1, `y1', `y2')
 59.             gen double __x1 = cond(__block == 1, `x1', 0)
 60.             gen double __x2 = cond(__block == 2, `x2', 0)
 61.             egen long __ey = group(exporter_year __block)
 62.             egen long __iy = group(importer_year __block)
 63.             egen long __pp = group(pair_id __block)
 64.             capture noisily ppmlhdfe __y __x1 __x2, absorb(__ey __iy __pp) vce(cluster `cl') `tolopt'
 65.             local rcs = _rc
 66.             if `rcs' == 0 & e(converged) != 1 local rcs 430
 67.             if `rcs' == 0 {
 68.                 local stok 1
 69.                 assert e(N_full) == e(N) + e(num_singletons) + e(num_separated)
 70.                 nflow est "A1 `item' `spec' stacked pass `pass'"
 71.                 local g1 = abs(_b[__x1] - `b1')
 72.                 local g2 = abs(_b[__x2] - `b2')
 73.                 local nst = e(N)
 74.                 if `g1' <= 1e-6 & `g2' <= 1e-6 & `nst' == `n1' + `n2' local passed 1
 75.                 if `nst' == `n1' + `n2' {
 76.                     local sN = e(N)
 77.                     local sNf = e(N_full)
 78.                     local sS = e(num_singletons)
 79.                     local sP = e(num_separated)
 80.                     local sC = e(N_clust)
 81.                     local sCv "`e(clustvar)'"
 82.                     forvalues k = 1/2 {
 83.                         local sb`k' = _b[__x`k']
 84.                         local ss`k' = _se[__x`k']
 85.                     }
 86.                     quietly test __x1 = __x2
 87.                     local chi2 = r(chi2)
 88.                     local df = r(df)
 89.                     local pp = r(p)
 90.                     quietly lincom __x1 - __x2
 91.                     local dd = r(estimate)
 92.                     local ds = r(se)
 93.                 }
 94.             }
 95.         restore
 96.         nflow step "A1_stack `item' `spec' pass `pass': restore"
 97.         if !`stok' {
 98.             estimates restore `E1'
 99.             A1_after, item(`item') spec(`spec'_sep_`lab1') sample(`lab1') mobility(`mobility') terms(`x1') note("pass `pass'; `note'")
100.             estimates restore `E2'
101.             A1_after, item(`item') spec(`spec'_sep_`lab2') sample(`lab2') mobility(`mobility') terms(`x2') note("pass `pass'; `note'")
102.             A1_posttest, item(`item') spec(`spec'_test) sample(`sample') mobility(`mobility') term(`lab1'_eq_`lab2') ///
>                 stat(.) df(.) p(.) note("FAILED stacked fit rc=`rcs' (pass `pass')")
103.             exit
104.         }
105.         if `passed' continue, break
106.         display as text "A1_STACK pass `pass' reproduction gaps `g1' `g2' (N `nst' vs `n1'+`n2')"
107.     }
108.     local tolnote = cond(`usedpass' == 1, "default tolerance", "tolerance(1e-11) itol(1e-12) after pass-1 gap > 1e-6")
109.     estimates restore `E1'
110.     A1_after, item(`item') spec(`spec'_sep_`lab1') sample(`lab1') mobility(`mobility') terms(`x1') note("`tolnote'; `note'")
111.     estimates restore `E2'
112.     A1_after, item(`item') spec(`spec'_sep_`lab2') sample(`lab2') mobility(`mobility') terms(`x2') note("`tolnote'; `note'")
113.     local sfx ""
114.     if !`passed' {
115.         A1_posttest, item(`item') spec(`spec'_test) sample(`sample') mobility(`mobility') term(`lab1'_eq_`lab2') ///
>             stat(.) df(.) p(.) nobs(`nst') note("NOT TESTED: stacked slopes do not reproduce separate fits to 1e-6 after both passes (gaps `g1' `g2'; N `nst' vs `n1'+`n2')")
116.         if `nst' != `n1' + `n2' | max(`g1', `g2') > 1e-4 exit
117.         * information only: the stacked results of pass 2 with the gap stated (authors' 1e-6 check not met)
.         local sfx "_unverified"
118.         local tolnote "`tolnote'; REPRODUCTION GAP > 1e-6 (authors' threshold): information only"
119.     }
120.     local zc = invnormal(0.975)
121.     forvalues k = 1/2 {
122.         local lb = cond(`k' == 1, "`lab1'", "`lab2'")
123.         local gk = cond(`k' == 1, `g1', `g2')
124.         post A1post ("`item'.`spec'_stk`sfx'.`mobility'.__x`k'") ("${VINTAGE}") ("A1") ("`item'") ("`spec'_stk`sfx'") ("`sample'") ///
>             ("`mobility'") ("__x`k'") (`sb`k'') (`ss`k'') (2 * normal(-abs(`sb`k'' / `ss`k''))) (`sb`k'' - `zc' * `ss`k'') ///
>             (`sb`k'' + `zc' * `ss`k'') (`sN') (`sNf') (`sS') (`sP') (`sC') ("`sCv'") ("stacked slope `lb'; repro gap `gk'; `tolnote'")
125.     }
126.     A1_posttest, item(`item') spec(`spec'_test`sfx') sample(`sample') mobility(`mobility') term(`lab1'_eq_`lab2') ///
>         stat(`chi2') df(`df') p(`pp') nobs(`sN') nfull(`sNf') ncl(`sC') clv(`sCv') ///
>         note("Wald chi2 H0 b_`lab1'=b_`lab2'; stacked PPML, block-specific FE; N1=`n1' N2=`n2'; `tolnote'")
127.     post A1post ("`item'.`spec'_diff`sfx'.`mobility'.`lab1'_minus_`lab2'") ("${VINTAGE}") ("A1") ("`item'") ("`spec'_diff`sfx'") ("`sample'") ///
>         ("`mobility'") ("`lab1'_minus_`lab2'") (`dd') (`ds') (2 * normal(-abs(`dd' / `ds'))) (`dd' - `zc' * `ds') (`dd' + `zc' * `ds') ///
>         (`sN') (`sNf') (`sS') (`sP') (`sC') ("`sCv'") ("lincom on stacked model`sfx'")
128.     display as result "A1_STACK item=`item' spec=`spec' mob=`mobility' b1=`b1' b2=`b2' chi2=`chi2' p=`pp' N1=`n1' N2=`n2' cl=`cl' pass=`usedpass'"
129. end

. 
end of do-file

