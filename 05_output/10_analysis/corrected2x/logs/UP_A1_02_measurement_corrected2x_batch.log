. 
. * --- additional restrictions from the web data checks
. * (i) SVK/SVN tourist arrivals in accommodation establishments (DC_tourism.md item 4)
. gen byte x_svksvn = inlist(iso3_o, "SVK", "SVN") | inlist(iso3_d, "SVK", "SVN")

. * (ii) Paraguay as mobility reporter (rev reported by iso3_o, same by iso3_d) and all pairs with PRY
. gen byte x_pry_rep = iso3_o == "PRY" | iso3_d == "PRY"

. egen byte x_pry_pair = max(iso3_o == "PRY" | iso3_d == "PRY"), by(pair_id)

. * a directed pair either involves PRY in every year or never: the two definitions coincide
. assert x_pry_pair == x_pry_rep

. * (iv) 36 importer-years reporting an HS dataset with no basket rows (rescue C09 evidence list)
. preserve

.     import delimited using "${C09_FILE}", clear varnames(1) stringcols(3)
(encoding automatically selected: ISO-8859-1)
(12 vars, 36 obs)

.     keep year iso3_d zero_fill_no_rows

.     assert zero_fill_no_rows == 1

.     quietly count

.     assert r(N) == 36

.     isid year iso3_d

.     drop zero_fill_no_rows

.     gen byte x_c09 = 1

.     tempfile c09

.     save `c09'
file <TMP> saved as .dta format

. restore

. merge m:1 year iso3_d using `c09', keep(master match) nogen

    Result                      Number of obs
    -----------------------------------------
    Not matched                       815,037
        from master                   815,037  
        from using                          0  

    Matched                             8,409  
    -----------------------------------------

. nflow step "A1.5 merge C09 importer-year list (m:1 keep master match; no row change)"
nflow:      823,446 ->      823,446  A1.5 merge C09 importer-year list (m:1 keep master match; no row change)

. replace x_c09 = 0 if missing(x_c09)
(815,037 real changes made)

. * (v) constructed zeros: SSD 2011-2012; CUW, BES, SXM 2007-2010 (DC_trade.md items 2b, 2c)
. gen byte x_cz = ((iso3_o == "SSD" | iso3_d == "SSD") & inrange(year, 2011, 2012)) | ///
>     ((inlist(iso3_o, "CUW", "BES", "SXM") | inlist(iso3_d, "CUW", "BES", "SXM")) & inrange(year, 2007, 2010))

. * (vii) 15 importer-year datasets re-released after the August 2026 download (DC_trade.md item 5);
. *       x_rev6 = the six with 4-5 times more records (AGO 2011-2012, GHA 2016-2018, OMN 2021)
. gen byte x_rev15 = (iso3_d == "AGO" & inlist(year, 2011, 2012)) | (iso3_d == "GHA" & inlist(year, 2016, 2017, 2018, 2021)) | ///
>     (iso3_d == "OMN" & year == 2021) | (iso3_d == "QAT" & inlist(year, 2012, 2013)) | ///
>     (iso3_d == "GEO" & inlist(year, 2018, 2020, 2021)) | (inlist(iso3_d, "COD", "CRI", "CIV") & year == 2021)

. gen byte x_rev6 = (iso3_d == "AGO" & inlist(year, 2011, 2012)) | (iso3_d == "GHA" & inlist(year, 2016, 2017, 2018)) | ///
>     (iso3_d == "OMN" & year == 2021)

. * (vi) joint "clean measurement" exclusion
. gen byte x_clean = x_svksvn | x_pry_rep | x_c09 | x_cz | x_rev15

. tempname XS

. postfile `XS' str5 measure str12 exclusion double(cand_rows_excluded base_rows_excluded base_rows base_value_excluded base_value base_value_share) ///
>     using "${OUT}/tables/A1_A1.5_exclusion_counts.dta", replace
(file <PACKAGE_ROOT>/05_output/10_analysis/corrected2x_upair/tables/A1_A1.5_exclusion_counts.dta not found)

. foreach m in vis tour {
  2.     quietly count if s_base_`m'
  3.     local nb = r(N)
  4.     quietly summarize v_ttl_k if s_base_`m', meanonly
  5.     local vb = r(sum)
  6.     foreach x in x_svksvn x_pry_rep x_c09 x_cz x_rev15 x_rev6 x_clean {
  7.         quietly count if has_both_`m' & c_trade & `x'
  8.         local ec = r(N)
  9.         quietly count if s_base_`m' & `x'
 10.         local eb = r(N)
 11.         quietly summarize v_ttl_k if s_base_`m' & `x', meanonly
 12.         local ev = cond(r(N) > 0, r(sum), 0)
 13.         post `XS' ("`m'") ("`x'") (`ec') (`eb') (`nb') (`ev') (`vb') (`ev' / `vb')
 14.         capture noisily ppmlhdfe v_ttl_k mob_bilat_`m' if has_both_`m' & !`x', absorb(${FE}) vce(cluster unordered_pair_id)
 15.         A1_after, rc(`=_rc') item(A1.5) spec(`x') sample(has_both_`m' & !`x') mobility(`m') terms(mob_bilat_`m') ///
>             note("exclusion; candidate rows excluded `ec'; baseline e(sample) rows excluded `eb'")
 16.     }
 17.     * clean + basis restrictions (same basis, no switch; visitors also vis_defok)
.     local extra "r1_`m' == 1 & r4_`m' == 1"
 18.     if "`m'" == "vis" local extra "`extra' & r3_vis == 1"
 19.     capture noisily ppmlhdfe v_ttl_k mob_bilat_`m' if has_both_`m' & !x_clean & `extra', absorb(${FE}) vce(cluster unordered_pair_id)
 20.     A1_after, rc(`=_rc') item(A1.5) spec(x_clean_basis) sample(has_both_`m' & !x_clean & r1 & r4 [& r3]) mobility(`m') terms(mob_bilat_`m') ///
>         note("clean measurement sample plus same basis both directions and no series switch (visitors also no tourists-only substitute)")
 21. }
