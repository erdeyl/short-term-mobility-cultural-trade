. foreach m in vis tour {
  2.     local rl "r1 r2 r2all r4"
  3.     if "`m'" == "vis" local rl "r1 r2 r2all r3 r4"
  4.     foreach r of local rl {
  5.         quietly count if has_both_`m' & c_trade & `r'_`m' == 1
  6.         local a = r(N)
  7.         quietly count if has_both_`m' & c_trade & `r'_`m' != 1
  8.         local b = r(N)
  9.         quietly count if s_base_`m' & `r'_`m' == 1
 10.         local c = r(N)
 11.         quietly count if s_base_`m' & `r'_`m' != 1
 12.         local d = r(N)
 13.         post `RC' ("`m'") ("`r'") (`a') (`b') (`c') (`d')
 14.     }
 15. }

. postclose `RC'

. preserve

.     use "${OUT}/tables/A1_A1.5_restriction_counts.dta", clear

.     gen str10 vintage = "${VINTAGE}"

.     order vintage

.     export delimited using "${OUT}/tables/A1_A1.5_restriction_counts.csv", replace
