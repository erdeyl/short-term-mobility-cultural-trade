
. * generated by run_all.py: the package root is the first argument
. args root

. global PKGROOT `"`root'"'

. cd `"`root'/02_code/10_analysis"'
<PACKAGE_ROOT>/02_code/10_analysis

. do "FIG_03_cd_slopes.do" corrected2x 

. /****************************************************************************
> ***
>  FIG_03_cd_slopes.do -- data for manuscript Figure 1 (mobility slopes over cu
> ltural distance)
>  Usage (cwd = 02_code/10_analysis):  stata-mp -b -q do FIG_03_cd_slopes.do <corre
> cted2|corrected2x>
>  Caption: (a) visitors, own estimation 
> sample; (b) tourists,
>  own estimation sample; (c) visitors and tourists on identical observations. 
> Line = mobility slope
>  b + g*(CD - c) on a fine grid between the sample minimum and maximum with a 
> 95% interval from the
>  full covariance of (b, g); bars = pair-year counts in 20 equal-width CD bins
>  (clamped to [1, 20],
>  counts asserted to sum to the estimation N).
>  Fits: identical to A2_5.do for mod = cd (moderator cul_dist = package cd6_ge
> 4): own samples with
>  realized-sample centring (A2_5.do lines 212-238, cd_own_real), identical obs
> ervations = fixed point of
>  the two eligible-centred models then common-sample centring (A2_5.do lines 2
> 96-334, cd_common_real).
>  Help consulted (installed): ppmlhdfe.sthlp 2.3.4 (absorb(), vce(cluster), e(
> sample), e(b), e(V),
>  e(N), e(N_full), e(num_singletons), e(num_separated), e(converged)); [R] lin
> com (r(estimate), r(se);
>  standard normal reference when the model posts no residual df); [R] pctile (
> _pctile, r(r#));
>  [P] matrix (e(V) elements); [P] postfile; nflow.sthlp 1.0.1.
>  Grid interval: se(v) = sqrt(V_bb + 2(v-c)V_bg + (v-c)^2 V_gg), 95% CI = slop
> e -/+ invnormal(0.975) se,
>  i.e. exactly what lincom reports for b + (v-c) g after ppmlhdfe (checked at 
> 11 grid points to 1e-10).
>  Positive control: at the 7 percentiles of A2_5.do a2_slopes, lincom slope an
> d SE equal the A2.csv rows
>  A2.5 cd_own_slopes (own) and cd_common_slopes (identical observations) of th
> e same vintage to 1e-6.
>  Output: ${OUT}/FIG_cd_slopes_grid.csv, FIG_cd_slopes_bins.csv, FIG_cd_slopes
> _controls.csv; nflow (every fit via a2_chk) in
>  ${OUT}/FIG_nflow.csv. No data value is altered.
> *****************************************************************************
> **/
. args vintage

. clear all

. set more off

. set varabbrev off

. set linesize 200

. version 18.0

. do "00_config.do" `vintage'

. /*******************************************************************************
>  00_config.do  --  globals for one data vintage (analysis layer of the replication package)
> 
>  Usage (from another do-file, cwd = 02_code/10_analysis):  do 00_config.do <vintage>
>    <vintage> = corrected2x (revised baseline, default run)
>              | corrected | corrected2 (reconciliation switch, same data build)
>              | submitted (reconciliation switch, needs a second build with corrections off)
>  Every path is built from the package root ${PKGROOT}, which run_all.py passes as the first
>  argument of the generated wrapper do-file (_run.do pattern); nothing here is machine-specific.
>  Defines globals only and checks the Stata version.
> 
>  Vintages (see README.md, "Data-correction rules"):
>    corrected   = build with the correction rules on (code 490 -> TWN, Paraguay residence quarantine, flags)
>    corrected2  = corrected + quarantine of PAK residence 2020-2021 and BLR visitors-by-residence
>                  partner LIE 2020-2022 (same rule as Paraguay); 31-code outcome
>    corrected2x = corrected2 with the 30-code outcome (31-code basket minus HS 490700) = revised baseline
>    submitted   = original data as submitted (build with corrections off), for the reconciliation only
> *******************************************************************************/
. 
. args vintage

. if !inlist("`vintage'", "submitted", "corrected", "corrected2", "corrected2x") {
.     display as error "VINTAGE must be submitted, corrected, corrected2 or corrected2x; got [`vintage']"
.     exit 198
. }

