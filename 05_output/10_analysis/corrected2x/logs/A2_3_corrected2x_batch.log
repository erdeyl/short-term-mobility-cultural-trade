 71.                 a2_postval, item(A2.3) spec(T2_sepsupport_`cl'_holm) sample(own category supports) mobility(`mlab') label(holm: `cn`a'' - `cn`b'') value(`est`ab'') se(`se`ab'') p(`=r(h`i')') n(`n
> union') note("Holm family = six pairwise category differences, `mlab', clustering `cl', m=6; raw p=`raw`ab''")
 72.             }
 73.         restore
 74.         nflow step "restore: after T2 `m' `cl'"
