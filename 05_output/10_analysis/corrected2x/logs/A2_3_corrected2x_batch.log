 10.     a2_posttest, item(A2.3) spec(T1_cs_exact_`cl') sample(s_cs_exact) mobility(both) label(test visitors = tourists) chi2(`r(chi2)') df(`r(df)') p(`r(p)') nuniq(`nu') note("max reproduction gap $
> {A2_STACK_GAP}")
