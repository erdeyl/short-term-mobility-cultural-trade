> `nunion') note("N = union of the four category supports")
 48.             display as result "A2_3_T2 `m' `cl' joint p=" %12.10f `pj'
 49.             if "`cl'" == "pair_id" assert abs(`pj' - `pc_t2_`m'') < 1e-8
 50.             local plist ""
 51.             local clist ""
