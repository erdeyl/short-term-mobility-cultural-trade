. * --- helper: joint directional fit, posts rev, same, test rev = same and lincom rev - same
. capture program drop A1_dirfit

. program define A1_dirfit
  1.     syntax , y(varname) m(string) cond(string) item(string) spec(string) cl(name) [note(string) gen(name)]
  2.     capture noisily ppmlhdfe `y' mob_rev_`m' mob_same_`m' if `cond', absorb(${FE}) vce(cluster `cl')
  3.     local rc = _rc
  4.     local genopt ""
  5.     if "`gen'" != "" local genopt "gen(`gen')"
  6.     A1_after, rc(`rc') item(`item') spec(`spec'_`cl') sample(`cond') mobility(`m') terms(mob_rev_`m' mob_same_`m') `genopt' note("`note'")
  7.     if `rc' == 0 & e(converged) == 1 {
  8.         quietly test mob_rev_`m' = mob_same_`m'
  9.         A1_posttest, item(`item') spec(`spec'_`cl'_test) sample(`cond') mobility(`m') term(rev_eq_same) ///
>             stat(`r(chi2)') df(`r(df)') p(`r(p)') nobs(`=e(N)') nfull(`=e(N_full)') ncl(`=e(N_clust)') clv(`e(clustvar)') ///
>             note("Wald chi2 H0 b_rev = b_same; `note'")
 10.         quietly lincom mob_rev_`m' - mob_same_`m'
 11.         A1_postlincom, item(`item') spec(`spec'_`cl'_diff) sample(`cond') mobility(`m') term(rev_minus_same) note("`note'")
 12.     }
 13. end

