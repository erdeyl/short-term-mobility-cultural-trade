.     exit 198
. }

. 
. if "`vintage'" == "submitted" global VROOT "${STUDENT}"

. if inlist("`vintage'", "corrected", "corrected2", "corrected2x") global VROOT "${ROOT}"

. 
. * ---------------------------------------------------------------- inputs
. global DATA_FILE      "${VROOT}/04_analysis data/03_Mobility/mobility_analysis_2007_2021.dta"

