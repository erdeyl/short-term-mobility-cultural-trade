. file write `NF' "date,time,kind,n_before,n_after,change,reason" _n

. foreach m in vis tour {
  2.     local nn = scalar(orig_`m'_n)
  3.     file write `NF' "`=strtrim(c(current_date))',`c(current_time)',est,823446,`nn',`=`nn'-823446',""C2_02_bias `m' ppmlhdfe baseline (original 03_ppml_bias_correction.do) | ppmlhdfe e(N) stored as scalar orig_`m'_n""" _n
  4.     file write `NF' "`=strtrim(c(current_date))',`c(current_time)',est,823446,`nn',`=`nn'-823446',""C2_02_bias `m' ppml_fe_bias on the same e(sample) | no e(N) posted by ppml_fe_bias; N = preceding ppmlhdfe e(N)""" _n
  5.     display as result "C2_BIAS_NFLOW `m' N=`nn' (preceding ppmlhdfe e(N))"
  6. }
C2_BIAS_NFLOW vis N=20598 (preceding ppmlhdfe e(N))
C2_BIAS_NFLOW tour N=26339 (preceding ppmlhdfe e(N))

