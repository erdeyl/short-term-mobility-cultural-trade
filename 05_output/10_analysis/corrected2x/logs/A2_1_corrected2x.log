      name:  <unnamed>
       log:  <PACKAGE_ROOT>/05_output/10_analysis/corrected2x/logs/A2_1_corrected2x.log
  log type:  text
 opened on:   5 Nov 2026, 10:45:28

. display as result "A2_1_BEGIN vintage=${VINTAGE} " c(current_date) " " c(current_time)
A2_1_BEGIN vintage=corrected2x  5 Nov 2026 10:45:28

. use "${OUT}/A2_work.dta", clear
(PREP analysis base, vintage corrected2x, built  5 Nov 2026 10:41:37 by 01_prep.d)

. nflow start using "${OUT}/A2_nflow.csv", append
nflow: log <PACKAGE_ROOT>/05_output/10_analysis/corrected2x/A2_nflow.csv, start N =       56,500

. a2_open "${OUT}/results/A2_1.dta"
(file <PACKAGE_ROOT>/05_output/10_analysis/corrected2x/results/A2_1.dta not found)

. a2_topen "${OUT}/tables/A2_A2.1.dta"
(file <PACKAGE_ROOT>/05_output/10_analysis/corrected2x/tables/A2_A2.1.dta not found)

. local FE "exporter_year importer_year pair_id"

. tempfile inflall

. local inflfirst = 1

. 
. foreach m in vis tour {
  2.     local smp "s_base_`m'"
  3.     local mlab = cond("`m'" == "vis", "visitors", "tourists")
  4.     quietly count if `smp'
  5.     local N0 = r(N)
  6. 
.     *==========================================================================
.     * (a) zeros and near-zeros; reverse share s = rev/(rev+same)
.     *==========================================================================
.     quietly count if `smp' & rev_`m'_raw == 0
  7.     a2_tpost, item(A2.1a) table(zeros) sample(`smp') mobility(`mlab') stat(share_rev_zero) value(`=r(N)/`N0'') n(`N0') note("count=`r(N)'")
  8.     quietly count if `smp' & same_`m'_raw == 0
  9.     a2_tpost, item(A2.1a) table(zeros) sample(`smp') mobility(`mlab') stat(share_same_zero) value(`=r(N)/`N0'') n(`N0') note("count=`r(N)'")
 10.     quietly count if `smp' & (rev_`m'_raw == 0 | same_`m'_raw == 0)
 11.     a2_tpost, item(A2.1a) table(zeros) sample(`smp') mobility(`mlab') stat(share_any_zero) value(`=r(N)/`N0'') n(`N0') note("count=`r(N)'")
 12.     quietly count if `smp' & rev_`m'_raw == 0 & same_`m'_raw == 0
 13.     a2_tpost, item(A2.1a) table(zeros) sample(`smp') mobility(`mlab') stat(share_both_zero) value(`=r(N)/`N0'') n(`N0') note("count=`r(N)'")
 14.     quietly count if `smp' & rev_`m'_raw < 10
 15.     a2_tpost, item(A2.1a) table(zeros) sample(`smp') mobility(`mlab') stat(share_rev_lt10) value(`=r(N)/`N0'') n(`N0') note("count=`r(N)'; trips")
 16.     quietly count if `smp' & same_`m'_raw < 10
 17.     a2_tpost, item(A2.1a) table(zeros) sample(`smp') mobility(`mlab') stat(share_same_lt10) value(`=r(N)/`N0'') n(`N0') note("count=`r(N)'; trips")
 18.     quietly count if `smp' & (rev_`m'_raw < 10 | same_`m'_raw < 10)
 19.     a2_tpost, item(A2.1a) table(zeros) sample(`smp') mobility(`mlab') stat(share_either_lt10) value(`=r(N)/`N0'') n(`N0') note("count=`r(N)'; asinh(x)-log(2x) = 1/(4x^2) approx; at x=10 about 0.0
> 025")
 20.     * pairs ever with a directional zero (over has_both rows of the pair)
.     tempvar zr anyz first
 21.     gen byte `zr' = has_both_`m' & (rev_`m'_raw == 0 | same_`m'_raw == 0)
 22.     bysort pair_id: egen byte anyz_`m' = max(`zr')
 23.     label variable anyz_`m' "Pair has a directional zero in some year with both directions observed"
 24.     quietly count if `smp' & anyz_`m'
 25.     a2_tpost, item(A2.1a) table(zeros) sample(`smp') mobility(`mlab') stat(share_rows_in_pairs_ever_zero) value(`=r(N)/`N0'') n(`N0') note("count=`r(N)'")
 26.     bysort pair_id: gen byte `first' = _n == 1
 27.     egen byte __insmp = max(`smp'), by(pair_id)
 28.     quietly count if `first' & __insmp
 29.     local npairs = r(N)
 30.     quietly count if `first' & __insmp & anyz_`m'
 31.     a2_tpost, item(A2.1a) table(zeros) sample(`smp') mobility(`mlab') stat(share_pairs_ever_zero) value(`=r(N)/`npairs'') n(`npairs') note("pairs with a zero=`r(N)'; N = directed pairs in sample"
> )
 32.     drop __insmp
 33.     gen double sh_`m' = rev_`m'_raw / (rev_`m'_raw + same_`m'_raw) if `smp' & (rev_`m'_raw + same_`m'_raw) > 0
 34.     label variable sh_`m' "Reverse share rev/(rev+same), `mlab'"
 35.     quietly count if `smp' & missing(sh_`m')
 36.     a2_tpost, item(A2.1a) table(reverse_share) sample(`smp') mobility(`mlab') stat(n_undefined_sum0) value(`r(N)') n(`N0')
 37.     quietly summarize sh_`m' if `smp', detail
 38.     local ns = r(N)
 39.     foreach st in mean sd p1 p5 p10 p25 p50 p75 p90 p95 p99 min max {
 40.         a2_tpost, item(A2.1a) table(reverse_share) sample(`smp') mobility(`mlab') stat(`st') value(`=r(`st')') n(`ns')
 41.     }
 42.     quietly count if `smp' & sh_`m' < 0.05
 43.     a2_tpost, item(A2.1a) table(reverse_share) sample(`smp') mobility(`mlab') stat(share_s_lt_0.05) value(`=r(N)/`ns'') n(`ns') note("count=`r(N)'")
 44.     quietly count if `smp' & sh_`m' > 0.95 & !missing(sh_`m')
 45.     a2_tpost, item(A2.1a) table(reverse_share) sample(`smp') mobility(`mlab') stat(share_s_gt_0.95) value(`=r(N)/`ns'') n(`ns') note("count=`r(N)'")
 46.     quietly count if `smp' & (sh_`m' < 0.05 | (sh_`m' > 0.95 & !missing(sh_`m')))
 47.     a2_tpost, item(A2.1a) table(reverse_share) sample(`smp') mobility(`mlab') stat(share_s_outside_05_95) value(`=r(N)/`ns'') n(`ns') note("count=`r(N)'")
 48.     * corr of the two raw directional IHS terms on the sample (descriptive)
.     quietly correlate mob_rev_`m' mob_same_`m' if `smp'
 49.     a2_tpost, item(A2.1a) table(raw_corr) sample(`smp') mobility(`mlab') stat(corr_mob_rev_same_raw) value(`=r(rho)') n(`=r(N)')
 50. 
.     *==========================================================================
.     * (b) FWL diagnostics, bilateral model
.     *==========================================================================
.     quietly ppmlhdfe v_ttl_k mob_bilat_`m' if `smp', absorb(`FE') vce(cluster pair_id) d(dB_`m')
 51.     a2_chk "A2.1b bilateral `mlab' on s_base"
 52.     a2_post, item(A2.1b) spec(bilateral) sample(`smp') mobility(`mlab') term(mob_bilat_`m')
 53.     local bB = _b[mob_bilat_`m']
 54.     gen byte eB_`m' = e(sample)
 55.     assert eB_`m' == `smp'
 56.     estimates store B_`m'
 57.     quietly predict double muB_`m' if eB_`m', mu
 58.     quietly predict double etaB_`m' if eB_`m', eta
 59.     gen double eB_res_`m' = v_ttl_k - muB_`m' if eB_`m'
 60.     gen double zB_`m' = etaB_`m' + eB_res_`m' / muB_`m' if eB_`m'
 61.     quietly reghdfe mob_bilat_`m' [aw=muB_`m'] if eB_`m', absorb(`FE') residuals(rB_`m') tolerance(1e-12)
 62.     a2_chk "A2.1b reghdfe partialling mob_bilat `mlab' [aw=mu]"
 63.     assert e(N) == `N0'
 64.     quietly reghdfe mob_bilat_`m' if eB_`m', absorb(`FE') residuals(uB_`m') tolerance(1e-12)
 65.     a2_chk "A2.1b reghdfe partialling mob_bilat `mlab' unweighted"
 66.     assert e(N) == `N0'
 67.     * weighted (PPML-relevant) and unweighted variance shares
.     quietly summarize muB_`m' if eB_`m'
 68.     local sw = r(sum)
 69.     tempvar wx
 70.     gen double `wx' = muB_`m' * mob_bilat_`m' if eB_`m'
 71.     quietly summarize `wx'
 72.     local xbw = r(sum) / `sw'
 73.     quietly replace `wx' = muB_`m' * (mob_bilat_`m' - `xbw')^2 if eB_`m'
 74.     quietly summarize `wx'
 75.     local vraw_w = r(sum) / `sw'
 76.     drop `wx'
 77.     tempvar sq
 78.     gen double `sq' = muB_`m' * rB_`m'^2 if eB_`m'
 79.     quietly summarize `sq'
 80.     local sumWr2 = r(sum)
 81.     quietly summarize muB_`m' if eB_`m'
 82.     local sumW = r(sum)
 83.     local vres_w = `sumWr2' / `sumW'
 84.     drop `sq'
 85.     quietly summarize mob_bilat_`m' if eB_`m'
 86.     local vraw_u = r(Var)
 87.     quietly summarize uB_`m' if eB_`m'
 88.     local vres_u = r(Var)
 89.     a2_tpost, item(A2.1b) table(fwl_variance) sample(`smp') mobility(`mlab') stat(mob_bilat_raw_var_w) value(`vraw_w') n(`N0') note("mu-weighted variance (weights = PPML mu, normalised)")
 90.     a2_tpost, item(A2.1b) table(fwl_variance) sample(`smp') mobility(`mlab') stat(mob_bilat_resid_var_w) value(`vres_w') n(`N0') note("mu-weighted variance of residual after WLS partialling on ex
> porter-year, importer-year, pair FE")
 91.     a2_tpost, item(A2.1b) table(fwl_variance) sample(`smp') mobility(`mlab') stat(mob_bilat_resid_share_w) value(`=`vres_w'/`vraw_w'') n(`N0')
 92.     a2_tpost, item(A2.1b) table(fwl_variance) sample(`smp') mobility(`mlab') stat(mob_bilat_raw_var_u) value(`vraw_u') n(`N0') note("unweighted")
 93.     a2_tpost, item(A2.1b) table(fwl_variance) sample(`smp') mobility(`mlab') stat(mob_bilat_resid_var_u) value(`vres_u') n(`N0') note("unweighted OLS partialling")
 94.     a2_tpost, item(A2.1b) table(fwl_variance) sample(`smp') mobility(`mlab') stat(mob_bilat_resid_share_u) value(`=`vres_u'/`vraw_u'') n(`N0')
 95.     * positive controls: score orthogonality and FWL reproduction of b
.     tempname HB gB sB
 96.     quietly matrix accum `HB' = rB_`m' if eB_`m' [iw=muB_`m'], noconstant
 97.     quietly matrix vecaccum `gB' = zB_`m' rB_`m' if eB_`m' [iw=muB_`m'], noconstant
 98.     quietly matrix vecaccum `sB' = eB_res_`m' rB_`m' if eB_`m', noconstant
 99.     local bchk = `gB'[1,1] / `HB'[1,1]
100.     tempvar ab
101.     gen double `ab' = abs(rB_`m' * eB_res_`m') if eB_`m'
102.     quietly summarize `ab'
103.     local scale = r(sum)
104.     drop `ab'
105.     a2_tpost, item(A2.1b) table(fwl_check) sample(`smp') mobility(`mlab') stat(bilat_b_ppmlhdfe) value(`bB') n(`N0')
106.     a2_tpost, item(A2.1b) table(fwl_check) sample(`smp') mobility(`mlab') stat(bilat_b_fwl_working_var) value(`bchk') n(`N0') note("b = sum(mu*xres*z)/sum(mu*xres^2), z = eta + (y-mu)/mu")
107.     a2_tpost, item(A2.1b) table(fwl_check) sample(`smp') mobility(`mlab') stat(bilat_score_sum_rel) value(`=`sB'[1,1]/`scale'') n(`N0') note("sum xres*(y-mu) / sum |xres*(y-mu)|; ~0 at the soluti
> on")
108.     display as result "A2_1_FWL_B `m' b=" %15.12f `bB' " fwl=" %15.12f `bchk' " score_rel=" `sB'[1,1]/`scale'
109.     assert abs(`bchk' - `bB') < 1e-4
110.     local HBinv = 1 / `HB'[1,1]
111. 
.     *==========================================================================
.     * (b) FWL diagnostics, joint directional model
.     *==========================================================================
.     quietly ppmlhdfe v_ttl_k mob_rev_`m' mob_same_`m' if `smp', absorb(`FE') vce(cluster pair_id) d(dJ_`m')
112.     a2_chk "A2.1b joint directional `mlab' on s_base"
113.     a2_post, item(A2.1b) spec(joint) sample(`smp') mobility(`mlab') term(mob_rev_`m')
114.     a2_post, item(A2.1b) spec(joint) sample(`smp') mobility(`mlab') term(mob_same_`m')
115.     local bJr = _b[mob_rev_`m']
116.     local bJs = _b[mob_same_`m']
117.     gen byte eJ_`m' = e(sample)
118.     quietly count if eJ_`m' != `smp'
119.     display as result "A2_1_JOINT_SAMPLE_DIFF_vs_base `m' = " r(N)
120.     quietly count if eJ_`m'
121.     local NJ = r(N)
122.     estimates store J_`m'
123.     quietly predict double muJ_`m' if eJ_`m', mu
124.     quietly predict double etaJ_`m' if eJ_`m', eta
125.     gen double eJ_res_`m' = v_ttl_k - muJ_`m' if eJ_`m'
126.     gen double zJ_`m' = etaJ_`m' + eJ_res_`m' / muJ_`m' if eJ_`m'
127.     foreach d in rev same {
128.         quietly reghdfe mob_`d'_`m' [aw=muJ_`m'] if eJ_`m', absorb(`FE') residuals(r`d'_`m') tolerance(1e-12)
129.         a2_chk "A2.1b reghdfe partialling mob_`d' `mlab' [aw=mu]"
130.         assert e(N) == `NJ'
131.         quietly reghdfe mob_`d'_`m' if eJ_`m', absorb(`FE') residuals(u`d'_`m') tolerance(1e-12)
132.         a2_chk "A2.1b reghdfe partialling mob_`d' `mlab' unweighted"
133.         quietly summarize muJ_`m' if eJ_`m'
134.         local sw = r(sum)
135.         tempvar wx
136.         gen double `wx' = muJ_`m' * mob_`d'_`m' if eJ_`m'
137.         quietly summarize `wx'
138.         local xbw = r(sum) / `sw'
139.         quietly replace `wx' = muJ_`m' * (mob_`d'_`m' - `xbw')^2 if eJ_`m'
140.         quietly summarize `wx'
141.         local vraw_w = r(sum) / `sw'
142.         drop `wx'
143.         tempvar sq
144.         gen double `sq' = muJ_`m' * r`d'_`m'^2 if eJ_`m'
145.         quietly summarize `sq'
146.         local s2 = r(sum)
147.         quietly summarize muJ_`m' if eJ_`m'
148.         local vres_w = `s2' / r(sum)
149.         drop `sq'
150.         quietly summarize mob_`d'_`m' if eJ_`m'
151.         local vraw_u = r(Var)
152.         quietly summarize u`d'_`m' if eJ_`m'
153.         local vres_u = r(Var)
154.         a2_tpost, item(A2.1b) table(fwl_variance) sample(`smp') mobility(`mlab') stat(mob_`d'_raw_var_w) value(`vraw_w') n(`NJ') note("mu from the joint directional model")
155.         a2_tpost, item(A2.1b) table(fwl_variance) sample(`smp') mobility(`mlab') stat(mob_`d'_resid_var_w) value(`vres_w') n(`NJ')
156.         a2_tpost, item(A2.1b) table(fwl_variance) sample(`smp') mobility(`mlab') stat(mob_`d'_resid_share_w) value(`=`vres_w'/`vraw_w'') n(`NJ')
157.         a2_tpost, item(A2.1b) table(fwl_variance) sample(`smp') mobility(`mlab') stat(mob_`d'_raw_var_u) value(`vraw_u') n(`NJ')
158.         a2_tpost, item(A2.1b) table(fwl_variance) sample(`smp') mobility(`mlab') stat(mob_`d'_resid_var_u) value(`vres_u') n(`NJ')
159.         a2_tpost, item(A2.1b) table(fwl_variance) sample(`smp') mobility(`mlab') stat(mob_`d'_resid_share_u) value(`=`vres_u'/`vraw_u'') n(`NJ')
160.     }
161.     tempname HJ gJ sJ HJi bJc
162.     quietly matrix accum `HJ' = rrev_`m' rsame_`m' if eJ_`m' [iw=muJ_`m'], noconstant
163.     quietly matrix vecaccum `gJ' = zJ_`m' rrev_`m' rsame_`m' if eJ_`m' [iw=muJ_`m'], noconstant
164.     quietly matrix vecaccum `sJ' = eJ_res_`m' rrev_`m' rsame_`m' if eJ_`m', noconstant
165.     matrix `HJi' = invsym(`HJ')
166.     matrix `bJc' = `HJi' * `gJ''
167.     local rho_w = `HJ'[1,2] / sqrt(`HJ'[1,1] * `HJ'[2,2])
168.     quietly correlate urev_`m' usame_`m' if eJ_`m'
169.     local rho_u = r(rho)
170.     a2_tpost, item(A2.1b) table(fwl_collinearity) sample(`smp') mobility(`mlab') stat(corr_resid_rev_same_w) value(`rho_w') n(`NJ') note("mu-weighted correlation of FE-partialled mob_rev and mob_
> same")
171.     a2_tpost, item(A2.1b) table(fwl_collinearity) sample(`smp') mobility(`mlab') stat(vif_w) value(`=1/(1-`rho_w'^2)') n(`NJ') note("VIF = 1/(1-r^2), two regressors")
172.     a2_tpost, item(A2.1b) table(fwl_collinearity) sample(`smp') mobility(`mlab') stat(corr_resid_rev_same_u) value(`rho_u') n(`NJ') note("unweighted OLS partialling")
173.     a2_tpost, item(A2.1b) table(fwl_collinearity) sample(`smp') mobility(`mlab') stat(vif_u) value(`=1/(1-`rho_u'^2)') n(`NJ')
174.     tempvar ab
175.     gen double `ab' = abs(rrev_`m' * eJ_res_`m') + abs(rsame_`m' * eJ_res_`m') if eJ_`m'
176.     quietly summarize `ab'
177.     local scale = r(sum)
178.     drop `ab'
179.     a2_tpost, item(A2.1b) table(fwl_check) sample(`smp') mobility(`mlab') stat(joint_b_rev_ppmlhdfe) value(`bJr') n(`NJ')
180.     a2_tpost, item(A2.1b) table(fwl_check) sample(`smp') mobility(`mlab') stat(joint_b_rev_fwl) value(`=`bJc'[1,1]') n(`NJ')
181.     a2_tpost, item(A2.1b) table(fwl_check) sample(`smp') mobility(`mlab') stat(joint_b_same_ppmlhdfe) value(`bJs') n(`NJ')
182.     a2_tpost, item(A2.1b) table(fwl_check) sample(`smp') mobility(`mlab') stat(joint_b_same_fwl) value(`=`bJc'[2,1]') n(`NJ')
183.     a2_tpost, item(A2.1b) table(fwl_check) sample(`smp') mobility(`mlab') stat(joint_score_sum_rel_rev) value(`=`sJ'[1,1]/`scale'') n(`NJ')
184.     a2_tpost, item(A2.1b) table(fwl_check) sample(`smp') mobility(`mlab') stat(joint_score_sum_rel_same) value(`=`sJ'[1,2]/`scale'') n(`NJ')
185.     display as result "A2_1_FWL_J `m' rev=" %15.12f `bJr' " fwl=" %15.12f `bJc'[1,1] " same=" %15.12f `bJs' " fwl=" %15.12f `bJc'[2,1] " rho_w=" `rho_w'
186.     assert abs(`bJc'[1,1] - `bJr') < 1e-4 & abs(`bJc'[2,1] - `bJs') < 1e-4
187. 
.     *==========================================================================
.     * (c) one-step directed-pair cluster influence
.     *==========================================================================
.     gen double scB_`m' = rB_`m' * eB_res_`m' if eB_`m'
188.     gen double scR_`m' = rrev_`m' * eJ_res_`m' if eJ_`m'
189.     gen double scS_`m' = rsame_`m' * eJ_res_`m' if eJ_`m'
190.     preserve
191.         keep if eB_`m' | eJ_`m'
192.         bysort pair_id: egen double gB = total(scB_`m')
193.         bysort pair_id: egen double gR = total(scR_`m')
194.         bysort pair_id: egen double gS = total(scS_`m')
195.         bysort pair_id: egen nobs = total(eB_`m')
196.         bysort pair_id: keep if _n == 1
197.         keep pair_id iso3_o iso3_d gB gR gS nobs
198.         gen double IF_bilat = `HBinv' * gB
199.         gen double IF_rev  = `HJi'[1,1] * gR + `HJi'[1,2] * gS
200.         gen double IF_same = `HJi'[2,1] * gR + `HJi'[2,2] * gS
201.         foreach c in bilat rev same {
202.             gen double aIF_`c' = abs(IF_`c')
203.             quietly summarize aIF_`c'
204.             gen double shIF_`c' = aIF_`c' / r(sum)
205.             gsort -aIF_`c' pair_id
206.             gen int rank_`c' = _n
207.         }
208.         tempfile inflm
209.         save `"`inflm'"'
210.         * long table of the top 10 per coefficient
.         tempfile top
211.         local tfirst = 1
212.         foreach c in bilat rev same {
213.             use `"`inflm'"', clear
214.             keep if rank_`c' <= 10
215.             gen str12 mobility = "`mlab'"
216.             gen str8 coef = "`c'"
217.             gen str10 vintage = "${VINTAGE}"
218.             gen double IF = IF_`c'
219.             gen double share_abs_IF = shIF_`c'
220.             gen int rank = rank_`c'
221.             keep vintage mobility coef rank pair_id iso3_o iso3_d IF share_abs_IF nobs
222.             sort rank
223.             if `tfirst' == 0 append using `"`top'"'
224.             save `"`top'"', replace
225.             local tfirst = 0
226.         }
227.         if `inflfirst' == 0 append using `"`inflall'"'
228.         save `"`inflall'"', replace
229.         * locals of top pair ids
.         use `"`inflm'"', clear
230.         foreach c in bilat rev same {
231.             foreach k in 1 5 10 {
232.                 quietly levelsof pair_id if rank_`c' <= `k', local(L) separate(,)
233.                 local top_`c'_`k' "`L'"
234.             }
235.             quietly summarize IF_`c' if rank_`c' == 1
236.             local if1_`c' = r(mean)
237.         }
238.     restore
239.     local inflfirst = 0
240.     * refits dropping the top 1, 5, 10 clusters
.     foreach k in 1 5 10 {
241.         quietly ppmlhdfe v_ttl_k mob_bilat_`m' if `smp' & !inlist(pair_id, `top_bilat_`k''), absorb(`FE') vce(cluster pair_id)
242.         a2_chk "A2.1c bilateral `mlab' drop top `k' influential pairs"
243.         a2_post, item(A2.1c) spec(bilateral_drop_top`k') sample(`smp') mobility(`mlab') term(mob_bilat_`m') note("dropped pair_id: `top_bilat_`k''")
244.         if `k' == 1 {
245.             local act = `bB' - _b[mob_bilat_`m']
246.             a2_postval, item(A2.1c) spec(bilateral_onestep_accuracy) sample(`smp') mobility(`mlab') label(b - b(-top1)) value(`act') note("actual change; one-step approximation IF = `if1_bilat'")
247.         }
248.         foreach c in rev same {
249.             quietly ppmlhdfe v_ttl_k mob_rev_`m' mob_same_`m' if `smp' & !inlist(pair_id, `top_`c'_`k''), absorb(`FE') vce(cluster pair_id)
250.             a2_chk "A2.1c joint `mlab' drop top `k' pairs ranked by |IF_`c'|"
251.             a2_post, item(A2.1c) spec(joint_drop_top`k'_by_`c') sample(`smp') mobility(`mlab') term(mob_rev_`m') note("dropped pair_id: `top_`c'_`k''")
252.             a2_post, item(A2.1c) spec(joint_drop_top`k'_by_`c') sample(`smp') mobility(`mlab') term(mob_same_`m') note("dropped pair_id: `top_`c'_`k''")
253.             if `k' == 1 {
254.                 local bref = cond("`c'" == "rev", `bJr', `bJs')
255.                 local act = `bref' - _b[mob_`c'_`m']
256.                 a2_postval, item(A2.1c) spec(joint_onestep_accuracy_`c') sample(`smp') mobility(`mlab') label(b - b(-top1)) value(`act') note("actual change of mob_`c'; one-step approximation IF 
> = `if1_`c''")
257.             }
258.         }
259.     }
260. 
.     *==========================================================================
.     * (d) directional models on restricted samples
.     *==========================================================================
.     gen byte rz0_`m' = rev_`m'_raw > 0 & same_`m'_raw > 0
261.     gen byte rz10_`m' = rev_`m'_raw >= 10 & same_`m'_raw >= 10 & !missing(rev_`m'_raw, same_`m'_raw)
262.     gen byte rzp_`m' = anyz_`m' == 0
263.     foreach r in none rz0 rz10 rzp {
264.         local cond "`smp'"
265.         if "`r'" != "none" local cond "`smp' & `r'_`m'"
266.         local rl = cond("`r'"=="none","none",cond("`r'"=="rz0","no directional zero in the pair-year",cond("`r'"=="rz10","both directions >= 10 trips","pair never has a directional zero")))
267.         quietly count if `cond'
268.         local nc = r(N)
269.         quietly ppmlhdfe v_ttl_k mob_bilat_`m' if `cond', absorb(`FE') vce(cluster pair_id)
270.         a2_chk "A2.1d bilateral `mlab' restriction `r'"
271.         a2_post, item(A2.1d) spec(`r'_bilateral) sample(`smp') mobility(`mlab') term(mob_bilat_`m') note("restriction: `rl'; candidate rows=`nc'")
272.         foreach d in rev same {
273.             quietly ppmlhdfe v_ttl_k mob_`d'_`m' if `cond', absorb(`FE') vce(cluster pair_id)
274.             a2_chk "A2.1d `d'-only `mlab' restriction `r'"
275.             a2_post, item(A2.1d) spec(`r'_`d'_only) sample(`smp') mobility(`mlab') term(mob_`d'_`m') note("restriction: `rl'; candidate rows=`nc'")
276.         }
277.         quietly ppmlhdfe v_ttl_k mob_rev_`m' mob_same_`m' if `cond', absorb(`FE') vce(cluster pair_id)
278.         a2_chk "A2.1d joint `mlab' restriction `r'"
279.         a2_post, item(A2.1d) spec(`r'_joint) sample(`smp') mobility(`mlab') term(mob_rev_`m') note("restriction: `rl'; candidate rows=`nc'")
280.         a2_post, item(A2.1d) spec(`r'_joint) sample(`smp') mobility(`mlab') term(mob_same_`m') note("restriction: `rl'; candidate rows=`nc'")
281.         a2_post, item(A2.1d) spec(`r'_joint) sample(`smp') mobility(`mlab') term(mob_rev_`m' - mob_same_`m') label(rev - same) note("restriction: `rl'")
282.         quietly test mob_rev_`m' = mob_same_`m'
283.         a2_posttest, item(A2.1d) spec(`r'_joint) sample(`smp') mobility(`mlab') label(test rev = same) chi2(`r(chi2)') df(`r(df)') p(`r(p)') note("restriction: `rl'")
284.     }
285. 
.     *==========================================================================
.     * (e) composition specification on identical observations
.     *==========================================================================
.     gen double dlt_`m' = mob_rev_`m' - mob_same_`m' if `smp'
286.     label variable dlt_`m' "mob_rev - mob_same (IHS difference), `mlab'"
287.     foreach c in sh dlt {
288.         gen byte cmp_`c'_`m' = `smp' & !missing(`c'_`m')
289.         a2_fix, touse(cmp_`c'_`m') models("v_ttl_k mob_bilat_`m' `c'_`m' ; v_ttl_k mob_bilat_`m'")
290.         local fixit = ${A2_FIX_IT}
291.         quietly ppmlhdfe v_ttl_k mob_bilat_`m' `c'_`m' if cmp_`c'_`m', absorb(`FE') vce(cluster pair_id)
292.         a2_chk "A2.1e composition `c' `mlab'"
293.         local ctxt = cond("`c'" == "sh", "s = rev/(rev+same)", "d = mob_rev - mob_same")
294.         a2_post, item(A2.1e) spec(composition_`c') sample(`smp' & common) mobility(`mlab') term(mob_bilat_`m') note("E[X]=exp(beta*mob_bilat + gamma*`ctxt' + FE); fixed-point iterations=`fixit'")
295.         a2_post, item(A2.1e) spec(composition_`c') sample(`smp' & common) mobility(`mlab') term(`c'_`m') label(gamma: `ctxt') note("fixed-point iterations=`fixit'")
296.         quietly test mob_bilat_`m' `c'_`m'
297.         a2_posttest, item(A2.1e) spec(composition_`c') sample(`smp' & common) mobility(`mlab') label(joint test beta = gamma = 0) chi2(`r(chi2)') df(`r(df)') p(`r(p)')
298.         quietly ppmlhdfe v_ttl_k mob_bilat_`m' if cmp_`c'_`m', absorb(`FE') vce(cluster pair_id)
299.         a2_chk "A2.1e bilateral on composition `c' rows `mlab'"
300.         a2_post, item(A2.1e) spec(bilateral_on_composition_`c'_sample) sample(`smp' & common) mobility(`mlab') term(mob_bilat_`m') note("bilateral model on the identical rows of composition_`c'")
301.     }
302. 
.     *==========================================================================
.     * (f) exact directional equality p, Table 2 specification (if has_both), two clusterings
.     *==========================================================================
.     foreach smpf in has_both_`m' `smp' {
303.         foreach cl in pair_id unordered_pair_id {
304.             quietly ppmlhdfe v_ttl_k mob_rev_`m' mob_same_`m' if `smpf', absorb(`FE') vce(cluster `cl')
305.             a2_chk "A2.1f joint `mlab' `smpf' cluster `cl'"
306.             a2_post, item(A2.1f) spec(joint_`cl') sample(`smpf') mobility(`mlab') term(mob_rev_`m')
307.             a2_post, item(A2.1f) spec(joint_`cl') sample(`smpf') mobility(`mlab') term(mob_same_`m')
308.             a2_post, item(A2.1f) spec(joint_`cl') sample(`smpf') mobility(`mlab') term(mob_rev_`m' - mob_same_`m') label(rev - same)
309.             quietly test mob_rev_`m' = mob_same_`m'
310.             local pp = r(p)
311.             a2_posttest, item(A2.1f) spec(joint_`cl') sample(`smpf') mobility(`mlab') label(test rev = same) chi2(`r(chi2)') df(`r(df)') p(`r(p)')
312.             display as result "A2_1F `m' `smpf' `cl' p=" %12.10f `pp' " clusters=" e(N_clust) " N=" e(N)
313.         }
314.     }
315. }
