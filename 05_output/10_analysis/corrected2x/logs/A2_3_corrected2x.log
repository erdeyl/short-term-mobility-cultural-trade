. *==============================================================================
. * T1 exact visitor-tourist common support
. *==============================================================================
. foreach cl in pair_id unordered_pair_id {
  2.     preserve
  3.     a2_stack, touse(s_cs_exact) ys(v_ttl_k v_ttl_k) xs("mob_bilat_vis ; mob_bilat_tour") cluster(`cl')
  4.     local nu = ${A2_NUNIQ}
  5.     a2_post, item(A2.3) spec(T1_cs_exact_`cl') sample(s_cs_exact) mobility(both) term(s1_1) label(visitors) nuniq(`nu')
  6.     a2_post, item(A2.3) spec(T1_cs_exact_`cl') sample(s_cs_exact) mobility(both) term(s2_1) label(tourists) nuniq(`nu')
  7.     a2_post, item(A2.3) spec(T1_cs_exact_`cl') sample(s_cs_exact) mobility(both) term(s1_1 - s2_1) label(visitors - tourists) nuniq(`nu')
  8.     quietly test s1_1 = s2_1
  9.     local p = r(p)
 10.     a2_posttest, item(A2.3) spec(T1_cs_exact_`cl') sample(s_cs_exact) mobility(both) label(test visitors = tourists) chi2(`r(chi2)') df(`r(df)') p(`r(p)') nuniq(`nu') note("max reproduction gap $
> {A2_STACK_GAP}")
 11.     display as result "A2_3_T1 `cl' p=" %12.10f `p' " N=`nu' clusters=" e(N_clust)
 12.     restore
 13.     nflow step "restore: after T1 `cl'"
 14.     if "`cl'" == "pair_id" {
 15.         preserve
 16.             import delimited using "${OUT}/positive_controls.csv", clear asdouble varnames(1) stringcols(1)
 17.             quietly summarize reproduced if item == "FER.equality_p"
 18.             local pcp = r(mean)
 19.         restore
 20.         display as result "A2_3_PC_T1 p=" %12.10f `p' " ref=" %12.10f `pcp'
 21.         assert abs(`p' - `pcp') < 1e-8
 22.     }
 23. }
