. * T3 four-category equality on the common category support (Table 7 Panel D)
. *==============================================================================
. foreach m in vis tour {
  2.     local mlab = cond("`m'" == "vis", "visitors", "tourists")
  3.     gen byte cc_`m' = has_both_`m' & !missing(v_3706_k, v_49_k, v_8523_k, v_97_k)
  4.     a2_fix, touse(cc_`m') models("v_3706_k mob_bilat_`m' ; v_49_k mob_bilat_`m' ; v_8523_k mob_bilat_`m' ; v_97_k mob_bilat_`m'")
  5.     local it = ${A2_FIX_IT}
  6.     foreach cl in pair_id unordered_pair_id {
  7.         preserve
  8.         a2_stack, touse(cc_`m') ys(v_3706_k v_49_k v_8523_k v_97_k) xs("mob_bilat_`m' ; mob_bilat_`m' ; mob_bilat_`m' ; mob_bilat_`m'") cluster(`cl')
  9.         local nu = ${A2_NUNIQ}
 10.         forvalues k = 1/4 {
 11.             a2_post, item(A2.3) spec(T3_commonsupport_`cl') sample(common category support) mobility(`mlab') term(s`k'_1) label(`cn`k'') nuniq(`nu') note("fixed-point iterations=`it'")
 12.         }
 13.         quietly test (s1_1 = s2_1) (s1_1 = s3_1) (s1_1 = s4_1)
 14.         local pj = r(p)
 15.         local cj = r(chi2)
 16.         a2_posttest, item(A2.3) spec(T3_commonsupport_`cl') sample(common category support) mobility(`mlab') label(joint equality of 4 category slopes) chi2(`r(chi2)') df(`r(df)') p(`r(p)') nuniq
> (`nu')
 17.         display as result "A2_3_T3 `m' `cl' chi2=" %12.6f `cj' " p=" %12.9f `pj' " N=`nu'"
 18.         if "${VINTAGE}" == "submitted" & "`cl'" == "pair_id" {
 19.             local ref = cond("`m'" == "vis", 3.990108, 1.953561)
 20.             local refn = cond("`m'" == "vis", 3666, 4403)
 21.             * published chi2 (File S1 README T3b, default tolerance) to 1e-3: a2_stack may refit
.             * with tolerance(1e-11), which moves chi2 in the 4th decimal (log line A2_3_T3)
.             assert abs(`cj' - `ref') < 1e-3 & `nu' == `refn'
 22.         }
 23.         local plist ""
 24.         local clist ""
 25.         forvalues a = 1/3 {
 26.             local s = `a' + 1
 27.             forvalues b = `s'/4 {
 28.                 a2_post, item(A2.3) spec(T3_commonsupport_`cl') sample(common category support) mobility(`mlab') term(s`a'_1 - s`b'_1) label(`cn`a'' - `cn`b'') nuniq(`nu')
 29.                 quietly test s`a'_1 = s`b'_1
 30.                 local plist "`plist' `r(p)'"
 31.                 local clist "`clist' `a'`b'"
 32.                 quietly lincom s`a'_1 - s`b'_1
 33.                 local est`a'`b' = r(estimate)
 34.                 local se`a'`b' = r(se)
 35.                 local raw`a'`b' = r(p)
 36.             }
 37.         }
 38.         a2_holm `plist'
 39.         local i = 0
 40.         foreach ab of local clist {
 41.             local ++i
 42.             local a = substr("`ab'", 1, 1)
 43.             local b = substr("`ab'", 2, 1)
 44.             a2_postval, item(A2.3) spec(T3_commonsupport_`cl'_holm) sample(common category support) mobility(`mlab') label(holm: `cn`a'' - `cn`b'') value(`est`ab'') se(`se`ab'') p(`=r(h`i')') n(`
> nu') note("Holm family = six pairwise category differences, `mlab', clustering `cl', m=6; raw p=`raw`ab''")
 45.         }
 46.         restore
 47.         nflow step "restore: after T3 `m' `cl'"
 48.     }
 49. }
