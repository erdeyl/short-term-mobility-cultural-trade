. *==============================================================================
. * T4 reporting-side equality (Table A4)
. *==============================================================================
. local sn1 "importer"

. local sn2 "exporter"

. local sn3 "average"

. foreach m in vis tour {
  2.     local mlab = cond("`m'" == "vis", "visitors", "tourists")
  3.     gen byte rc_`m' = has_both_`m' & !missing(v_ttl_k, v_ttl_exporter_lb_k, v_rec_k, mob_bilat_`m')
  4.     quietly count if rc_`m'
  5.     local ncand = r(N)
  6.     a2_fix, touse(rc_`m') models("v_ttl_k mob_bilat_`m' ; v_ttl_exporter_lb_k mob_bilat_`m' ; v_rec_k mob_bilat_`m'")
  7.     local it = ${A2_FIX_IT}
  8.     foreach cl in pair_id unordered_pair_id {
  9.         preserve
 10.         a2_stack, touse(rc_`m') ys(v_ttl_k v_ttl_exporter_lb_k v_rec_k) xs("mob_bilat_`m' ; mob_bilat_`m' ; mob_bilat_`m'") cluster(`cl')
 11.         local nu = ${A2_NUNIQ}
 12.         forvalues k = 1/3 {
 13.             a2_post, item(A2.3) spec(T4_reporting_`cl') sample(reporting-side common support) mobility(`mlab') term(s`k'_1) label(`sn`k'') nuniq(`nu') note("candidate rows=`ncand'; fixed-point it
> erations=`it'")
 14.         }
 15.         quietly test (s1_1 = s2_1) (s1_1 = s3_1)
 16.         local pall = r(p)
 17.         a2_posttest, item(A2.3) spec(T4_reporting_`cl') sample(reporting-side common support) mobility(`mlab') label(all three equal) chi2(`r(chi2)') df(`r(df)') p(`r(p)') nuniq(`nu')
 18.         local plist ""
 19.         local clist ""
 20.         foreach ab in 12 13 23 {
 21.             local a = substr("`ab'", 1, 1)
 22.             local b = substr("`ab'", 2, 1)
 23.             a2_post, item(A2.3) spec(T4_reporting_`cl') sample(reporting-side common support) mobility(`mlab') term(s`a'_1 - s`b'_1) label(`sn`a'' - `sn`b'') nuniq(`nu')
 24.             quietly test s`a'_1 = s`b'_1
 25.             local plist "`plist' `r(p)'"
 26.             local clist "`clist' `ab'"
 27.             local pr`ab' = r(p)
 28.             quietly lincom s`a'_1 - s`b'_1
 29.             local est`ab' = r(estimate)
 30.             local se`ab' = r(se)
 31.         }
 32.         display as result "A2_3_T4 `m' `cl' N=`nu' imp=" %9.6f _b[s1_1] " exp=" %9.6f _b[s2_1] " avg=" %9.6f _b[s3_1] " p(imp=exp)=" %9.6f `pr12' " p(all)=" %9.6f `pall'
 33.         if "${VINTAGE}" == "submitted" & "`cl'" == "pair_id" {
 34.             local refn = cond("`m'" == "vis", 17612, 21992)
 35.             local refp = cond("`m'" == "vis", 0.003, 0.489)
 36.             local refa = cond("`m'" == "vis", 0.012, 0.332)
 37.             assert `nu' == `refn' & abs(`pr12' - `refp') < `tol_pub' & abs(`pall' - `refa') < `tol_pub'
 38.         }
 39.         a2_holm `plist'
 40.         local i = 0
 41.         foreach ab of local clist {
 42.             local ++i
 43.             local a = substr("`ab'", 1, 1)
 44.             local b = substr("`ab'", 2, 1)
 45.             a2_postval, item(A2.3) spec(T4_reporting_`cl'_holm) sample(reporting-side common support) mobility(`mlab') label(holm: `sn`a'' - `sn`b'') value(`est`ab'') se(`se`ab'') p(`=r(h`i')') n
> (`nu') note("Holm family = three reporting-side contrasts, `mlab', clustering `cl', m=3; raw p=`pr`ab''")
 46.         }
 47.         restore
 48.         nflow step "restore: after T4 `m' `cl'"
 49.     }
 50. }
