. global A2_STACK_NOTE ""

. preserve

.     import delimited using "${OUT}/positive_controls.csv", clear asdouble varnames(1) stringcols(1)
(encoding automatically selected: ISO-8859-1)
(11 vars, 232 obs)

.     quietly summarize reproduced if item == "LOG.CATEGORY_EQUALITY.mob_bilat_vis"

.     local pc_t2_vis = r(mean)

.     quietly summarize reproduced if item == "LOG.CATEGORY_EQUALITY.mob_bilat_tour"

.     local pc_t2_tour = r(mean)

. restore

. foreach m in vis tour {
  2.     local mlab = cond("`m'" == "vis", "visitors", "tourists")
  3.     * separate category fits (06_table4_categories.do:14-20)
.     local nsum = 0
  4.     forvalues k = 1/4 {
  5.         quietly ppmlhdfe v_`cat`k''_k mob_bilat_`m', absorb(`FE') vce(cluster pair_id)
  6.         a2_chk "A2.3 T2 separate category `cat`k'' `mlab'"
  7.         tempname sep`k'
  8.         scalar `sep`k'' = _b[mob_bilat_`m']
  9.         local n`k' = e(N)
 10.         local nsum = `nsum' + e(N)
 11.         gen byte es`k'_`m' = e(sample)
 12.     }
 13.     egen byte esany_`m' = rowmax(es1_`m' es2_`m' es3_`m' es4_`m')
 14.     quietly count if esany_`m'
 15.     local nunion = r(N)
 16.     foreach cl in pair_id unordered_pair_id {
 17.         preserve
 18.             keep if has_both_`m' == 1
 19.             keep year iso3_o iso3_d exporter_year importer_year pair_id unordered_pair_id v_3706_k v_49_k v_8523_k v_97_k mob_bilat_`m'
 20.             nflow step "T2: keep rows with strict bilateral `mlab' (stacking input)"
 21.             quietly expand 4
 22.             nflow step "T2: expand to 4 category blocks"
 23.             bysort year iso3_o iso3_d: gen byte __blk = _n
 24.             quietly gen double __y = .
 25.             forvalues k = 1/4 {
 26.                 quietly replace __y = v_`cat`k''_k if __blk == `k'
 27.                 quietly gen double s`k'_1 = cond(__blk == `k', mob_bilat_`m', 0)
 28.             }
 29.             egen long __ey = group(exporter_year __blk)
 30.             egen long __iy = group(importer_year __blk)
 31.             egen long __pr = group(pair_id __blk)
 32.             quietly ppmlhdfe __y s1_1 s2_1 s3_1 s4_1, absorb(__ey __iy __pr) vce(cluster `cl')
 33.             a2_chk "A2.3 T2 stacked 4 categories `mlab' cluster `cl'"
 34.             assert e(N) == `nsum'
 35.             local gap = 0
 36.             forvalues k = 1/4 {
 37.                 local g = abs(_b[s`k'_1] - `sep`k'')
 38.                 if `g' > `gap' local gap = `g'
 39.             }
 40.             display as result "A2_3_T2 `m' `cl' reproduction gap=" `gap'
 41.             assert `gap' < 1e-6
 42.             forvalues k = 1/4 {
 43.                 a2_post, item(A2.3) spec(T2_sepsupport_`cl') sample(own category supports) mobility(`mlab') term(s`k'_1) label(`cn`k'') nuniq(`n`k'') note("separate-support N of this category; st
> acked e(N)=`e(N)' = sum of the four category N; union of rows `nunion'")
 44.             }
 45.             quietly test (s1_1 = s2_1) (s1_1 = s3_1) (s1_1 = s4_1)
 46.             local pj = r(p)
 47.             a2_posttest, item(A2.3) spec(T2_sepsupport_`cl') sample(own category supports) mobility(`mlab') label(joint equality of 4 category slopes) chi2(`r(chi2)') df(`r(df)') p(`r(p)') nuniq(
> `nunion') note("N = union of the four category supports")
 48.             display as result "A2_3_T2 `m' `cl' joint p=" %12.10f `pj'
 49.             if "`cl'" == "pair_id" assert abs(`pj' - `pc_t2_`m'') < 1e-8
 50.             local plist ""
 51.             local clist ""
 52.             forvalues a = 1/3 {
 53.                 local s = `a' + 1
 54.                 forvalues b = `s'/4 {
 55.                     a2_post, item(A2.3) spec(T2_sepsupport_`cl') sample(own category supports) mobility(`mlab') term(s`a'_1 - s`b'_1) label(`cn`a'' - `cn`b'') nuniq(`nunion')
 56.                     quietly test s`a'_1 = s`b'_1
 57.                     local plist "`plist' `r(p)'"
 58.                     local clist "`clist' `a'`b'"
 59.                     quietly lincom s`a'_1 - s`b'_1
 60.                     local est`a'`b' = r(estimate)
 61.                     local se`a'`b' = r(se)
 62.                     local raw`a'`b' = r(p)
 63.                 }
 64.             }
 65.             a2_holm `plist'
 66.             local i = 0
 67.             foreach ab of local clist {
 68.                 local ++i
 69.                 local a = substr("`ab'", 1, 1)
 70.                 local b = substr("`ab'", 2, 1)
 71.                 a2_postval, item(A2.3) spec(T2_sepsupport_`cl'_holm) sample(own category supports) mobility(`mlab') label(holm: `cn`a'' - `cn`b'') value(`est`ab'') se(`se`ab'') p(`=r(h`i')') n(`n
> union') note("Holm family = six pairwise category differences, `mlab', clustering `cl', m=6; raw p=`raw`ab''")
 72.             }
 73.         restore
 74.         nflow step "restore: after T2 `m' `cl'"
 75.     }
 76.     drop es1_`m' es2_`m' es3_`m' es4_`m' esany_`m'
 77. }
