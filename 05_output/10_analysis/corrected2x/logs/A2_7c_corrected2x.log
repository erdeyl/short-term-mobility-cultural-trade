(file <PACKAGE_ROOT>/05_output/10_analysis/corrected2x/tables/A2_A2.7c.dta not found)

. local FE "exporter_year importer_year pair_id"

. 
. gen double v_noncult_k = tradeflow_comtrade_d - v_ttl_k if !missing(tradeflow_comtrade_d, v_ttl_k) & tradeflow_comtrade_d - v_ttl_k >= 0
(12,720 missing values generated)

. label variable v_noncult_k "Non-cultural imports: CEPII tradeflow_comtrade_d - v_ttl_k where >= 0 (1000 USD)"

. gen double v_nomedia = v_ttl_k - v_8523_k if !missing(v_ttl_k, v_8523_k)
(3,356 missing values generated)

. label variable v_nomedia "Cultural trade without recorded media: v_ttl_k - v_8523_k (1000 USD)"

. quietly count if v_nomedia < 0

. assert r(N) == 0

. foreach Y in v_unesco_a {
  2.     local ytag "unesco_a"
  3.     local ylab "Narrow-A basket"
  4. 
. 
.     foreach m in vis tour {
  5.         local mlab = cond("`m'" == "vis", "visitors", "tourists")
  6.         local smp "s_base_`m'"
  7.         * reference: the outcome on baseline rows with year <= 2020 (no benchmark restriction)
.         quietly ppmlhdfe `Y' mob_bilat_`m' if `smp' & year <= 2020, absorb(`FE') vce(cluster pair_id)
  8.         a2_chk "A2.7c `ytag' `mlab' baseline rows year<=2020"
  9.         a2_post, item(A2.7c) spec(A2.7c_`ytag'_year_le_2020) sample(`smp' & year<=2020) mobility(`mlab') term(mob_bilat_`m') label(`ylab')
 10.         foreach bm in tradeflow_comtrade_d v_noncult_k {
 11.             local bl = cond("`bm'" == "tradeflow_comtrade_d", "total imports (CEPII Comtrade)", "non-cultural imports")
 12.             capture drop bm_`bm'_`m'
 13.             gen byte bm_`bm'_`m' = `smp' & year <= 2020 & !missing(`bm', `Y')
 14.             quietly count if bm_`bm'_`m'
 15.             local nc = r(N)
 16.             a2_fix, touse(bm_`bm'_`m') models("`Y' mob_bilat_`m' ; `bm' mob_bilat_`m'")
 17.             local it = ${A2_FIX_IT}
 18.             quietly summarize `Y' if bm_`bm'_`m', meanonly
 19.             local sc = r(sum)
 20.             quietly summarize tradeflow_comtrade_d if bm_`bm'_`m', meanonly
 21.             local st = r(sum)
 22.             a2_tpost, item(A2.7c) table(`ytag'_share) sample(identical rows `bm') mobility(`mlab') stat(outcome_share_of_total_pct) value(`=100*`sc'/`st'') n(`r(N)') note("100 * sum(`Y') / sum(tr
> adeflow_comtrade_d)")
 23.             tempvar r
 24.             gen double `r' = `Y' / tradeflow_comtrade_d if bm_`bm'_`m'
 25.             quietly summarize `r', detail
 26.             a2_tpost, item(A2.7c) table(`ytag'_share) sample(identical rows `bm') mobility(`mlab') stat(median_rowwise_outcome_share) value(`r(p50)') n(`r(N)')
 27.             a2_tpost, item(A2.7c) table(`ytag'_share) sample(identical rows `bm') mobility(`mlab') stat(p99_rowwise_outcome_share) value(`r(p99)') n(`r(N)')
 28.             drop `r'
 29.             preserve
 30.             a2_stack, touse(bm_`bm'_`m') ys(`Y' `bm') xs("mob_bilat_`m' ; mob_bilat_`m'") cluster(pair_id)
 31.             local nu = ${A2_NUNIQ}
 32.             a2_post, item(A2.7c) spec(A2.7c_`ytag'_`bm'_identical_rows) sample(`smp' & year<=2020 & `bm' observed) mobility(`mlab') term(s1_1) label(`ylab') nuniq(`nu') note("outcome `Y'; candida
> te rows `nc'; fixed-point iterations `it'")
 33.             a2_post, item(A2.7c) spec(A2.7c_`ytag'_`bm'_identical_rows) sample(`smp' & year<=2020 & `bm' observed) mobility(`mlab') term(s2_1) label(`bl') nuniq(`nu')
 34.             a2_post, item(A2.7c) spec(A2.7c_`ytag'_`bm'_identical_rows) sample(`smp' & year<=2020 & `bm' observed) mobility(`mlab') term(s1_1 - s2_1) label(`ylab' - benchmark) nuniq(`nu')
 35.             quietly test s1_1 = s2_1
 36.             a2_posttest, item(A2.7c) spec(A2.7c_`ytag'_`bm'_identical_rows) sample(`smp' & year<=2020 & `bm' observed) mobility(`mlab') label(test `ytag' = benchmark) chi2(`r(chi2)') df(`r(df)') 
> p(`r(p)') nuniq(`nu')
 37.             display as result "A2_7c `ytag' `m' `bm' N=`nu' outcome=" %9.6f _b[s1_1] " benchmark=" %9.6f _b[s2_1] " gap=${A2_STACK_GAP}"
 38.             restore
 39.             nflow step "restore: after A2.7c `ytag' `bm' `mlab' stacked test"
 40.         }
 41.     }
 42. }
