. use year v_ttl_k mob_bilat_vis mob_bilat_tour lag_bilat_vis lead_bilat_vis lag_bilat_tour lead_bilat_tour ///
>     exporter_year importer_year pair_id using "${PREPARED}", clear
(PREP analysis base, vintage corrected2x, built  5 Nov 2026 10:41:37 by 01_prep.d)

. nflow start using "${OUT}/C2_A1_11b_nflow.csv", replace expected(823446)
nflow: log <PACKAGE_ROOT>/05_output/10_analysis/corrected2x/C2_A1_11b_nflow.csv, start N =      823,446

. gen double time_c = year - 2007

. local FET "exporter_year importer_year pair_id##c.time_c"

. 
. tempname CS

. postfile `CS' str5 mobility str40 model double(N n_separated n_singletons b_lag se_lag b_cur se_cur b_lead se_lead) ///
>     using "${OUT}/tables/A1_A1.7_common_sample_check.dta", replace
(file <PACKAGE_ROOT>/05_output/10_analysis/corrected2x/tables/A1_A1.7_common_sample_check.dta not found)

. foreach m in vis tour {
  2.     local X "lag_bilat_`m' mob_bilat_`m' lead_bilat_`m'"
  3.     * ---- (1) dynamic trend fit as in C2_A1_11_leadpower_mu.do:86 (= A1.8.T7_pair_sepmu)
.     ppmlhdfe v_ttl_k `X', absorb(`FET') vce(cluster pair_id) separation(fe simplex ir mu)
  4.     assert e(converged) == 1
  5.     assert e(N) == cond("`m'" == "vis", 13565, 18868)
  6.     nflow est "C2_A1_11b `m' dynamic pair-trend fit, separation(fe simplex ir mu) (= A1.8.T7_pair_sepmu)"
  7.     gen byte __m1 = e(sample)
  8.     post `CS' ("`m'") ("dynamic, own sample") (e(N)) (e(num_separated)) (e(num_singletons)) ///
>         (_b[lag_bilat_`m']) (_se[lag_bilat_`m']) (_b[mob_bilat_`m']) (_se[mob_bilat_`m']) (_b[lead_bilat_`m']) (_se[lead_bilat_`m'])
  9.     * ---- (2) static reference fit on the dynamic sample, as in C2_A1_11_leadpower_mu.do:98
.     ppmlhdfe v_ttl_k mob_bilat_`m' if __m1, absorb(`FET') vce(cluster pair_id) separation(fe simplex ir mu)
 10.     assert e(converged) == 1
 11.     assert e(N) == cond("`m'" == "vis", 13564, 18865)
 12.     nflow est "C2_A1_11b `m' static pair-trend fit on the dynamic sample (Table S9.3 reference)"
 13.     gen byte __s1 = e(sample)
 14.     post `CS' ("`m'") ("static, on dynamic sample") (e(N)) (e(num_separated)) (e(num_singletons)) ///
>         (.) (.) (_b[mob_bilat_`m']) (_se[mob_bilat_`m']) (.) (.)
 15.     * ---- (3) the observations the static fit removes: identifiers and zero-trade indicator only
.     gen byte __zero = (v_ttl_k == 0) if __m1 & !__s1
 16.     display as result "C2_A1_11b_REMOVED `m'"
 17.     list pair_id year __zero if __m1 & !__s1, noobs clean
 18.     * ---- (4) dynamic trend fit on the static fit's sample (common sample)
.     ppmlhdfe v_ttl_k `X' if __s1, absorb(`FET') vce(cluster pair_id) separation(fe simplex ir mu)
 19.     assert e(converged) == 1
 20.     nflow est "C2_A1_11b `m' dynamic pair-trend fit on the static reference sample (common sample)"
 21.     post `CS' ("`m'") ("dynamic, on static sample") (e(N)) (e(num_separated)) (e(num_singletons)) ///
>         (_b[lag_bilat_`m']) (_se[lag_bilat_`m']) (_b[mob_bilat_`m']) (_se[mob_bilat_`m']) (_b[lead_bilat_`m']) (_se[lead_bilat_`m'])
 22.     display as result "C2_A1_11b_COMMON `m' N=" e(N) " b_cur=" %12.9f _b[mob_bilat_`m'] " b_lead=" %12.9f _b[lead_bilat_`m'] ///
>         " se_lead=" %12.9f _se[lead_bilat_`m']
 23.     drop __m1 __s1 __zero
 24. }
