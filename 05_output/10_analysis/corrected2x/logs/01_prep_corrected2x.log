. pkg_py "${CODE}/01a_hs6_products.py" ${VINTAGE} "${CT_RAW_DIR}" "${CT_MANIFEST}" "${CT_INT}" "${CT_CROSSWALK}" "${HS6_FILE}" "${HS6_STATUS}" > "${LOGS}/01a_hs6_products_${VINTAGE}.log" 2>&1


