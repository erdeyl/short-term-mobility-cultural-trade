. * Exact visitor-tourist common support (02_sensitivity/01_common_support_visitors_tourists.do:116-170)
. gen byte common_vt_candidate = ///
>     has_both_vis == 1 & has_both_tour == 1 & ///
>     !missing(v_ttl_k, mob_bilat_vis, mob_bilat_tour)

. gen byte s_cs_exact = common_vt_candidate

. local converged = 0

. local iterations = 0

. forvalues iter = 1/10 {
  2.     local iterations = `iter'
  3.     capture drop __es_vis __es_tour
  4.     quietly ppmlhdfe v_ttl_k mob_bilat_vis if s_cs_exact, absorb(`FE') vce(cluster `CLUSTER')
  5.     gen byte __es_vis = e(sample)
  6.     _postcounts `SC' "CS_iter`iter'_vis" "v_ttl_k mob_bilat_vis if s_cs_exact (iteration)"
  7.     quietly ppmlhdfe v_ttl_k mob_bilat_tour if s_cs_exact, absorb(`FE') vce(cluster `CLUSTER')
  8.     gen byte __es_tour = e(sample)
  9.     _postcounts `SC' "CS_iter`iter'_tour" "v_ttl_k mob_bilat_tour if s_cs_exact (iteration)"
 10.     quietly count if s_cs_exact & (!__es_vis | !__es_tour)
 11.     local n_to_remove = r(N)
 12.     if `n_to_remove' == 0 {
 13.         local converged = 1
 14.         continue, break
 15.     }
 16.     replace s_cs_exact = s_cs_exact & __es_vis & __es_tour
 17. }
(750 real changes made)

. if `converged' == 0 {
.     display as error "Exact common-support intersection did not converge within 10 iterations."
.     exit 430
. }

. drop __es_vis __es_tour

. quietly count if common_vt_candidate

. display as result "CS_RAW_CANDIDATE_ROWS=" r(N)
CS_RAW_CANDIDATE_ROWS=3207

. quietly count if s_cs_exact

. display as result "CS_EXACT_ROWS=" r(N) " ITERATIONS=`iterations'"
CS_EXACT_ROWS=2457 ITERATIONS=2

. rename common_vt_candidate s_cs_candidate

. label variable s_cs_candidate "Raw visitor-tourist common-support candidate (01_common_support:116-118)"

