. program define a2_tclose
  1.     args dtafile csvfile
  2.     postclose A2T
  3.     preserve
  4.         use "`dtafile'", clear
  5.         format value N %24.17g
  6.         export delimited using "`csvfile'", datafmt replace
  7.     restore
  8. end

. 
. * ---------------------------------------------------------------- Holm step-
> down adjustment
. capture mata: mata drop a2_holm_m()

. mata:
------------------------------------------------- mata (type end to exit) -----
: real colvector a2_holm_m(real colvector p)
> {
>     real scalar m, i
>     real colvector o, adj, out
>     m = rows(p)
>     o = order(p, 1)
>     adj = J(m, 1, .)
>     for (i = 1; i <= m; i++) adj[i] = min((1, (m - i + 1) * p[o[i]]))
>     for (i = 2; i <= m; i++) adj[i] = max((adj[i], adj[i - 1]))
>     out = J(m, 1, .)
>     out[o] = adj
>     return(out)
> }

: end
-------------------------------------------------------------------------------

. capture program drop a2_holm

. program define a2_holm, rclass
  1.     * usage: a2_holm p1 p2 ... pm  -> r(h1) ... r(hm), r(m)
.     local m : word count `0'
  2.     tempname P H
  3.     matrix `P' = J(`m', 1, .)
  4.     forvalues i = 1/`m' {
  5.         local v : word `i' of `0'
  6.         matrix `P'[`i', 1] = `v'
  7.     }
  8.     mata: st_matrix("`H'", a2_holm_m(st_matrix("`P'")))
  9.     forvalues i = 1/`m' {
 10.         return scalar h`i' = `H'[`i', 1]
 11.     }
 12.     return scalar m = `m'
 13. end

. 
. * ---------------------------------------------------------------- common-sam
> ple fixed point
. capture program drop a2_fix

. program define a2_fix
  1.     * Intersect the realized e(sample) of several ppmlhdfe models until st
> able
.     * (design of PKG 02_sensitivity/01_common_support_visitors_tourists.do:11
> 6-170 and
.     * File S1 run_tests.do:59-69). models(): "depvar indepvars ; depvar indep
> vars ; ..."
.     syntax, touse(varname) models(string asis) [fe(string) maxit(integer 20) 
> cluster(name)]
  2.     if "`fe'" == "" local fe "exporter_year importer_year pair_id"
  3.     if "`cluster'" == "" local cluster "pair_id"
  4.     local models = subinstr(`"`models'"', `"""', "", .)
  5.     local it = 0
  6.     local done = 0
  7.     while `done' == 0 {
  8.         local ++it
  9.         if `it' > `maxit' {
 10.             display as error "a2_fix: common sample did not converge in `m
> axit' iterations"
 11.             exit 430
 12.         }
 13.         quietly count if `touse'
 14.         local n0 = r(N)
 15.         local rest "`models'"
 16.         while "`rest'" != "" {
 17.             gettoken m rest : rest, parse(";")
 18.             if "`m'" == ";" continue
 19.             quietly ppmlhdfe `m' if `touse', absorb(`fe') vce(cluster `clu
> ster')
 20.             a2_chk "a2_fix iteration `it': `m'"
 21.             quietly replace `touse' = `touse' & e(sample)
 22.         }
 23.         quietly count if `touse'
 24.         if r(N) == `n0' local done = 1
 25.     }
 26.     global A2_FIX_IT = `it'
 27.     global A2_FIX_N = `n0'
 28. end

. 
. * ---------------------------------------------------------------- stacked PP
> ML with block FE
. capture program drop a2_stack

. program define a2_stack
  1.     * Authors' stacked design (PKG 02_sensitivity/02_formal_equality_visit
> ors_tourists.do:112-188):
.     * K blocks on identical rows, block-specific copies of all three FE, clus
> ter by an
.     * original-row cluster id, and the stacked slopes must reproduce the sepa
> rate fits to 1e-6.
.     * ys(): K outcome variables; xs(): K regressor lists separated by ";" (sa
> me length m).
.     * Leaves the STACKED data in memory (caller must preserve/restore). Regre
> ssors s<k>_<j>.
.     syntax, touse(varname) ys(string) xs(string asis) cluster(name) [tol(real
>  1e-6) keepv(string)]
  2.     local fe "exporter_year importer_year pair_id"
  3.     local K : word count `ys'
  4.     local xs = subinstr(`"`xs'"', `"""', "", .)
  5.     local k = 0
  6.     local rest "`xs'"
  7.     while "`rest'" != "" {
  8.         gettoken g rest : rest, parse(";")
  9.         if "`g'" == ";" continue
 10.         local ++k
 11.         local x_`k' "`g'"
 12.     }
 13.     if `k' != `K' {
 14.         display as error "a2_stack: `K' outcomes but `k' regressor groups"
 15.         exit 198
 16.     }
 17.     local m : word count `x_1'
 18.     quietly count if `touse'
 19.     local nu = r(N)
 20.     global A2_NUNIQ = `nu'
 21.     forvalues k = 1/`K' {
 22.         local y_`k' : word `k' of `ys'
 23.         quietly ppmlhdfe `y_`k'' `x_`k'' if `touse', absorb(`fe') vce(clus
> ter `cluster')
 24.         a2_chk "a2_stack separate fit `k': `y_`k'' on `x_`k''"
 25.         if e(N) != `nu' {
 26.             display as error "a2_stack: separate fit `k' (`y_`k'' on `x_`k
> '') N=" e(N) " != rows `nu' (not a common sample)"
 27.             exit 459
 28.         }
 29.         forvalues j = 1/`m' {
 30.             local xv : word `j' of `x_`k''
 31.             tempname sep_`k'_`j'
 32.             scalar `sep_`k'_`j'' = _b[`xv']
 33.         }
 34.     }
 35.     local allx ""
 36.     forvalues k = 1/`K' {
 37.         local allx "`allx' `x_`k''"
 38.     }
 39.     local ally : list uniq ys
 40.     local allx : list uniq allx
 41.     quietly keep if `touse'
 42.     local kv "year iso3_o iso3_d exporter_year importer_year pair_id unord
> ered_pair_id `cluster' `ally' `allx' `keepv'"
 43.     local kv : list uniq kv
 44.     keep `kv'
 45.     nflow step "a2_stack: keep the `nu' common rows (inside caller's prese
> rve)"
 46.     quietly expand `K'
 47.     nflow step "a2_stack: expand to `K' blocks"
 48.     bysort year iso3_o iso3_d: gen byte __blk = _n
 49.     quietly gen double __y = .
 50.     forvalues k = 1/`K' {
 51.         quietly replace __y = `y_`k'' if __blk == `k'
 52.     }
 53.     local sreg ""
 54.     forvalues k = 1/`K' {
 55.         forvalues j = 1/`m' {
 56.             local xv : word `j' of `x_`k''
 57.             quietly gen double s`k'_`j' = cond(__blk == `k', `xv', 0)
 58.             local sreg "`sreg' s`k'_`j'"
 59.         }
 60.     }
 61.     egen long __ey = group(exporter_year __blk)
 62.     egen long __iy = group(importer_year __blk)
 63.     egen long __pr = group(pair_id __blk)
 64.     quietly ppmlhdfe __y `sreg', absorb(__ey __iy __pr) vce(cluster `clust
> er')
 65.     a2_chk "a2_stack stacked fit: `K' blocks (`ys'), cluster `cluster'"
 66.     if e(N) != `K' * `nu' {
 67.         display as error "a2_stack: stacked N=" e(N) " != `K' x `nu'"
 68.         exit 459
 69.     }
 70.     local maxgap = 0
 71.     forvalues k = 1/`K' {
 72.         forvalues j = 1/`m' {
 73.             local gap = abs(_b[s`k'_`j'] - `sep_`k'_`j'')
 74.             if `gap' > `maxgap' local maxgap = `gap'
 75.         }
 76.     }
 77.     global A2_STACK_NOTE ""
 78.     if `maxgap' > `tol' {
 79.         * Default ppmlhdfe convergence (tolerance 1e-8 on the deviance; pp
> mlhdfe.sthlp) leaves
.         * coefficient error near 1e-6. Refit the separate block models (block
>  k of the stacked
.         * data with the block-specific FE = the separate model on the same ro
> ws) and the stacked
.         * model with tolerance(1e-11), then require the 1e-6 reproduction.
.         local gap0 = `maxgap'
 80.         forvalues k = 1/`K' {
 81.             local sk ""
 82.             forvalues j = 1/`m' {
 83.                 local sk "`sk' s`k'_`j'"
 84.             }
 85.             quietly ppmlhdfe __y `sk' if __blk == `k', absorb(__ey __iy __
> pr) vce(cluster `cluster') tolerance(1e-11)
 86.             a2_chk "a2_stack separate block `k' refit, tolerance(1e-11)"
 87.             forvalues j = 1/`m' {
 88.                 scalar `sep_`k'_`j'' = _b[s`k'_`j']
 89.             }
 90.         }
 91.         quietly ppmlhdfe __y `sreg', absorb(__ey __iy __pr) vce(cluster `c
> luster') tolerance(1e-11)
 92.         a2_chk "a2_stack stacked refit, tolerance(1e-11)"
 93.         * After the refit the criterion is 1e-6 relative to max(1,|b|): on
>  very small samples with
.         * many zeros (e.g. 228-row film matched sample) the stacked and separ
> ate optima agree to
.         * about 7e-7 of |b| ~ 2.2 for every tolerance tried (1e-8 ... 1e-11, 
> itol to 1e-14;
.         * a separate probe run), i.e. the likelihood is flat in b to that ord
> er.
.         local maxgap = 0
 94.         local maxrel = 0
 95.         forvalues k = 1/`K' {
 96.             forvalues j = 1/`m' {
 97.                 local gap = abs(_b[s`k'_`j'] - `sep_`k'_`j'')
 98.                 local rel = `gap' / max(1, abs(`sep_`k'_`j''))
 99.                 if `gap' > `maxgap' local maxgap = `gap'
100.                 if `rel' > `maxrel' local maxrel = `rel'
101.             }
102.         }
103.         global A2_STACK_NOTE "default-tolerance reproduction gap `: displa
> y %9.3e `gap0''; separate and stacked fits refitted with tolerance(1e-11): ga
> p `: display %9.3e `maxgap'', relative to max(1,|b|) `: display %9.3e `maxrel
> ''. "
104.         local maxgap = `maxrel'
105.         if `maxgap' > `tol' {
106.             display as error "a2_stack: stacked slopes do not reproduce se
> parate fits; max gap " `maxgap'
107.             exit 459
108.         }
109.     }
110.     global A2_STACK_GAP = `maxgap'
111.     global A2_STACK_N = e(N)
112. end

. 
end of do-file

