. /****************************************************************************
> ***
>  A2_00_programs.do -- shared programs for block A2 (re-run after every `clear
>  all`).
> 
>  Help files consulted (installed versions): ppmlhdfe.sthlp 2.3.4 (absorb(), v
> ce(cluster),
>  d(newvar) "mandatory if running predict afterwards", e(N_full) "number of ob
> servations,
>  including dropped singleton and separated observations", e(num_singletons),
>  e(num_separated), e(converged) "1 if converged"; singletons "dropped iterati
> vely"),
>  reghdfe.sthlp 6.14.1 ([indepvars] optional, weights, residuals(newvar)), [R]
>  lincom
>  (r(estimate) r(se) r(p) r(lb) r(ub)), [R] test (r(chi2) r(df) r(p)), [P] pos
> tfile,
>  [M-5] order(). Reporting checklist (authors' ppmlhdfe notes): every ppmlhdfe
>  fit
>  asserts e(converged)==1 and N_full = N + num_singletons + num_separated (ins
> talled accounting).
> *****************************************************************************
> **/
. 
. * ---------------------------------------------------------------- results po
> stfile
. capture program drop a2_open

. program define a2_open
  1.     args file
  2.     capture postclose A2H
  3.     postfile A2H str10 vintage str3 block str8 item str64 spec str48 sampl
> e str12 mobility ///
>         str80 term double(b se p ci_lo ci_hi N N_full n_singletons n_separate
> d n_clusters) ///
>         str20 cluster_var str244 note using "`file'", replace
  4. end

. 
. capture program drop a2_close

. program define a2_close
  1.     * close the postfile and write the lossless CSV next to it (stat-dev d
> ata-result-contracts:
.     * doubles %24.17g, export with datafmt)
.     args dtafile csvfile
  2.     postclose A2H
  3.     preserve
  4.         use "`dtafile'", clear
  5.         format b se p ci_lo ci_hi N N_full n_singletons n_separated n_clus
> ters %24.17g
  6.         export delimited using "`csvfile'", datafmt replace
  7.     restore
  8. end

. 
. * ---------------------------------------------------------------- fit checks
. capture program drop a2_chk

. program define a2_chk
  1.     * a2_chk ["label"]: asserts the ppmlhdfe accounting of the CURRENT e()
> ; with a label it also
.     * writes the nflow est record (nflow.sthlp: "Call nflow est right after t
> he estimation").
.     * Called with a label after EVERY fit in block A2 (audit check); called w
> ithout a label
.     * only as a guard inside the posting programs.
.     args label
  2.     if "`e(cmd)'" == "ppmlhdfe" {
  3.         assert e(converged) == 1
  4.         assert e(N_full) == e(N) + e(num_singletons) + e(num_separated)
  5.     }
  6.     if `"`label'"' != "" nflow est `"`label'"'
  7. end

. 
. * (restore cannot be wrapped in a program: preserve/restore are scoped to the
>  program level,
. *  so callers write `restore' followed by `nflow step "restore: ..."' -- nflo
> w.sthlp: "Log a
. *  restore with nflow step too")
. 
. * ---------------------------------------------------------------- post a lin
> ear combination
. capture program drop a2_post

. program define a2_post
  1.     syntax, item(string) spec(string) sample(string) mobility(string) term
> (string) ///
>         [label(string) note(string) nuniq(real -1) level(real 95)]
  2.     a2_chk
  3.     local N = e(N)
  4.     local stk ""
  5.     if `nuniq' >= 0 {
  6.         local N = `nuniq'
  7.         local stk "stacked fit e(N)=`e(N)'; N = unique pair-years. ${A2_ST
> ACK_NOTE}"
  8.     }
  9.     local nf = .
 10.     local ns = .
 11.     local nsep = .
 12.     if "`e(cmd)'" == "ppmlhdfe" {
 13.         local nf = e(N_full)
 14.         local ns = e(num_singletons)
 15.         local nsep = e(num_separated)
 16.     }
 17.     if "`e(cmd)'" == "reghdfe" local ns = e(num_singletons)
 18.     local ncl = e(N_clust)
 19.     if missing(`ncl') local ncl = e(N_clust1)
 20.     local cv "`e(clustvar)'"
 21.     if "`label'" == "" local label "`term'"
 22.     quietly lincom `term', level(`level')
 23.     post A2H ("${VINTAGE}") ("A2") ("`item'") ("`spec'") ("`sample'") ("`m
> obility'") ("`label'") ///
>         (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub)) (`N') (`nf') (`ns') (`ns
> ep') (`ncl') ("`cv'") ///
>         (`"`stk'`note'"')
 24. end

. 
. * ---------------------------------------------------------------- post a Wal
> d test (b = chi2, se = df)
. capture program drop a2_posttest

. program define a2_posttest
  1.     syntax, item(string) spec(string) sample(string) mobility(string) labe
> l(string) ///
>         chi2(real) df(real) p(real) [note(string) nuniq(real -1)]
  2.     a2_chk
  3.     local N = e(N)
  4.     local stk ""
  5.     if `nuniq' >= 0 {
  6.         local N = `nuniq'
  7.         local stk "stacked fit e(N)=`e(N)'; N = unique pair-years. ${A2_ST
> ACK_NOTE}"
  8.     }
  9.     local nf = .
 10.     local ns = .
 11.     local nsep = .
 12.     if "`e(cmd)'" == "ppmlhdfe" {
 13.         local nf = e(N_full)
 14.         local ns = e(num_singletons)
 15.         local nsep = e(num_separated)
 16.     }
 17.     local ncl = e(N_clust)
 18.     if missing(`ncl') local ncl = e(N_clust1)
 19.     post A2H ("${VINTAGE}") ("A2") ("`item'") ("`spec'") ("`sample'") ("`m
> obility'") ("`label'") ///
>         (`chi2') (`df') (`p') (.) (.) (`N') (`nf') (`ns') (`nsep') (`ncl') ("
> `e(clustvar)'") ///
>         (`"Wald test: b = chi2, se = df, p = p. `stk'`note'"')
 20. end

