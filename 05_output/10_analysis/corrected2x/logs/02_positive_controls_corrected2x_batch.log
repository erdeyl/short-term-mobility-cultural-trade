. do "${ORIG_SENS}/02_formal_equality_visitors_tourists.do" "${PC}/root"

. /*******************************************************************************
>  02_formal_equality_visitors_tourists.do
> 
>  STEP 2: Formal equality test of visitor and tourist mobility slopes.
> 
>  Research question:
>    On the EXACT same realized PPML observations constructed in Step 1, can we
>    reject H0: beta_visitors = beta_tourists?
> 
>  Method:
>    Stack the exact-common-support sample twice:
>      measure = 1 -> bilateral visitors
>      measure = 2 -> bilateral tourists
> 
>    Estimate a joint PPML with measure-specific exporter-year, importer-year,
>    and directed-pair fixed effects. Cluster by the original directed pair.
> 
>    This reproduces the two separate exact-common-support slope estimates in a
>    single joint model and yields their covariance, allowing a valid Wald test
>    of the slope difference.
> 
>  Input:
>    03_intermediate/03_Mobility/sensitivity/01_common_support/common_support_vt_exact.dta
> 
>  Outputs:
>    08_sensitivity/02_formal_equality/
> *******************************************************************************/
. 
. clear all

. set more off

. set linesize 255

. version 18.0

. set varabbrev off

. 
. args PROJECT_ROOT

. if `"`PROJECT_ROOT'"' == "" {
.     di as error "Supply the replication-package root as argument 1."
.     exit 198
. }

. local PROJECT_ROOT = subinstr(`"`PROJECT_ROOT'"', "\", "/", .)

. 
. global ROOT     `"`PROJECT_ROOT'"'

. global INDATA   "${ROOT}/03_intermediate/03_Mobility/sensitivity/01_common_support/common_support_vt_exact.dta"

. global OUTROOT  "${ROOT}/05_output/03_Mobility/02_empirical_analysis/02_sensitivity/02_formal_equality"

. global TABLES   "${OUTROOT}/tables"

. global DIAG     "${ROOT}/05_output/03_Mobility/01_diagnostics/sensitivity/02_formal_equality"

. global LOGS     "${ROOT}/05_output/03_Mobility/03_logs/sensitivity/02_formal_equality"

. 
. capture mkdir "${ROOT}/05_output/03_Mobility/02_empirical_analysis"

. capture mkdir "${ROOT}/05_output/03_Mobility/02_empirical_analysis/02_sensitivity"

. capture mkdir "${OUTROOT}"

. capture mkdir "${TABLES}"

. capture mkdir "${DIAG}"

. capture mkdir "${LOGS}"

. 
. capture log close _all

