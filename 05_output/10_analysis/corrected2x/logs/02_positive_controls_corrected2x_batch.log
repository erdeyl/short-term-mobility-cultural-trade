. use "${INDATA}", clear
(PREP analysis base, vintage corrected2x, built  4 Nov 2026 08:33:39 by 01_prep.d)

. isid year iso3_o iso3_d

. 
. foreach v in ///
>     year iso3_o iso3_d pair_id exporter_year importer_year ///
