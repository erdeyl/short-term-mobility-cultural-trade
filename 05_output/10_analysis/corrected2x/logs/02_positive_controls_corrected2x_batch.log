  5.     local lab = cond(inlist("`est'", "ORIG_VIS", "CS_VIS"), "Bilateral visitors", "Bilateral tourists")
  6.     post `H1' ("CS.c`j'.`lab'.b") (_b[`var']) ("b")
  7.     post `H1' ("CS.c`j'.`lab'.se") (_se[`var']) ("se")
  8.     post `H1' ("CS.c`j'.N.N") (e(N)) ("N")
  9.     post `H1' ("CSK.`=cond(strpos("`est'","VIS"),"visitors","tourists")'.`=cond(strpos("`est'","ORIG"),"own","exact")'.b") (_b[`var']) ("b")
 10.     post `H1' ("CSK.`=cond(strpos("`est'","VIS"),"visitors","tourists")'.`=cond(strpos("`est'","ORIG"),"own","exact")'.se") (_se[`var']) ("se")
 11. }

