. 
. *==============================================================================
. * A1.9 (ii) exporter-reported (mirror) vs importer-reported trade, A4 reporting-side support
. *==============================================================================
. tempname SUP

. postfile `SUP' str5 mobility str40 step double(rows) using "${OUT}/tables/A1_A1.9_support.dta", replace
(file <PACKAGE_ROOT>/05_output/10_analysis/corrected2x/tables/A1_A1.9_support.dta not found)

. foreach m in vis tour {
  2.     local mm = cond("`m'" == "vis", "visitors", "tourists")
  3.     * A4 support exactly as 04_run_mirror_sensitivity.do:118-166
.     gen byte __ct = has_both_`m' == 1 & !missing(v_ttl_k, v_ttl_exporter_lb_k, mob_bilat_`m')
  4.     quietly count if __ct
  5.     post `SUP' ("`m'") ("A4 raw candidate (both trade sides observed)") (r(N))
  6.     local conv 0
  7.     forvalues it = 1/10 {
  8.         capture drop __i __e
  9.         quietly ppmlhdfe v_ttl_k mob_bilat_`m' if __ct, absorb(${FE}) vce(cluster pair_id)
 10.         gen byte __i = e(sample)
 11.         nflow est "A1.9 A4 support iteration `it' importer `m' (immediate record, audit R1-10)"
 12.         quietly ppmlhdfe v_ttl_exporter_lb_k mob_bilat_`m' if __ct, absorb(${FE}) vce(cluster pair_id)
 13.         gen byte __e = e(sample)
 14.         nflow est "A1.9 A4 support iteration `it' exporter `m' (immediate record, audit R1-10)"
 15.         quietly count if __ct & (!__i | !__e)
 16.         if r(N) == 0 {
 17.             local conv 1
 18.             continue, break
 19.         }
 20.         replace __ct = __ct & __i & __e
 21.     }
 22.     assert `conv' == 1
 23.     drop __i __e
 24.     quietly count if __ct
 25.     post `SUP' ("`m'") ("A4 bilateral common support (iterated)") (r(N))
 26.     capture noisily ppmlhdfe v_ttl_k mob_bilat_`m' if __ct, absorb(${FE}) vce(cluster pair_id)
 27.     A1_after, rc(`=_rc') item(A1.9) spec(A4_bilat_importer) sample(A4 common support) mobility(`m') terms(mob_bilat_`m')
 28.     if ${A4PC} assert abs(_b[mob_bilat_`m'] - ${A4_`mm'_importer_b}) < 1e-6 & e(N) == ${A4_`mm'_importer_N}
 29.     capture noisily ppmlhdfe v_ttl_exporter_lb_k mob_bilat_`m' if __ct, absorb(${FE}) vce(cluster pair_id)
 30.     A1_after, rc(`=_rc') item(A1.9) spec(A4_bilat_exporter) sample(A4 common support) mobility(`m') terms(mob_bilat_`m')
 31.     if ${A4PC} assert abs(_b[mob_bilat_`m'] - ${A4_`mm'_exporter_b}) < 1e-6 & e(N) == ${A4_`mm'_exporter_N}
 32.     if ${A4PC} display as result "A1.9_PC_TABLE_A4_`m' PASS"
 33.     else display as result "A1.9_PC_TABLE_A4_`m' NOT APPLICABLE (no published A4 for ${VINTAGE})"
 34.     * joint directional models on the A4 support; iterate to identical observations for both sides
.     gen byte __cd = __ct
 35.     local conv 0
 36.     forvalues it = 1/10 {
 37.         capture drop __i __e
 38.         quietly ppmlhdfe v_ttl_k mob_rev_`m' mob_same_`m' if __cd, absorb(${FE}) vce(cluster pair_id)
 39.         gen byte __i = e(sample)
 40.         nflow est "A1.9 directional support iteration `it' importer `m' (immediate record, audit R1-10)"
 41.         quietly ppmlhdfe v_ttl_exporter_lb_k mob_rev_`m' mob_same_`m' if __cd, absorb(${FE}) vce(cluster pair_id)
 42.         gen byte __e = e(sample)
 43.         nflow est "A1.9 directional support iteration `it' exporter `m' (immediate record, audit R1-10)"
 44.         quietly count if __cd & (!__i | !__e)
 45.         if r(N) == 0 {
 46.             local conv 1
 47.             continue, break
 48.         }
 49.         replace __cd = __cd & __i & __e
 50.     }
 51.     assert `conv' == 1
 52.     drop __i __e
 53.     quietly count if __cd
 54.     post `SUP' ("`m'") ("directional common support (identical rows both sides)") (r(N))
 55.     foreach cl in pair_id unordered_pair_id {
 56.         A1_dirfit, y(v_ttl_k) m(`m') cond(__cd) item(A1.9) spec(dirA4_importer) cl(`cl') note("importer-reported trade (reported by j); A4 support")
 57.         A1_dirfit, y(v_ttl_exporter_lb_k) m(`m') cond(__cd) item(A1.9) spec(dirA4_exporter) cl(`cl') note("exporter-reported trade (reported by i); A4 support")
 58.     }
 59.     * supplementary stacked test: is the reverse-minus-same gap equal across reporting sides?
.     foreach cl in pair_id unordered_pair_id {
 60.         preserve
 61.             keep if __cd
 62.             nflow step "A1.9 stacked side test `m' `cl': keep directional common support"
 63.             keep year iso3_o iso3_d exporter_year importer_year pair_id unordered_pair_id v_ttl_k v_ttl_exporter_lb_k mob_rev_`m' mob_same_`m'
 64.             expand 2
 65.             nflow step "A1.9 stacked side test `m' `cl': expand 2 (side 1 importer, side 2 exporter)"
 66.             bysort year iso3_o iso3_d: gen byte __side = _n
 67.             gen double __y = cond(__side == 1, v_ttl_k, v_ttl_exporter_lb_k)
 68.             gen double rev_imp = cond(__side == 1, mob_rev_`m', 0)
 69.             gen double same_imp = cond(__side == 1, mob_same_`m', 0)
 70.             gen double rev_exp = cond(__side == 2, mob_rev_`m', 0)
 71.             gen double same_exp = cond(__side == 2, mob_same_`m', 0)
 72.             egen long __ey = group(exporter_year __side)
 73.             egen long __iy = group(importer_year __side)
 74.             egen long __pp = group(pair_id __side)
 75.             capture noisily ppmlhdfe __y rev_imp same_imp rev_exp same_exp, absorb(__ey __iy __pp) vce(cluster `cl')
 76.             local rc = _rc
 77.             if `rc' == 0 & e(converged) == 1 {
 78.                 assert e(N_full) == e(N) + e(num_singletons) + e(num_separated)
 79.                 nflow est "A1.9 stacked side test `m' `cl'"
 80.                 foreach t in rev_imp same_imp rev_exp same_exp {
 81.                     A1_post1, item(A1.9) spec(dirA4_stacked_`cl') sample(directional common support x2) mobility(`m') term(`t') note("stacked, side-specific FE")
 82.                 }
 83.                 quietly test (rev_imp - same_imp) = (rev_exp - same_exp)
 84.                 A1_posttest, item(A1.9) spec(dirA4_stacked_`cl'_test) sample(directional common support x2) mobility(`m') term(gap_imp_eq_gap_exp) ///
>                     stat(`r(chi2)') df(`r(df)') p(`r(p)') nobs(`=e(N)') nfull(`=e(N_full)') ncl(`=e(N_clust)') clv(`e(clustvar)') ///
>                     note("H0 (rev-same) importer side = (rev-same) exporter side; supplementary")
 85.                 quietly lincom (rev_imp - same_imp) - (rev_exp - same_exp)
 86.                 A1_postlincom, item(A1.9) spec(dirA4_stacked_`cl'_diff) sample(directional common support x2) mobility(`m') term(gap_imp_minus_gap_exp) note("supplementary")
 87.             }
 88.             else {
 89.                 A1_posttest, item(A1.9) spec(dirA4_stacked_`cl'_test) sample(directional common support x2) mobility(`m') term(gap_imp_eq_gap_exp) ///
>                     stat(.) df(.) p(.) note("FAILED stacked fit rc=`rc'")
 90.             }
 91.         restore
 92.         nflow step "A1.9 stacked side test `m' `cl': restore"
 93.     }
 94.     drop __ct __cd
 95. }
