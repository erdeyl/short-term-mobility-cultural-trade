. display as result "A2_4_BEGIN vintage=${VINTAGE} " c(current_date) " " c(current_time)
A2_4_BEGIN vintage=corrected2x  5 Nov 2026 10:47:50

. use "${OUT}/A2_work.dta", clear
(PREP analysis base, vintage corrected2x, built  5 Nov 2026 10:41:37 by 01_prep.d)

. nflow start using "${OUT}/A2_nflow.csv", append
nflow: log <PACKAGE_ROOT>/05_output/10_analysis/corrected2x/A2_nflow.csv, start N =       56,500

. a2_open "${OUT}/results/A2_4.dta"
(file <PACKAGE_ROOT>/05_output/10_analysis/corrected2x/results/A2_4.dta not found)

. local FE "exporter_year importer_year pair_id"

. 
. capture program drop a2_scales

. program define a2_scales
  1.     * after a fit: post 100b, 100(exp(b)-1), 100(1.1^b-1) for coefficient `x'
.     syntax, x(name) spec(string) sample(string) mobility(string)
  2.     local N = e(N)
  3.     local b = _b[`x']
  4.     local se = _se[`x']
  5.     local z = invnormal(0.975)
  6.     local lo = `b' - `z' * `se'
  7.     local hi = `b' + `z' * `se'
  8.     local p = 2 * normal(-abs(`b' / `se'))
  9.     a2_postval, item(A2.4) spec(`spec') sample(`sample') mobility(`mobility') label(100*b: % per IHS unit, local) value(`=100*`b'') se(`=100*`se'') p(`p') lo(`=100*`lo'') hi(`=100*`hi'') n(`N') n
> ote("local semi-elasticity per IHS unit")
 10.     tempname V
 11.     quietly nlcom 100 * (exp(_b[`x']) - 1)
 12.     matrix `V' = r(V)
 13.     local sef = sqrt(`V'[1,1])
 14.     a2_postval, item(A2.4) spec(`spec') sample(`sample') mobility(`mobility') label(100*(exp(b)-1): % for +1 IHS unit) value(`=100*(exp(`b')-1)') se(`sef') p(`p') lo(`=100*(exp(`lo')-1)') hi(`=10
> 0*(exp(`hi')-1)') n(`N') note("finite change for a one-unit IHS increase (about a 172% increase in trips at large values, exp(1)-1); SE delta method; CI = transformed endpoints")
 15.     quietly nlcom 100 * (1.1^_b[`x'] - 1)
 16.     matrix `V' = r(V)
 17.     local se10 = sqrt(`V'[1,1])
 18.     a2_postval, item(A2.4) spec(`spec') sample(`sample') mobility(`mobility') label(100*(1.1^b-1): % for +10% trips) value(`=100*(1.1^`b'-1)') se(`se10') p(`p') lo(`=100*(1.1^`lo'-1)') hi(`=100*(
> 1.1^`hi'-1)') n(`N') note("change in expected trade for a 10% increase in trips at large values (asinh(1.1x)-asinh(x) ~ ln 1.1); SE delta method")
 19. end

. 
. foreach m in vis tour {
  2.     local mlab = cond("`m'" == "vis", "visitors", "tourists")
  3.     * ---------------- baseline PPML scales (Table 2 cols 1, 5)
.     quietly ppmlhdfe v_ttl_k mob_bilat_`m' if has_both_`m', absorb(`FE') vce(cluster pair_id)
  4.     a2_chk "A2.4 baseline PPML `mlab'"
  5.     a2_post, item(A2.4) spec(baseline_ppml) sample(has_both_`m') mobility(`mlab') term(mob_bilat_`m') label(b)
  6.     a2_scales, x(mob_bilat_`m') spec(baseline_ppml) sample(has_both_`m') mobility(`mlab')
  7. 
.     * ---------------- Table A1 LPM (09_tableA1_positive_trade.do:10-12)
.     quietly reghdfe positive_trade mob_bilat_`m', absorb(`FE') vce(cluster pair_id)
  8.     a2_chk "A2.4 Table A1 LPM `mlab'"
  9.     gen byte eA1_`m' = e(sample)
 10.     quietly summarize positive_trade if eA1_`m'
 11.     local sh = r(mean)
 12.     local nA1 = r(N)
 13.     a2_post, item(A2.4) spec(tableA1_lpm) sample(Table A1 sample) mobility(`mlab') term(100*mob_bilat_`m') label(pp per IHS unit) note("LPM, reghdfe; positive-trade share on sample = `sh'")
 14.     a2_post, item(A2.4) spec(tableA1_lpm) sample(Table A1 sample) mobility(`mlab') term((100/`sh')*mob_bilat_`m') label(relative % per IHS unit) note("pp / positive-trade share `sh' (share treate
> d as fixed)")
 15.     a2_postval, item(A2.4) spec(tableA1_lpm) sample(Table A1 sample) mobility(`mlab') label(positive-trade share) value(`sh') n(`nA1')
 16.     display as result "A2_4_A1 `m' b=" %10.7f _b[mob_bilat_`m'] " N=" e(N) " r2_a=" %8.5f e(r2_a)
 17.     local bA1 = _b[mob_bilat_`m']
 18.     local nA1e = e(N)
 19.     preserve
 20.         import delimited using "${OUT}/positive_controls.csv", clear asdouble varnames(1) stringcols(1)
 21.         local c = cond("`m'" == "vis", "c1.Bilateral visitors", "c2.Bilateral tourists")
 22.         quietly summarize reproduced if item == "TA1.`c'.b"
 23.         local refb = r(mean)
 24.         local c = cond("`m'" == "vis", "c1", "c2")
 25.         quietly summarize reproduced if item == "TA1.`c'.N.N"
 26.         local refn = r(mean)
 27.     restore
 28.     display as result "A2_4_PC_A1 `m' b=" %12.10f `bA1' " ref=" %12.10f `refb' " N=`nA1e' ref=`refn'"
 29.     assert abs(`bA1' - `refb') < 1e-9 & `nA1e' == `refn'
 30. 
.     * ---------------- File S1 T2 identical-sample fixed point (run_tests.do:56-84)
.     gen byte mt_`m' = has_both_`m' & !missing(v_ttl_k)
 31.     local it = 0
 32.     local done = 0
 33.     while `done' == 0 {
 34.         local ++it
 35.         if `it' > 10 error 430
 36.         quietly count if mt_`m'
 37.         local n0 = r(N)
 38.         quietly ppmlhdfe v_ttl_k mob_bilat_`m' if mt_`m', absorb(`FE') vce(cluster pair_id)
 39.         a2_chk "A2.4 T2 fixed point PPML `mlab' iteration `it'"
 40.         quietly replace mt_`m' = mt_`m' & e(sample)
 41.         quietly reghdfe positive_trade mob_bilat_`m' if mt_`m', absorb(`FE') vce(cluster pair_id)
 42.         a2_chk "A2.4 T2 fixed point LPM `mlab' iteration `it'"
 43.         quietly replace mt_`m' = mt_`m' & e(sample)
 44.         quietly count if mt_`m'
 45.         if r(N) == `n0' local done = 1
 46.     }
 47.     quietly summarize positive_trade if mt_`m'
 48.     local pbar = r(mean)
 49.     quietly ppmlhdfe v_ttl_k mob_bilat_`m' if mt_`m', absorb(`FE') vce(cluster pair_id)
 50.     a2_chk "A2.4 T2 PPML on identical sample `mlab'"
 51.     gen byte __e = e(sample)
 52.     assert __e == mt_`m'
 53.     drop __e
 54.     a2_post, item(A2.4) spec(T2_same_sample_ppml) sample(T2 identical sample) mobility(`mlab') term(100*mob_bilat_`m') label(100*b: % per IHS unit) note("File S1 T2 row 'expected trade, % per IHS
>  unit'; fixed-point iterations=`it'")
 55.     a2_scales, x(mob_bilat_`m') spec(T2_same_sample_ppml) sample(T2 identical sample) mobility(`mlab')
 56.     quietly reghdfe positive_trade mob_bilat_`m' if mt_`m', absorb(`FE') vce(cluster pair_id)
 57.     a2_chk "A2.4 T2 LPM on identical sample `mlab'"
 58.     gen byte __e = e(sample)
 59.     assert __e == mt_`m'
 60.     drop __e
 61.     a2_post, item(A2.4) spec(T2_same_sample_lpm) sample(T2 identical sample) mobility(`mlab') term(100*mob_bilat_`m') label(pp per IHS unit) note("Table A5 row 'probability of positive trade, per
> centage points'")
 62.     a2_post, item(A2.4) spec(T2_same_sample_lpm) sample(T2 identical sample) mobility(`mlab') term((100/`pbar')*mob_bilat_`m') label(relative % per IHS unit) note("pp / positive-trade share `pbar
> ' (File S1 T2 'LPM_relative_percent'; the text's 1.5% / 0.4%)")
 63.     a2_postval, item(A2.4) spec(T2_same_sample_lpm) sample(T2 identical sample) mobility(`mlab') label(positive-trade share) value(`pbar') n(`=e(N)')
 64.     display as result "A2_4_T2 `m' N=" e(N) " pp=" %10.7f 100*_b[mob_bilat_`m'] " rel=" %10.7f 100*_b[mob_bilat_`m']/`pbar' " pbar=" %10.8f `pbar'
 65. 
.     * ---------------- File S1 T1 and T9 rows
.     quietly ppmlhdfe v_ttl_k mob_bilat_`m' if has_both_`m' & v_ttl_k > 0 & !missing(v_ttl_k), absorb(`FE') vce(cluster pair_id)
 66.     a2_chk "A2.4 File S1 T1 positive trade only `mlab'"
 67.     a2_post, item(A2.4) spec(S1_T1_positive_only) sample(has_both & trade>0) mobility(`mlab') term(mob_bilat_`m') note("run_tests.do:40,44: pos = v_ttl_k>0 & !missing(v_ttl_k)")
 68.     quietly ppmlhdfe v_ttl_k mob_bilat_`m' if has_both_`m' & pos_every_year == 1, absorb(`FE') vce(cluster pair_id)
 69.     a2_chk "A2.4 File S1 T1 positive in every year `mlab'"
 70.     a2_post, item(A2.4) spec(S1_T1_positive_every_year) sample(has_both & pos_every_year) mobility(`mlab') term(mob_bilat_`m') note("run_tests.do:40-45: pair has 15 rows and observed positive tra
> de in all of them")
 71.     quietly ppmlhdfe v_ttl_k mob_bilat_`m' if has_both_`m' & fully_reported == 1, absorb(`FE') vce(cluster pair_id)
 72.     a2_chk "A2.4 File S1 T9 fully reported `mlab'"
 73.     a2_post, item(A2.4) spec(S1_T9_fully_reported) sample(has_both & fully_reported) mobility(`mlab') term(mob_bilat_`m') note("run_tests.do:253-259: every any_unreported* = 0, missing flag = not
>  clean")
 74.     quietly count if has_both_`m' & !missing(v_ttl_k) & fully_reported == 0
 75.     a2_postval, item(A2.4) spec(S1_T9_fully_reported) sample(has_both & trade observed) mobility(`mlab') label(rows with any_unreported != 0 or missing) value(`r(N)')
 76. }
