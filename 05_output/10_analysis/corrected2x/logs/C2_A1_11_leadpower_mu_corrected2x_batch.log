       log:  <PACKAGE_ROOT>/05_output/10_analysis/corrected2x/logs/C2_A1_11_leadpower_mu_corrected2x.log
  log type:  text
 opened on:   5 Nov 2026, 10:55:04

. display as result "C2_A1_11_BEGIN vintage=${VINTAGE} " c(current_date) " " c(current_time)
C2_A1_11_BEGIN vintage=corrected2x  5 Nov 2026 10:55:04

. use year v_ttl_k mob_bilat_vis mob_bilat_tour lag_bilat_vis lead_bilat_vis lag_bilat_tour lead_bilat_tour ///
>     exporter_year importer_year pair_id using "${PREPARED}", clear
(PREP analysis base, vintage corrected2x, built  5 Nov 2026 10:41:37 by 01_prep.d)

. nflow start using "${OUT}/C2_A1_11_nflow.csv", replace expected(823446)
nflow: log <PACKAGE_ROOT>/05_output/10_analysis/corrected2x/C2_A1_11_nflow.csv, start N =      823,446

. gen double time_c = year - 2007

. local FET "exporter_year importer_year pair_id##c.time_c"

. 
. capture program drop c2_lp_post

. program define c2_lp_post
  1.     * posts the 8 rows of one reference (2 shares x 2 levels) with the formulas of A1_03_time.do:270-276
.     args handle m trend ref blead slead br nt nref sep
  2.     foreach sh in 0.5 1 {
  3.         foreach a in 0.05 0.10 {
  4.             local z = invnormal(1 - `a' / 2)
  5.             local d = abs(`sh' * `br')
  6.             local pw = normal(`d' / `slead' - `z') + normal(-`d' / `slead' - `z')
  7.             local lo = `blead' - invnormal(0.95) * `slead'
  8.             local hi = `blead' + invnormal(0.95) * `slead'
  9.             local id = "A1.7.lead_power_`trend'.`m'.`ref'.d`sh'.a`a'"
 10.             post `handle' ("`id'") ("`m'") ("`trend'") ("`ref'") (`blead') (`slead') (`br') (`sh') (`d') (`a') (`z') (`pw') ///
>                 (`lo') (`hi') (`lo' / `br') (`hi' / `br') (`nt') (`nref') ("`sep'")
 11.         }
 12.     }
 13. end

. 
. tempname LP CK

. postfile `LP' str60 row_id str5 mobility str10 trend str20 reference double(b_lead se_lead b_ref d_share d alpha z power ///
>     ci90_lo ci90_hi ci90_lo_share ci90_hi_share N N_ref) str24 separation using "${OUT}/tables/A1_A1.7_lead_power_mu.dta", replace
(file <PACKAGE_ROOT>/05_output/10_analysis/corrected2x/tables/A1_A1.7_lead_power_mu.dta not found)

. postfile `CK' str60 row_id str5 mobility str10 trend str20 reference double(b_lead se_lead b_ref d_share d alpha z power ///
>     ci90_lo ci90_hi ci90_lo_share ci90_hi_share N N_ref) str24 separation using "${OUT}/tables/A1_A1.7_lead_power_mu_check.dta", replace
(file <PACKAGE_ROOT>/05_output/10_analysis/corrected2x/tables/A1_A1.7_lead_power_mu_check.dta not found)

. foreach m in vis tour {
  2.     local X "lag_bilat_`m' mob_bilat_`m' lead_bilat_`m'"
  3.     * ---- (A) control: default-separation block exactly as A1_03_time.do:240-279
.     ppmlhdfe v_ttl_k `X', absorb(`FET') vce(cluster pair_id)
  4.     assert e(converged) == 1
  5.     nflow est "C2_A1_11 `m' dynamic pair-trend fit, default separation (control = A1.8.T7_pair)"
  6.     gen byte __d1 = e(sample)
  7.     local blead = _b[lead_bilat_`m']
  8.     local slead = _se[lead_bilat_`m']
  9.     local bcur = _b[mob_bilat_`m']
 10.     local nt = e(N)
 11.     ppmlhdfe v_ttl_k mob_bilat_`m' if __d1, absorb(`FET') vce(cluster pair_id)
 12.     assert e(converged) == 1
 13.     nflow est "C2_A1_11 `m' static pair-trend fit on the default dynamic sample (control = A1.7.static_on_dyn_pairtrend)"
 14.     local bstat = _b[mob_bilat_`m']
 15.     local nst = e(N)
 16.     display as result "C2_A1_11_DEFAULT `m' N_dyn=`nt' N_static=`nst' b_lead=" %12.9f `blead' " se_lead=" %12.9f `slead' " b_static=" %12.9f `bstat'
 17.     c2_lp_post `CK' `m' pair static_same_sample `blead' `slead' `bstat' `nt' `nst' default
 18.     c2_lp_post `CK' `m' pair current_in_T3 `blead' `slead' `bcur' `nt' `nt' default
 19.     drop __d1
 20.     * ---- (B) final: separation(fe simplex ir mu), as A1_trendsep (A1_03_time.do:130)
.     ppmlhdfe v_ttl_k `X', absorb(`FET') vce(cluster pair_id) separation(fe simplex ir mu)
 21.     assert e(converged) == 1
 22.     assert e(N) == cond("`m'" == "vis", 13565, 18868)
 23.     nflow est "C2_A1_11 `m' dynamic pair-trend fit, separation(fe simplex ir mu) (= A1.8.T7_pair_sepmu)"
 24.     gen byte __m1 = e(sample)
 25.     local blead = _b[lead_bilat_`m']
 26.     local slead = _se[lead_bilat_`m']
 27.     local bcur = _b[mob_bilat_`m']
 28.     local nt = e(N)
 29.     local nsep = e(num_separated)
 30.     display as result "C2_A1_11_MU_DYN `m' N=`nt' separated=`nsep' b_lag=" %12.9f _b[lag_bilat_`m'] " b_cur=" %12.9f `bcur' ///
>         " b_lead=" %12.9f `blead' " se_lead=" %12.9f `slead'
 31.     ppmlhdfe v_ttl_k mob_bilat_`m' if __m1, absorb(`FET') vce(cluster pair_id) separation(fe simplex ir mu)
 32.     assert e(converged) == 1
 33.     nflow est "C2_A1_11 `m' static pair-trend fit on the mu dynamic sample (reference static_same_sample)"
 34.     local bstat = _b[mob_bilat_`m']
 35.     local sstat = _se[mob_bilat_`m']
 36.     local nst = e(N)
 37.     display as result "C2_A1_11_MU_STATIC `m' N=`nst' separated=" e(num_separated) " singletons=" e(num_singletons) ///
>         " b_static=" %12.9f `bstat' " se=" %12.9f `sstat'
 38.     c2_lp_post `LP' `m' pair_mu static_same_sample `blead' `slead' `bstat' `nt' `nst' "fe simplex ir mu"
 39.     c2_lp_post `LP' `m' pair_mu current_in_T3 `blead' `slead' `bcur' `nt' `nt' "fe simplex ir mu"
 40.     drop __m1
 41. }
