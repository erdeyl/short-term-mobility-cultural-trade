. postclose `OV'

. preserve

.     use "${OUT}/tables/A1_A1.5_m_overlap.dta", clear

.     gen str11 vintage = "${VINTAGE}"

.     order vintage

.     format value %24.17g

.     export delimited using "${OUT}/tables/A1_A1.5_m_overlap.csv", replace datafmt
(file <PACKAGE_ROOT>/05_output/10_analysis/corrected2x_upair/tables/A1_A1.5_m_overlap.csv not found)
file <PACKAGE_ROOT>/05_output/10_analysis/corrected2x_upair/tables/A1_A1.5_m_overlap.csv saved

. restore

. erase "${OUT}/tables/A1_A1.5_m_overlap.dta"

. 
. *------------------------------------------------------------------------------ (B) nesting violations
. gen byte __svk_rev = inlist(iso3_o, "SVK", "SVN")

. gen byte __svk_same = inlist(iso3_d, "SVK", "SVN")

. gen byte xn_any = hier_rev == 1 | hier_same == 1

. gen byte xn_same = (hier_rev == 1 & basis_mismatch_rev == 0) | (hier_same == 1 & basis_mismatch_same == 0)

. gen byte xn_same_nosk = (hier_rev == 1 & basis_mismatch_rev == 0 & !__svk_rev) | (hier_same == 1 & basis_mismatch_same == 0 & !__svk_same)

. gen byte r1b_vis = basis_rev_vis == basis_same_vis & inlist(basis_rev_vis, "residence", "nationality")

. gen byte r1b_tour = basis_rev_tour == basis_same_tour & inlist(basis_rev_tour, "residence", "nationality")

. tempname NS

. postfile `NS' str5 measure str24 sample str40 stat double(value base_N) str120 note using "${OUT}/tables/A1_A1.3_nesting.dta", replace
(file <PACKAGE_ROOT>/05_output/10_analysis/corrected2x_upair/tables/A1_A1.3_nesting.dta not found)

. foreach m in vis tour {
  2.     quietly count if s_base_`m'
  3.     local nb = r(N)
  4.     * direction cells with both series observed, by basis match (as A1_A1.3_hierarchy.csv s_base_*_dirs)
.     foreach bm in any same same_nosk {
  5.         local cells 0
  6.         local viol 0
  7.         foreach dir in rev same {
  8.             local c "s_base_`m' & !missing(hier_`dir')"
  9.             if "`bm'" != "any" local c "`c' & basis_mismatch_`dir' == 0"
 10.             if "`bm'" == "same_nosk" local c "`c' & !__svk_`dir'"
 11.             quietly count if `c'
 12.             local cells = `cells' + r(N)
 13.             quietly count if `c' & hier_`dir' == 1
 14.             local viol = `viol' + r(N)
 15.         }
 16.         post `NS' ("`m'") ("s_base_`m'") ("cells_both_series_`bm'") (`cells') (`nb') ("direction cells with tourists and visitors observed; `bm' basis match (same_nosk: reporter not SVK/SVN)")
 17.         post `NS' ("`m'") ("s_base_`m'") ("cells_visitors_lt_tourists_`bm'") (`viol') (`nb') ("hier_<dir> == 1")
 18.         local xv = cond("`bm'" == "any", "xn_any", cond("`bm'" == "same", "xn_same", "xn_same_nosk"))
 19.         quietly count if s_base_`m' & `xv'
 20.         post `NS' ("`m'") ("s_base_`m'") ("pairyears_with_violation_`bm'") (r(N)) (`nb') ("baseline rows with a violation in either direction")
 21.     }
 22. }

. * the panel-level count reported by A1_A1.3_hierarchy.csv (stored rows, same basis): reproduced
. gen byte __bothm = !missing(tourists, visitors)

. quietly count if __bothm & basis_mismatch_rev == 0

. local c0 = r(N)

. quietly count if __bothm & basis_mismatch_rev == 0 & hier_rev == 1

. local v0 = r(N)

