
. * generated by run_all.py: the package root is the first argument
. args root

. global PKGROOT `"`root'"'

. cd `"`root'/02_code/10_analysis"'
<PACKAGE_ROOT>/02_code/10_analysis

. do "UP_C2_A1_08_overlap.do" corrected2x 

. * UP_C2_A1_08_overlap.do -- GENERATED by C2_A1_12_make_upair.py from C2_A1_08
> _overlap.do; do not edit.
. * Changes: cluster variable pair_id -> unordered_pair_id (7 vce, 0 stack, 1 A
> 1_stack);
. * outputs in the sandbox folder ${OUTROOT}/${VINTAGE}_upair.
. /****************************************************************************
> ***
>  C2_A1_08_overlap.do -- rerun C2, request R1-2.12 (fixed-observation measurem
> ent comparison) and
>  R1-2.9/R1-2.10 (nesting violations); final data only.
>  Usage (cwd = 02_code/10_analysis):  stata-mp -b -q do C2_A1_08_overlap.do co
> rrected2x
>  Output: ${OUT}/results/A1_parts/A1_08.csv (A1_combine.py picks it up), ${OUT
> }/tables/A1_A1.5_m_overlap.csv,
>          ${OUT}/tables/A1_A1.3_nesting.csv, log, nflow records in ${OUT}/A1_n
> flow.csv.
>  Step 0 (feasibility): prepared.dta carries only the selected (residence-firs
> t) series. The separate
>  residence and nationality series are in the master of the build, read from t
> he unchanged pre-C14 snapshot
>  (00_config.do MASTER_FILE): tourists_res_k, tourists_nat_k, visitors_res_k, 
> visitors_nat_k, thousand trips,
>  stored-row direction (reporter = iso3_o). Trips = thousand trips x 1000 (COP
> Y 01_build_UN_Tourism.do:668-669).
>  The corrected2x quarantines are applied to the residence series exactly as 0
> 1_prep.do A0 does (PAK residence
>  cells pak_res_quarantine_rev == 1; BLR->LIE visitors blr_lie_quarantine_rev 
> == 1). Positive control: the
>  residence-first combination of the two series reproduces the prepared values
>  tourists/visitors on every row.
>  Mirror (same direction) by swapping origin and destination, as 01_prep.do se
> ction A.
>  (A) Overlap = baseline rows (s_base_<m>) where residence and nationality val
> ues exist in both directions.
>      Identical observations = fixed point of the residence-built and national
> ity-built PPML models (same FE,
>      clusters by directed pair). On the overlap the baseline construction (re
> sidence first) equals the
>      residence-built measure (asserted). Stacked test residence = nationality
> : A1_stack (authors' design,
>      block-specific FE, cluster by the original pair id, 1e-6 reproduction ch
> eck; A1_00_programs.do).
>  (B) Nesting: hier_rev/hier_same (tourists > visitors where both series of th
> at direction exist; FLAGS_CODEBOOK
>      section 3); same basis = basis_mismatch_<dir> == 0; accommodation-based 
> reporters SVK, SVN (reporter of the
>      rev cell = iso3_o, of the same cell = iso3_d). Exclusions are if-conditi
> ons; no value is altered.
>  Help consulted: ppmlhdfe.sthlp 2.3.4 (absorb(), vce(cluster), e(sample), e(N
> ), e(N_full),
>  e(num_singletons), e(num_separated), e(converged)); [R] test; [R] lincom; [D
> ] merge; [D] egen (tag());
>  [P] postfile; nflow.sthlp 1.0.1.
> *****************************************************************************
> **/
. args vintage

. clear all

. set more off

. set varabbrev off

. set linesize 200

. version 18.0

. do "00_config.do" `vintage'

. /*******************************************************************************
>  00_config.do  --  globals for one data vintage (analysis layer of the replication package)
> 
>  Usage (from another do-file, cwd = 02_code/10_analysis):  do 00_config.do <vintage>
>    <vintage> = corrected2x (revised baseline, default run)
>              | corrected | corrected2 (reconciliation switch, same data build)
>              | submitted (reconciliation switch, needs a second build with corrections off)
>  Every path is built from the package root ${PKGROOT}, which run_all.py passes as the first
>  argument of the generated wrapper do-file (_run.do pattern); nothing here is machine-specific.
>  Defines globals only and checks the Stata version.
> 
>  Vintages (see README.md, "Data-correction rules"):
>    corrected   = build with the correction rules on (code 490 -> TWN, Paraguay residence quarantine, flags)
>    corrected2  = corrected + quarantine of PAK residence 2020-2021 and BLR visitors-by-residence
>                  partner LIE 2020-2022 (same rule as Paraguay); 31-code outcome
>    corrected2x = corrected2 with the 30-code outcome (31-code basket minus HS 490700) = revised baseline
>    submitted   = original data as submitted (build with corrections off), for the reconciliation only
> *******************************************************************************/
. 
. args vintage

. if !inlist("`vintage'", "submitted", "corrected", "corrected2", "corrected2x") {
.     display as error "VINTAGE must be submitted, corrected, corrected2 or corrected2x; got [`vintage']"
.     exit 198
. }

. 
. version 18.0

. if c(stata_version) < 18 {
.     display as error "Stata 18 or newer required; running " c(stata_version)
.     exit 9
. }

. 
. global VINTAGE "`vintage'"

. 
. * ---------------------------------------------------------------- roots (all relative to the package root)
. if `"${PKGROOT}"' == "" {
.     display as error "PKGROOT is not set. Run the analysis through run_all.py (it passes the package root)."
.     exit 198
. }

. global ROOT "${PKGROOT}"

. confirm file "${ROOT}/run_all.py"

. local _py : environment PKG_PYTHON

. if `"`_py'"' == "" {
.     display as error "PKG_PYTHON is not set. Run the analysis through run_all.py."
.     exit 198
. }

. global PYTHON `"`_py'"'

. global RAW     "${ROOT}/01_raw"

. global DERIVED "${ROOT}/derived"

. * Corrected chapter build of this package (02_code/00_common + 02_code/03_Mobility, run by run_all.py
. * stage "build"): its 03_intermediate, 04_analysis data and 05_output folders live in the package root.
