. 
. * positive-control targets (submitted vintage): File S1 estimates.csv
. local pc_unord_vis_b  0.24287017

. local pc_unord_vis_se 0.091529384

. local pc_unord_vis_N  20543

. local pc_unord_tour_b  0.24048044

. local pc_unord_tour_se 0.065553479

. local pc_unord_tour_N  26682

. local pc_trim_vis_b  0.12063225

. local pc_trim_vis_se 0.070991881

. local pc_trim_vis_N  20509

. local pc_trim_tour_b  0.22182305

. local pc_trim_tour_se 0.073281154

. local pc_trim_tour_N  26626

. 
. foreach m in vis tour {
  2.     * ---------------- (a) unordered-pair clusters
.     ppmlhdfe v_ttl_k mob_bilat_`m' if has_both_`m', absorb($FE) vce(cluster unordered_pair_id)
  3.     assert e(converged) == 1
  4.     assert e(N_full) == e(N) + e(num_singletons) + e(num_separated)
  5.     local b = _b[mob_bilat_`m']
  6.     local se = _se[mob_bilat_`m']
  7.     post `H' ("${VINTAGE}") ("unordered_pair_clusters") ("`m'") (`b') (`se') ///
>         (`b' - invnormal(0.975) * `se') (`b' + invnormal(0.975) * `se') (e(N)) (e(N_full)) ///
>         (e(num_singletons)) (e(num_separated)) (e(N_clust)) ("`e(clustvar)'") (.) (.) (.) ("")
  8.     nflow est "FIG unordered-pair clusters `m'"
  9.     display as result "FIG_FIT unordered `m' b=" %12.9f `b' " se=" %12.9f `se' " N=" e(N) " clusters=" e(N_clust)
 10.     if "${VINTAGE}" == "submitted" {
 11.         assert abs(`b' - `pc_unord_`m'_b') < 1e-5
 12.         assert abs(`se' - `pc_unord_`m'_se') < 1e-5
 13.         assert e(N) == `pc_unord_`m'_N'
 14.         display as result "FIG_PC_PASS unordered `m'"
 15.     }
 16. 
.     * ---------------- (b) top 0.1% directional mobility values (File S1 T11, directional)
.     quietly _pctile rev_`m'_raw if has_both_`m' & !missing(v_ttl_k), p(99.9)
 17.     local cut_rev = r(r1)
 18.     quietly _pctile same_`m'_raw if has_both_`m' & !missing(v_ttl_k), p(99.9)
 19.     local cut_same = r(r1)
 20.     tempvar trimmed
 21.     gen byte `trimmed' = has_both_`m' & !missing(v_ttl_k) & (rev_`m'_raw > `cut_rev' | same_`m'_raw > `cut_same')
 22.     quietly count if `trimmed'
 23.     local drop_n = r(N)
 24.     ppmlhdfe v_ttl_k mob_bilat_`m' if has_both_`m' & !`trimmed', absorb($FE) vce(cluster pair_id)
 25.     assert e(converged) == 1
 26.     assert e(N_full) == e(N) + e(num_singletons) + e(num_separated)
 27.     local b = _b[mob_bilat_`m']
 28.     local se = _se[mob_bilat_`m']
 29.     post `H' ("${VINTAGE}") ("trim_top0.1pct_directional") ("`m'") (`b') (`se') ///
>         (`b' - invnormal(0.975) * `se') (`b' + invnormal(0.975) * `se') (e(N)) (e(N_full)) ///
>         (e(num_singletons)) (e(num_separated)) (e(N_clust)) ("`e(clustvar)'") (`cut_rev') (`cut_same') (`drop_n') ///
>         ("candidate pair-years dropped (above 99.9th pct of reverse or same-direction raw flow)")
 30.     nflow est "FIG trim top 0.1pct directional `m'"
 31.     display as result "FIG_FIT trim `m' b=" %12.9f `b' " se=" %12.9f `se' " N=" e(N) " cutoffs=" `cut_rev' " " `cut_same' " candidate_excl=" `drop_n'
 32.     if "${VINTAGE}" == "submitted" {
 33.         assert abs(`b' - `pc_trim_`m'_b') < 1e-5
 34.         assert abs(`se' - `pc_trim_`m'_se') < 1e-5
 35.         assert e(N) == `pc_trim_`m'_N'
 36.         display as result "FIG_PC_PASS trim `m'"
 37.     }
 38.     drop `trimmed'
 39. }
